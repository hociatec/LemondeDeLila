#!/bin/sh
# ----------------------------------------------------------------------------
# Maven Wrapper startup script, version 3.3.2
# ----------------------------------------------------------------------------

MAVEN_PROJECTBASEDIR="$(cd "$(dirname "$0")" && pwd)"

WRAPPER_DIR="$MAVEN_PROJECTBASEDIR/.mvn/wrapper"
WRAPPER_JAR="$WRAPPER_DIR/maven-wrapper.jar"
WRAPPER_LAUNCHER="org.apache.maven.wrapper.MavenWrapperMain"

if [ ! -f "$WRAPPER_JAR" ]; then
  if [ ! -d "$WRAPPER_DIR" ]; then
    mkdir -p "$WRAPPER_DIR"
  fi
  echo "Downloading maven-wrapper.jar ..."
  javac "$WRAPPER_DIR/MavenWrapperDownloader.java" 2>/dev/null
  java -cp "$WRAPPER_DIR" MavenWrapperDownloader "$MAVEN_PROJECTBASEDIR"
fi

exec java ${MAVEN_OPTS} -classpath "$WRAPPER_JAR" "$WRAPPER_LAUNCHER" -Dmaven.multiModuleProjectDirectory="$MAVEN_PROJECTBASEDIR" "$@"

