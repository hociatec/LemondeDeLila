<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <PublishProtocol>ClickOnce</PublishProtocol>
    <PublisherName>Le Monde de Lila</PublisherName>
    <ProductName>Le Monde de Lila</ProductName>
    <Install>true</Install>
    <InstallFrom>Web</InstallFrom>
    <UpdateEnabled>true</UpdateEnabled>
    <!-- Background = afterApplicationStartup (évite la fenêtre ClickOnce "Fermer/Mettre à jour" avant que l'app démarre). -->
    <UpdateMode>Background</UpdateMode>
    <UpdateInterval>0</UpdateInterval>
    <UpdateIntervalUnits>Days</UpdateIntervalUnits>
    <CreateWebPage>false</CreateWebPage>
    <!-- IMPORTANT: évite la création d'un nouveau raccourci à chaque mise à jour ClickOnce ("(1)", "(2)"...). -->
    <CreateDesktopShortcut>false</CreateDesktopShortcut>
    <!-- setup.exe bootstrapper requires full .NET Framework MSBuild; keep disabled by default. -->
    <BootstrapperEnabled>false</BootstrapperEnabled>
    <IsWebBootstrapper>false</IsWebBootstrapper>
    <GenerateManifests>true</GenerateManifests>
    <SignManifests>false</SignManifests>
  </PropertyGroup>
</Project>
