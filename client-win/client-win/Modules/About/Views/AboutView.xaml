<UserControl x:Class="client_win.Modules.About.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1280"
             KeyDown="OnKeyDown"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <LinearGradientBrush x:Key="ShellBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F1D2D" Offset="0" />
            <GradientStop Color="#1C3B5E" Offset="0.55" />
            <GradientStop Color="#0E1724" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="PanelBrush" Color="#12263C" />
        <SolidColorBrush x:Key="HighlightBrush" Color="#F2C14E" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0 4 0 4" />
                        <Setter Property="Padding" Value="10" />
                        <Setter Property="Background" Value="#10223A" />
                        <Setter Property="BorderBrush" Value="#1F3C60" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1B3554" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#214570" />
                                            <Setter Property="BorderBrush" Value="{StaticResource HighlightBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InputTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#0E2034" />
            <Setter Property="BorderBrush" Value="#1F3C60" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource ShellBackground}" FocusManager.IsFocusScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" Foreground="White" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="12"
                Margin="24" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <ListBox x:Name="ItemsList"
                             Visibility="{Binding ShowItemsList, Converter={StaticResource BoolToVis}}"
                             ItemsSource="{Binding Items}"
                             SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                             DisplayMemberPath="Label"
                             SelectionMode="Single"
                             VirtualizingStackPanel.IsVirtualizing="False"
                             KeyboardNavigation.TabNavigation="None"
                             IsTabStop="False"
                             PreviewKeyDown="OnListPreviewKeyDown"
                             KeyDown="OnListKeyDown"
                             AutomationProperties.LabeledBy="{Binding ElementName=TitleText}" />

                    <TextBox x:Name="ShortcutsBox"
                             Visibility="{Binding ShowShortcuts, Converter={StaticResource BoolToVis}}"
                             Text="{Binding ShortcutsText}"
                             Style="{StaticResource InputTextBox}"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Raccourcis" />

                    <StackPanel Visibility="{Binding ShowInfo, Converter={StaticResource BoolToVis}}"
                                Orientation="Vertical">
                        <TextBlock Text="{Binding AppName, StringFormat=Nom : {0}}"
                                   Foreground="White" FontSize="16" Margin="0 0 0 6" />
                        <TextBlock Text="{Binding CurrentVersion, StringFormat=Version actuelle : {0}}"
                                   Foreground="#BFD0E6" FontSize="14" Margin="0 0 0 6" />
                        <TextBlock Text="{Binding LocalUpdatedAt, StringFormat=Dernière mise à jour locale : {0}}"
                                   Foreground="#BFD0E6" FontSize="14" Margin="0 0 0 6" />
                        <TextBlock Text="{Binding ServerVersion, StringFormat=Version serveur : {0}}"
                                   Foreground="#BFD0E6" FontSize="14" Margin="0 0 0 6" />
                        <TextBlock Text="{Binding ServerPublishedAt, StringFormat=Date de publication serveur : {0}}"
                                   Foreground="#BFD0E6" FontSize="14" Margin="0 0 0 12" />

                        <Button Content="Rechercher une mise à jour"
                                x:Name="UpdateButton"
                                Command="{Binding CheckUpdatesCommand}"
                                IsEnabled="{Binding CanCheckUpdates}"
                                Padding="10 6"
                                Background="#214570"
                                Foreground="White"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding UpdateCheckStatus}"
                                   Foreground="{StaticResource HighlightBrush}"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="1"
                           Text="{Binding Details}"
                           Foreground="#BFD0E6"
                           FontSize="14"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0"
                           AutomationProperties.LiveSetting="Polite" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#0C1523" Padding="12 8" Focusable="False">
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource HighlightBrush}" FontSize="14"
                       HorizontalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
