<UserControl x:Class="client_win.Modules.Catalog.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1280"
             KeyDown="OnKeyDown"
             PreviewKeyDown="OnPreviewKeyDown"
             SizeChanged="OnSizeChanged"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <LinearGradientBrush x:Key="ShellBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F1D2D" Offset="0" />
            <GradientStop Color="#1C3B5E" Offset="0.55" />
            <GradientStop Color="#0E1724" Offset="1" />
        </LinearGradientBrush>
        <Style TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0 6 0 0" />
            <Setter Property="Padding" Value="12 10" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#1E3A5C" />
            <Setter Property="BorderBrush" Value="#284C75" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0 4 0 4" />
                        <Setter Property="Padding" Value="6" />
                        <Setter Property="Background" Value="#10223A" />
                        <Setter Property="BorderBrush" Value="#1F3C60" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6">
                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                          ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                          ContentStringFormat="{TemplateBinding ContentStringFormat}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1B3554" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#214570" />
                                            <Setter Property="BorderBrush" Value="{StaticResource HighlightBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.6" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource ShellBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Étagères" FontSize="28" FontWeight="SemiBold" Foreground="White"
                       TextOptions.TextFormattingMode="Ideal" />
            <TextBlock Text="Parcourir les catégories, sous-catégories et jeux" Foreground="#9CB2D1" FontSize="14"
                       HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False"
                      KeyboardNavigation.IsTabStop="False">
            <Grid x:Name="PanelsGrid" Margin="8">
                <Border x:Name="CategoriesPanel" Background="{StaticResource PanelBrush}" CornerRadius="12"
                        Margin="8" Padding="12" MinHeight="220">
                    <StackPanel>
                        <TextBlock Text="Catégories" Foreground="White" FontSize="18" Margin="0 0 0 8" />
                        <ListBox x:Name="CategoriesList"
                                 ItemsSource="{Binding Shelves}"
                                 SelectedItem="{Binding SelectedShelf, Mode=TwoWay}"
                                 SelectionMode="Single"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.CanContentScroll="True"
                                 KeyboardNavigation.TabNavigation="None"
                                 IsTabStop="False"
                                 KeyDown="OnCategoriesKeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border x:Name="SubCategoriesPanel" Background="{StaticResource PanelBrush}" CornerRadius="12"
                        Margin="8" Padding="12" MinHeight="220">
                    <StackPanel>
                        <TextBlock Text="Sous-catégories" Foreground="White" FontSize="18" Margin="0 0 0 8" />
                        <ListBox x:Name="SubCategoriesList"
                                 ItemsSource="{Binding SubShelves}"
                                 SelectedItem="{Binding SelectedSubShelf, Mode=TwoWay}"
                                 SelectionMode="Single"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.CanContentScroll="True"
                                 KeyboardNavigation.TabNavigation="None"
                                 IsTabStop="False"
                                 KeyDown="OnSubCategoriesKeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="14" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border x:Name="GamesPanel" Background="{StaticResource PanelBrush}" CornerRadius="12"
                        Margin="8" Padding="16" MinHeight="260">
                    <Grid>
                        <ListBox x:Name="GamesList"
                                 ItemsSource="{Binding Games}"
                                 SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                                 SelectionMode="Single"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.CanContentScroll="True"
                                 KeyboardNavigation.TabNavigation="None"
                                 IsTabStop="False"
                                 PreviewKeyDown="OnGamesPreviewKeyDown"
                                 KeyDown="OnGamesKeyDown"
                                 MouseDoubleClick="OnGamesDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0 4 0 4">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="#BFD0E6" FontSize="12" Margin="0 2 0 4" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Engine, StringFormat='Moteur : {0}'}" Foreground="#9CB2D1" FontSize="11" Margin="0 0 8 0" />
                                            <TextBlock Text="{Binding MinPlayers, StringFormat='Min {0} joueurs'}" Foreground="#9CB2D1" FontSize="11" Margin="0 0 8 0" />
                                            <TextBlock Text="{Binding MaxPlayers, StringFormat='Max {0} joueurs'}" Foreground="#9CB2D1" FontSize="11" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="Sélectionnez une catégorie ou sous-catégorie."
                                   Foreground="#9CB2D1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Games.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="16 0 16 16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource HighlightBrush}" VerticalAlignment="Center" Margin="0 0 12 0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
