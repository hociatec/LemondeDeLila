<UserControl x:Class="client_win.Modules.Home.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:client_win.Modules.Home.Views.Converters"
             xmlns:behaviors="clr-namespace:client_win.Behaviors"
              mc:Ignorable="d"
              d:DesignHeight="720" d:DesignWidth="1280"
              Loaded="OnLoaded"
              Unloaded="OnUnloaded"
              PreviewKeyDown="OnPreviewKeyDown"
              DataContextChanged="OnDataContextChanged">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:NullOrWhitespaceToVisibilityConverter x:Key="NullOrWhitespaceToVisibilityConverter" />
        <LinearGradientBrush x:Key="ShellBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F1D2D" Offset="0" />
            <GradientStop Color="#1C3B5E" Offset="0.55" />
            <GradientStop Color="#0E1724" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="PanelBrush" Color="#12263C" />
        <SolidColorBrush x:Key="HighlightBrush" Color="#F2C14E" />
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0 8 0 8" />
            <Setter Property="Padding" Value="12 10" />
            <Setter Property="Background" Value="#0D1A2B" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#1E3A5C" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Margin" Value="0 8 0 8" />
            <Setter Property="Padding" Value="12 10" />
            <Setter Property="Background" Value="#0D1A2B" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#1E3A5C" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0 6 0 0" />
            <Setter Property="Padding" Value="12 10" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#1E3A5C" />
            <Setter Property="BorderBrush" Value="#284C75" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource ShellBackground}" Focusable="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="*" />
            <RowDefinition Height="80" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="{Binding ApplicationName}" FontSize="28" FontWeight="SemiBold" Foreground="White"
                       TextOptions.TextFormattingMode="Ideal" />
            <TextBlock Text="Connexion ou inscription" Foreground="#9CB2D1" FontSize="14"
                       HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="12"
                Margin="24" Padding="32">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

        <Border Background="#162A44" Padding="12" CornerRadius="8"
                Visibility="{Binding StatusMessage, Converter={StaticResource NullOrWhitespaceToVisibilityConverter}}" Focusable="False"
                AutomationProperties.LiveSetting="Assertive">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource HighlightBrush}"
                               FontSize="14" TextWrapping="Wrap" IsHitTestVisible="False" Focusable="False"
                               AutomationProperties.Name="Message de statut"
                               AutomationProperties.LiveSetting="Assertive" />
        </Border>

                <Grid Grid.Row="1" Margin="0 16 0 0"
                      KeyboardNavigation.TabNavigation="Cycle">
                    <Grid Visibility="{Binding IsLandingVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Bienvenue, choisissez une action pour continuer."
                                   Foreground="White" FontSize="18" Margin="0 0 0 16" />
                        <Button Grid.Row="1" Content="Se connecter"
                                Command="{Binding ShowLoginCommand}" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0 12 0 0">
                            <Button Content="Créer un compte" Command="{Binding ShowRegisterCommand}"
                                    Background="#234A7A" />
                            <Button Content="Quitter"
                                    Command="{Binding QuitCommand}" Background="#742A2A" Margin="12 0 0 0" />
                        </StackPanel>
                    </Grid>

                    <Grid Visibility="{Binding IsLoginVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Connexion" Foreground="White" FontSize="18" />
                        <Label Grid.Row="1" Content="Nom d'utilisateur" Foreground="#9CB2D1" Target="{Binding ElementName=LoginUsernameBox}" Focusable="False" />
                        <TextBox x:Name="LoginUsernameBox" Grid.Row="2"
                                 AutomationProperties.Name="Nom d'utilisateur"
                                 Text="{Binding LoginForm.Username, UpdateSourceTrigger=PropertyChanged}" />
                        <Label Grid.Row="3" Content="Mot de passe" Foreground="#9CB2D1" Target="{Binding ElementName=LoginPasswordBox}" Focusable="False" />
                        <PasswordBox x:Name="LoginPasswordBox" Grid.Row="4"
                                     AutomationProperties.Name="Mot de passe"
                                     behaviors:PasswordBoxBehavior.BindPassword="True"
                                     behaviors:PasswordBoxBehavior.BoundPassword="{Binding LoginForm.Password, Mode=TwoWay}">
                            <PasswordBox.Style>
                                <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LoginForm.ShowPassword}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </PasswordBox.Style>
                        </PasswordBox>
                        <TextBox x:Name="LoginPasswordTextBox" Grid.Row="4"
                                 AutomationProperties.Name="Mot de passe (texte)"
                                 Text="{Binding LoginForm.PasswordText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LoginForm.ShowPassword}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <StackPanel Grid.Row="5" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox Content="Afficher le mot de passe"
                                      IsChecked="{Binding LoginForm.ShowPassword}"
                                      Foreground="White" />
                            <CheckBox Content="Se souvenir de moi"
                                      IsChecked="{Binding LoginForm.RememberMe}"
                                      Foreground="White" Margin="16 0 0 0" />
                        </StackPanel>
                        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0 8 0 0">
                            <Button Content="Connexion" Command="{Binding LoginForm.SubmitCommand}"
                                    Background="#2B6CB0" />
                            <Button Content="Retour" Command="{Binding LoginForm.BackCommand}"
                                    Background="#3B4250" Margin="8 0 0 0" />
                        </StackPanel>
                    </Grid>

                    <Grid Visibility="{Binding IsRegisterVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Créer un compte" Foreground="White" FontSize="18" />
                        <Label Grid.Row="1" Content="Nom d'utilisateur" Foreground="#9CB2D1" Target="{Binding ElementName=RegisterUsernameBox}" Focusable="False" />
                        <TextBox x:Name="RegisterUsernameBox" Grid.Row="2"
                                 AutomationProperties.Name="Nom d'utilisateur (inscription)"
                                 Text="{Binding RegisterForm.Username, UpdateSourceTrigger=PropertyChanged}" />
                        <Label Grid.Row="3" Content="Adresse email" Foreground="#9CB2D1" Target="{Binding ElementName=RegisterEmailBox}" Focusable="False" />
                        <TextBox x:Name="RegisterEmailBox" Grid.Row="4"
                                 AutomationProperties.Name="Adresse email"
                                 Text="{Binding RegisterForm.Email, UpdateSourceTrigger=PropertyChanged}" />
                        <Label Grid.Row="5" Content="Mot de passe" Foreground="#9CB2D1" Target="{Binding ElementName=RegisterPasswordBox}" Focusable="False" />
                        <PasswordBox x:Name="RegisterPasswordBox" Grid.Row="6"
                                     AutomationProperties.Name="Mot de passe (inscription)"
                                     behaviors:PasswordBoxBehavior.BindPassword="True"
                                     behaviors:PasswordBoxBehavior.BoundPassword="{Binding RegisterForm.Password, Mode=TwoWay}">
                            <PasswordBox.Style>
                                <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RegisterForm.ShowPassword}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </PasswordBox.Style>
                        </PasswordBox>
                        <TextBox x:Name="RegisterPasswordTextBox" Grid.Row="6"
                                 AutomationProperties.Name="Mot de passe (inscription - texte)"
                                 Text="{Binding RegisterForm.PasswordText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RegisterForm.ShowPassword}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <CheckBox Grid.Row="7" Content="Afficher le mot de passe"
                                  IsChecked="{Binding RegisterForm.ShowPassword}"
                                  Foreground="White" />
                        <StackPanel Grid.Row="8" Orientation="Horizontal" Margin="0 8 0 0">
                            <Button Content="Créer le compte" Command="{Binding RegisterForm.SubmitCommand}"
                                    Background="#2E8B57" />
                            <Button Content="Retour" Command="{Binding RegisterForm.BackCommand}"
                                    Background="#3B4250" Margin="8 0 0 0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#0C1523" Padding="12 8">
            <TextBlock Text="Inspiré du module Home Java : navigation Landing/Login/Register et bannières d'état."
                       Foreground="#5E738F" HorizontalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
