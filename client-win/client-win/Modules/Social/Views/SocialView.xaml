<UserControl x:Class="client_win.Modules.Social.Views.SocialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Border Grid.Row="0" Background="#0B1523" Padding="20">
            <TextBlock Text="Réseau Social"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="White"/>
        </Border>

        <!-- Contenu principal -->
        <Border Grid.Row="1" Padding="20">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding Status}"
                           FontSize="16"
                           Foreground="#555"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,20"/>

                <!-- TODO: Ajouter liste d'amis, profils, etc. -->
                <TextBlock Text="Les fonctionnalités suivantes seront ajoutées :"
                           FontSize="14"
                           Foreground="#888"
                           TextAlignment="Center"
                           Margin="0,10,0,5"/>
                <TextBlock FontSize="13" Foreground="#888" TextAlignment="Center" Margin="5">
                    <Run Text="• Liste d'amis et demandes en attente"/>
                    <LineBreak/>
                    <Run Text="• Profils des joueurs"/>
                    <LineBreak/>
                    <Run Text="• Classements et statistiques"/>
                    <LineBreak/>
                    <Run Text="• Messagerie privée"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Pied avec bouton Fermer -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="20" BorderBrush="#DDD" BorderThickness="0,1,0,0">
            <Button Content="Fermer"
                    Command="{Binding CloseCommand}"
                    Width="120"
                    Height="35"
                    HorizontalAlignment="Right"
                    Background="#0B1523"
                    Foreground="White"
                    FontSize="14"
                    Cursor="Hand"/>
        </Border>
    </Grid>
</UserControl>
