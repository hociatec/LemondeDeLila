<UserControl x:Class="client_win.Modules.Social.Views.SocialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:client_win.Modules.Social.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1280"
             Loaded="OnLoaded"
             KeyDown="OnRootKeyDown"
             KeyboardNavigation.TabNavigation="Continue">
    <UserControl.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="ShellBackground" Color="#0F1D2D" />
            <SolidColorBrush x:Key="PanelBackground" Color="#12263C" />
            <SolidColorBrush x:Key="PanelBorder" Color="#2A4A6A" />
            <SolidColorBrush x:Key="HighlightBrush" Color="#FFD966" />
            <SolidColorBrush x:Key="TextMuted" Color="#9CB2D1" />

            <Style x:Key="MenuListBox" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            </Style>

            <Style x:Key="MenuListItem" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0 8 0 0" />
                <Setter Property="Padding" Value="16 12" />
                <Setter Property="Background" Value="#1E3A5C" />
                <Setter Property="BorderBrush" Value="#284C75" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#26456F" />
                        <Setter Property="BorderBrush" Value="#FFD966" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="#FFD966" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ListBoxBase" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            </Style>

            <Style x:Key="ListItem" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0 6 0 6" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="Background" Value="#0D1F34" />
                <Setter Property="BorderBrush" Value="#2A4A6A" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#1E3A5C" />
                        <Setter Property="BorderBrush" Value="#FFD966" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="#FFD966" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Height" Value="42" />
                <Setter Property="Padding" Value="16 10" />
                <Setter Property="Margin" Value="0 0 12 0" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Background" Value="#1E3A5C" />
                <Setter Property="BorderBrush" Value="#284C75" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#26456F" />
                        <Setter Property="BorderBrush" Value="#3A5E8C" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="InputTextBox" TargetType="TextBox">
                <Setter Property="Background" Value="#0A1827" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderBrush" Value="#284C75" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="InputComboBox" TargetType="ComboBox">
                <Setter Property="Background" Value="#0A1827" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderBrush" Value="#284C75" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="FontSize" Value="13" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource ShellBackground}" KeyboardNavigation.TabNavigation="Continue">
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#0C1523"
                BorderBrush="#1A2F47"
                BorderThickness="0 0 0 2">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="RÉSEAU SOCIAL"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="White" />
                <TextBlock Text="{Binding Status}"
                           Foreground="{StaticResource HighlightBrush}"
                           FontSize="14"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBackground}"
                    CornerRadius="16"
                    Padding="20"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="3"
                    KeyboardNavigation.TabNavigation="None">
                <StackPanel>
                    <Border Background="#0A1A2D"
                            CornerRadius="8"
                            Padding="12 8"
                            Margin="0 0 0 16"
                            BorderBrush="#2A4A6A"
                            BorderThickness="2">
                        <TextBlock Text="MENU SOCIAL"
                                   Foreground="#FFD966"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                    </Border>

                    <ListBox x:Name="MenuList"
                             Style="{StaticResource MenuListBox}"
                             ItemContainerStyle="{StaticResource MenuListItem}"
                             SelectionChanged="OnMenuSelectionChanged"
                             KeyDown="OnMenuKeyDown"
                             PreviewMouseLeftButtonUp="OnMenuClick"
                             AutomationProperties.Name="Menu social">
                        <ListBoxItem Tag="friends">
                            <TextBlock Text="Amis" />
                        </ListBoxItem>
                        <ListBoxItem Tag="incoming">
                            <TextBlock Text="Demandes reçues" />
                        </ListBoxItem>
                        <ListBoxItem Tag="outgoing">
                            <TextBlock Text="Demandes envoyées" />
                        </ListBoxItem>
                        <ListBoxItem Tag="blocked">
                            <TextBlock Text="Bloqués" />
                        </ListBoxItem>
                        <ListBoxItem Tag="search">
                            <TextBlock Text="Rechercher" />
                        </ListBoxItem>
                        <ListBoxItem Tag="profile">
                            <TextBlock Text="Mon profil" />
                        </ListBoxItem>
                    </ListBox>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="16 0 0 0">
                <Border x:Name="FriendsPanel"
                        Background="{StaticResource PanelBackground}"
                        CornerRadius="16"
                        Padding="20"
                        BorderBrush="{StaticResource PanelBorder}"
                        BorderThickness="3">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static viewModels:SocialSection.Friends}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Liste d'amis"
                                   Foreground="{StaticResource HighlightBrush}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0 0 0 12" />

                        <Grid Grid.Row="1">
                            <TextBlock x:Name="EmptyFriendsText"
                                       Text="Aucun ami"
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="14"
                                       FontStyle="Italic"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Focusable="True"
                                       AutomationProperties.Name="Aucun ami">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasItems, ElementName=FriendsList}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ListBox x:Name="FriendsList"
                                     ItemsSource="{Binding Friends}"
                                     SelectedItem="{Binding SelectedFriend, Mode=TwoWay}"
                                     ItemContainerStyle="{StaticResource ListItem}"
                                     Style="{StaticResource ListBoxBase}"
                                     AutomationProperties.Name="Liste des amis">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Username}" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Since, StringFormat=Depuis: {0:dd/MM/yyyy}}" Foreground="{StaticResource TextMuted}" FontSize="12" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 12 0 0">
                            <Button Content="Retirer"
                                    Command="{Binding RemoveFriendCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    AutomationProperties.Name="Retirer l'ami" />
                            <Button Content="Bloquer"
                                    Command="{Binding BlockUserCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    AutomationProperties.Name="Bloquer l'ami" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="IncomingPanel"
                        Background="{StaticResource PanelBackground}"
                        CornerRadius="16"
                        Padding="20"
                        BorderBrush="{StaticResource PanelBorder}"
                        BorderThickness="3">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static viewModels:SocialSection.IncomingRequests}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Demandes reçues"
                                   Foreground="{StaticResource HighlightBrush}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0 0 0 12" />

                        <Grid Grid.Row="1">
                            <TextBlock x:Name="EmptyIncomingText"
                                       Text="Aucune demande"
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="14"
                                       FontStyle="Italic"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Focusable="True"
                                       AutomationProperties.Name="Aucune demande reçue">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasItems, ElementName=IncomingList}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ListBox x:Name="IncomingList"
                                     ItemsSource="{Binding IncomingRequests}"
                                     SelectedItem="{Binding SelectedIncomingRequest, Mode=TwoWay}"
                                     ItemContainerStyle="{StaticResource ListItem}"
                                     Style="{StaticResource ListBoxBase}"
                                     AutomationProperties.Name="Demandes reçues">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Requester.Username}" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding CreatedAt, StringFormat=Le: {0:dd/MM/yyyy HH:mm}}" Foreground="{StaticResource TextMuted}" FontSize="12" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 12 0 0">
                            <Button Content="Accepter"
                                    Command="{Binding AcceptRequestCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    AutomationProperties.Name="Accepter la demande" />
                            <Button Content="Refuser"
                                    Command="{Binding RejectRequestCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    AutomationProperties.Name="Refuser la demande" />
                            <Button Content="Bloquer"
                                    Command="{Binding BlockUserCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    AutomationProperties.Name="Bloquer l'utilisateur" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="OutgoingPanel"
                        Background="{StaticResource PanelBackground}"
                        CornerRadius="16"
                        Padding="20"
                        BorderBrush="{StaticResource PanelBorder}"
                        BorderThickness="3">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static viewModels:SocialSection.OutgoingRequests}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Demandes envoyées"
                                   Foreground="{StaticResource HighlightBrush}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0 0 0 12" />

                        <Grid Grid.Row="1">
                            <TextBlock x:Name="EmptyOutgoingText"
                                       Text="Aucune demande"
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="14"
                                       FontStyle="Italic"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Focusable="True"
                                       AutomationProperties.Name="Aucune demande envoyée">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasItems, ElementName=OutgoingList}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ListBox x:Name="OutgoingList"
                                     ItemsSource="{Binding OutgoingRequests}"
                                     SelectedItem="{Binding SelectedOutgoingRequest, Mode=TwoWay}"
                                     ItemContainerStyle="{StaticResource ListItem}"
                                     Style="{StaticResource ListBoxBase}"
                                     AutomationProperties.Name="Demandes envoyées">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Addressee.Username}" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding CreatedAt, StringFormat=Le: {0:dd/MM/yyyy HH:mm}}" Foreground="{StaticResource TextMuted}" FontSize="12" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 12 0 0">
                            <Button Content="Annuler"
                                    Command="{Binding CancelRequestCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    AutomationProperties.Name="Annuler la demande" />
                            <Button Content="Bloquer"
                                    Command="{Binding BlockUserCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    AutomationProperties.Name="Bloquer l'utilisateur" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="BlockedPanel"
                        Background="{StaticResource PanelBackground}"
                        CornerRadius="16"
                        Padding="20"
                        BorderBrush="{StaticResource PanelBorder}"
                        BorderThickness="3">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static viewModels:SocialSection.Blocked}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Utilisateurs bloqués"
                                   Foreground="{StaticResource HighlightBrush}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0 0 0 12" />

                        <Grid Grid.Row="1">
                            <TextBlock x:Name="EmptyBlockedText"
                                       Text="Aucun utilisateur bloqué"
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="14"
                                       FontStyle="Italic"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Focusable="True"
                                       AutomationProperties.Name="Aucun utilisateur bloqué">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasItems, ElementName=BlockedList}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ListBox x:Name="BlockedList"
                                     ItemsSource="{Binding BlockedUsers}"
                                     SelectedItem="{Binding SelectedBlockedUser, Mode=TwoWay}"
                                     ItemContainerStyle="{StaticResource ListItem}"
                                     Style="{StaticResource ListBoxBase}"
                                     IsTabStop="False"
                                     AutomationProperties.Name="Liste des utilisateurs bloqués">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Username}" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding BlockedAt, StringFormat=Bloqué le: {0:dd/MM/yyyy}}" Foreground="{StaticResource TextMuted}" FontSize="12" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 12 0 0">
                            <Button Content="Débloquer"
                                    Command="{Binding UnblockUserCommand}"
                                    AutomationProperties.Name="Débloquer l'utilisateur">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="IsEnabled" Value="True" />
                                        <Setter Property="IsTabStop" Value="True" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedBlockedUser}" Value="{x:Null}">
                                                <Setter Property="IsEnabled" Value="False" />
                                                <Setter Property="IsTabStop" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="SearchPanel"
                        Background="{StaticResource PanelBackground}"
                        CornerRadius="16"
                        Padding="20"
                        BorderBrush="{StaticResource PanelBorder}"
                        BorderThickness="3">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static viewModels:SocialSection.Search}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Rechercher un joueur"
                                   Foreground="{StaticResource HighlightBrush}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0 0 0 12" />

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0 0 0 12">
                            <TextBox x:Name="SearchBox"
                                     Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="260"
                                     Height="34"
                                     Margin="0 0 12 0"
                                     Style="{StaticResource InputTextBox}"
                                     TabIndex="0"
                                     AutomationProperties.Name="Champ de recherche joueur" />
                            <Button Content="Rechercher"
                                    Command="{Binding SearchCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    TabIndex="1"
                                    AutomationProperties.Name="Rechercher un joueur" />
                        </StackPanel>

                        <Grid Grid.Row="2">
                        <TextBlock x:Name="EmptySearchText"
                                   Text="Aucun résultat"
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="14"
                                       FontStyle="Italic"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Focusable="True"
                                   AutomationProperties.Name="Aucun résultat">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasItems, ElementName=SearchResultsList}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ListBox x:Name="SearchResultsList"
                                     ItemsSource="{Binding SearchResults}"
                                     SelectedItem="{Binding SelectedSearchUser, Mode=TwoWay}"
                                     DisplayMemberPath="Username"
                                     ItemContainerStyle="{StaticResource ListItem}"
                                     Style="{StaticResource ListBoxBase}"
                                     TabIndex="2"
                                     AutomationProperties.Name="Résultats de recherche">
                            </ListBox>
                        </Grid>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 12 0 0">
                            <Button Content="Ajouter"
                                    Command="{Binding SendRequestCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    AutomationProperties.Name="Envoyer une demande" />
                            <Button Content="Bloquer"
                                    Command="{Binding BlockUserCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    AutomationProperties.Name="Bloquer l'utilisateur" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="ProfilePanel"
                        Background="{StaticResource PanelBackground}"
                        CornerRadius="16"
                        Padding="20"
                        BorderBrush="{StaticResource PanelBorder}"
                        BorderThickness="3">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static viewModels:SocialSection.Profile}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Mon profil"
                                   Foreground="{StaticResource HighlightBrush}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0 0 0 12" />

                        <TextBlock Grid.Row="1"
                                   Text="{Binding Profile.User.Username, TargetNullValue=Profil}"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0 0 0 12" />

                        <TextBlock Grid.Row="2" Text="Bio" Foreground="{StaticResource TextMuted}" FontSize="12" />
                        <TextBox x:Name="ProfileBioBox"
                                 Grid.Row="3"
                                 Text="{Binding ProfileBio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Height="120"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Margin="0 6 0 12"
                                 Style="{StaticResource InputTextBox}"
                                 AutomationProperties.Name="Bio du profil" />

                        <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Orientation="Vertical" Margin="0 0 16 0">
                                <TextBlock Text="Visibilité" Foreground="{StaticResource TextMuted}" FontSize="12" />
                                <ComboBox x:Name="VisibilityBox"
                                          Width="160"
                                          ItemsSource="{Binding VisibilityOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding ProfileVisibility, Mode=TwoWay}"
                                          Style="{StaticResource InputComboBox}"
                                          AutomationProperties.Name="Visibilité du profil" />
                            </StackPanel>
                            <Button Content="Enregistrer"
                                    Command="{Binding UpdateProfileCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    AutomationProperties.Name="Mettre a jour le profil" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Live-region de secours pour annonces NVDA (ex: "Aucun ami" à l'ouverture). -->
	        <TextBlock x:Name="A11yAnnouncer"
	                   Grid.Row="1"
	                   Height="1"
	                   Width="1"
	                   Opacity="0"
	                   IsHitTestVisible="False"
	                   AutomationProperties.IsOffscreenBehavior="Onscreen"
	                   AutomationProperties.Name=""
	                   AutomationProperties.LiveSetting="Polite" />

        <Border Grid.Row="2"
                Background="#0A1523"
                BorderBrush="#1A2F47"
                BorderThickness="0 2 0 0"
                Padding="16 12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="i "
                           FontSize="16"
                           Foreground="{StaticResource HighlightBrush}"
                           VerticalAlignment="Center"
                           Margin="0 0 8 0" />
                <TextBlock Text="{Binding Status}"
                           Foreground="{StaticResource HighlightBrush}"
                           FontSize="14"
                           FontWeight="Medium" />
                <TextBlock Text=" | Flèches menu | Entrée pour choisir | Échap pour fermer"
                           Foreground="#7CA3D6"
                           FontSize="12"
                           Margin="20 0 0 0"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
