<UserControl x:Class="client_win.Modules.Notifications.Views.NotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1280"
             Loaded="OnLoaded"
             KeyDown="OnKeyDown">
    <UserControl.Resources>
        <LinearGradientBrush x:Key="ShellBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F1D2D" Offset="0" />
            <GradientStop Color="#1C3B5E" Offset="0.55" />
            <GradientStop Color="#0E1724" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="PanelBrush" Color="#12263C" />
        <SolidColorBrush x:Key="HighlightBrush" Color="#F2C14E" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="InputTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#0E2034" />
            <Setter Property="BorderBrush" Value="#1F3C60" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="10 8" />
            <Setter Property="Margin" Value="0 0 10 0" />
            <Setter Property="Background" Value="#214570" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource HighlightBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource ShellBackground}" FocusManager.IsFocusScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" Text="Notifications" FontSize="28" FontWeight="SemiBold" Foreground="White" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="12"
                Margin="24" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox x:Name="ItemsList"
                         Grid.Row="0"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         SelectionMode="Single"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         ScrollViewer.CanContentScroll="True"
                         PreviewKeyDown="OnListPreviewKeyDown"
                         AutomationProperties.LabeledBy="{Binding ElementName=TitleText}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Kind}" Foreground="#BFD0E6" />
                                <TextBlock Text="{Binding FromUsername}" Foreground="White" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Message}" Foreground="White" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBox Grid.Row="1"
                         Text="{Binding SelectedDetailText}"
                         Style="{StaticResource InputTextBox}"
                         IsReadOnly="True"
                         IsReadOnlyCaretVisible="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Margin="0,12,0,0"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Détails de la notification" />

                <Border Grid.Row="2"
                        Margin="0,12,0,0"
                        Visibility="{Binding IsReplyMode, Converter={StaticResource BoolToVis}}"
                        Background="#0E2034"
                        BorderBrush="#1F3C60"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Répondre" Foreground="White" FontWeight="SemiBold" />
                        <StackPanel Grid.Row="1" Margin="0,8,0,0">
                            <TextBox x:Name="ReplyBox"
                                     Style="{StaticResource InputTextBox}"
                                     Text="{Binding ReplyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     MinHeight="80"
                                     TextWrapping="Wrap"
                                     AutomationProperties.Name="Réponse" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Envoyer"
                                        Style="{StaticResource ActionButton}"
                                        Command="{Binding SendReplyCommand}"
                                        TabIndex="0"
                                        AutomationProperties.Name="Envoyer la réponse" />
                                <Button Content="Annuler"
                                        Style="{StaticResource ActionButton}"
                                        Command="{Binding CancelReplyCommand}"
                                        TabIndex="1"
                                        AutomationProperties.Name="Annuler" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#0C1523" Padding="12 8" Focusable="False">
            <DockPanel>
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource HighlightBrush}" FontSize="14"
                           HorizontalAlignment="Center" DockPanel.Dock="Left" />
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="Rafraîchir" Style="{StaticResource ActionButton}" Command="{Binding RefreshCommand}" />
                    <Button Content="Répondre" Style="{StaticResource ActionButton}" Command="{Binding ReplyCommand}" IsEnabled="{Binding CanReply}" />
                    <Button Content="Fermer" Style="{StaticResource ActionButton}" Command="{Binding CloseCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

