<UserControl x:Class="client_win.Modules.Messaging.Views.SectionHeaderBorder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <Border Background="#0F2844"
            BorderBrush="#FFD966"
            BorderThickness="0 0 0 3"
            Padding="12 8"
            Margin="0 0 0 12">
        <TextBlock Text="{Binding Title, ElementName=Root}"
                   Foreground="#FFD966"
                   FontSize="16"
                   FontWeight="Bold"
                   HorizontalAlignment="Center" />
    </Border>
</UserControl>
