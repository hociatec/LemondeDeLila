<UserControl x:Class="client_win.Modules.Messaging.Views.MessagingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:messaging="clr-namespace:client_win.Modules.Messaging.Models"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1280"
             Loaded="OnLoaded"
             KeyDown="OnRootKeyDown"
             KeyboardNavigation.TabNavigation="None">

    <UserControl.Resources>
        <!-- Backgrounds -->
        <LinearGradientBrush x:Key="ShellBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F1D2D" Offset="0" />
            <GradientStop Color="#1C3B5E" Offset="0.55" />
            <GradientStop Color="#0E1724" Offset="1" />
        </LinearGradientBrush>

        <!-- Couleurs distinctes pour chaque section -->
        <SolidColorBrush x:Key="BoxesPanelBrush" Color="#0D2236" />
        <SolidColorBrush x:Key="MessagesPanelBrush" Color="#142B44" />
        <SolidColorBrush x:Key="ConversationPanelBrush" Color="#1A3352" />

        <SolidColorBrush x:Key="HighlightBrush" Color="#F2C14E" />
        <SolidColorBrush x:Key="FocusBorderBrush" Color="#FFD966" />
        <SolidColorBrush x:Key="SentBrush" Color="#1F3F62" />
        <SolidColorBrush x:Key="ReceivedBrush" Color="#193047" />

        <!-- Drop Shadow pour isolation visuelle -->
        <DropShadowEffect x:Key="PanelShadow"
                          Color="Black"
                          Opacity="0.6"
                          BlurRadius="20"
                          ShadowDepth="4"
                          Direction="315" />

        <!-- Style pour les boutons -->
        <Style x:Key="BoxButton" TargetType="Button">
            <Setter Property="Height" Value="45" />
            <Setter Property="Margin" Value="0 8 0 0" />
            <Setter Property="Padding" Value="16 12" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#1E3A5C" />
            <Setter Property="BorderBrush" Value="#284C75" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#26456F" />
                    <Setter Property="BorderBrush" Value="#3A5E8C" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style pour les ListBox -->
        <Style x:Key="MessageListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <!-- Style pour les TextBox -->
        <Style x:Key="InputTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0A1827" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#284C75" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource ShellBackground}" KeyboardNavigation.TabNavigation="None">
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ EN-TÊTE ============ -->
        <Border Grid.Row="0" Grid.ColumnSpan="3"
                Background="#0C1523"
                BorderBrush="#1A2F47"
                BorderThickness="0 0 0 2"
                IsHitTestVisible="False">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="💬 MESSAGERIE PRIVÉE"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"
                           IsHitTestVisible="False" />
                <TextBlock Text="{Binding Status}"
                           Foreground="{StaticResource HighlightBrush}"
                           FontSize="14"
                           Margin="0,6,0,0"
                           IsHitTestVisible="False" />
            </StackPanel>
        </Border>

        <!-- ============ SECTION 1 : BOÎTES ET RECHERCHE ============ -->
        <Border x:Name="BoxesPanel"
                Grid.Row="1" Grid.Column="0"
                Background="{StaticResource BoxesPanelBrush}"
                CornerRadius="16"
                Margin="20,20,10,20"
                Padding="16"
                BorderBrush="#1E3C5B"
                BorderThickness="3"
                Effect="{StaticResource PanelShadow}"
                KeyDown="OnBoxesPanelKeyDown">

            <StackPanel KeyboardNavigation.TabNavigation="None">
                <!-- Titre de section -->
                <Border Background="#0A1A2D"
                        CornerRadius="8"
                        Padding="12 8"
                        Margin="0 0 0 16"
                        BorderBrush="#2A4A6A"
                        BorderThickness="2">
                    <TextBlock Text="📁 BOÎTES DE MESSAGES"
                               Foreground="#FFD966"
                               FontSize="16"
                               FontWeight="Bold"
                               HorizontalAlignment="Center" />
                </Border>

                <!-- Boutons de boîtes -->
                <Button x:Name="BtnInbox"
                        Content="📥 Réception"
                        Tag="{x:Static messaging:MessagingBox.Inbox}"
                        Click="OnBoxClick"
                        Style="{StaticResource BoxButton}" />

                <Button x:Name="BtnOutbox"
                        Content="📤 Envoyés"
                        Tag="{x:Static messaging:MessagingBox.Outbox}"
                        Click="OnBoxClick"
                        Style="{StaticResource BoxButton}" />

                <Button x:Name="BtnDeleted"
                        Content="🗑️ Corbeille"
                        Tag="{x:Static messaging:MessagingBox.Deleted}"
                        Click="OnBoxClick"
                        Style="{StaticResource BoxButton}" />

                <!-- Séparateur -->
                <Rectangle Height="2"
                           Fill="#2A4A6A"
                           Margin="0 20 0 16" />

                <!-- Recherche utilisateur -->
                <Border Background="#0A1A2D"
                        CornerRadius="8"
                        Padding="12 8"
                        Margin="0 0 0 12"
                        BorderBrush="#2A4A6A"
                        BorderThickness="2">
                    <TextBlock Text="🔍 RECHERCHE UTILISATEUR"
                               Foreground="#9CB2D1"
                               FontSize="14"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                </Border>

                <TextBox x:Name="SearchBox"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="OnSearchKeyDown"
                         Style="{StaticResource InputTextBox}"
                         Margin="0 0 0 8" />

                <Button Content="💬 Ouvrir conversation"
                        Command="{Binding SearchUserCommand}"
                        Style="{StaticResource BoxButton}" />
            </StackPanel>
        </Border>

        <!-- ============ SECTION 2 : LISTE DES MESSAGES ============ -->
        <Border x:Name="MessagesPanel"
                Grid.Row="1" Grid.Column="1"
                Background="{StaticResource MessagesPanelBrush}"
                CornerRadius="16"
                Margin="10,20,10,20"
                Padding="16"
                BorderBrush="#2A4A6A"
                BorderThickness="3"
                Effect="{StaticResource PanelShadow}"
                KeyDown="OnMessagesPanelKeyDown">

            <Grid KeyboardNavigation.TabNavigation="None">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Titre de section -->
                <Border Background="#0D1F34"
                        CornerRadius="8"
                        Padding="12 8"
                        Margin="0 0 0 16"
                        BorderBrush="#3A5A7A"
                        BorderThickness="2">
                    <TextBlock Text="📬 MESSAGES"
                               Foreground="#FFD966"
                               FontSize="16"
                               FontWeight="Bold"
                               HorizontalAlignment="Center" />
                </Border>

                <!-- Liste des messages -->
                <ListBox x:Name="MessagesList"
                         Grid.Row="1"
                         ItemsSource="{Binding BoxMessages}"
                         SelectedItem="{Binding SelectedMessage, Mode=TwoWay}"
                         MouseDoubleClick="OnMessagesDoubleClick"
                         Style="{StaticResource MessageListBox}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#0D1F34"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0 4 0 8"
                                    BorderBrush="#2A4A6A"
                                    BorderThickness="2">
                                <StackPanel>
                                    <TextBlock Text="{Binding Sender.Username}"
                                               FontWeight="Bold"
                                               FontSize="14"
                                               Foreground="#FFD966" />
                                    <TextBlock Text="{Binding Text}"
                                               TextWrapping="Wrap"
                                               Foreground="#E0E8F0"
                                               Margin="0 4 0 4" />
                                    <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                               FontSize="11"
                                               Foreground="#7CA3D6" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="IsTabStop" Value="False" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#1E3A5C" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <!-- ============ SECTION 3 : CONVERSATION ============ -->
        <Border x:Name="ConversationPanel"
                Grid.Row="1" Grid.Column="2"
                Background="{StaticResource ConversationPanelBrush}"
                CornerRadius="16"
                Margin="10,20,20,20"
                Padding="16"
                BorderBrush="#3A5E8C"
                BorderThickness="3"
                Effect="{StaticResource PanelShadow}"
                KeyDown="OnConversationPanelKeyDown">

            <Grid KeyboardNavigation.TabNavigation="None">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Titre de section -->
                <Border Background="#0F2540"
                        CornerRadius="8"
                        Padding="12 8"
                        Margin="0 0 0 16"
                        BorderBrush="#4A6E9C"
                        BorderThickness="2">
                    <TextBlock Text="{Binding ConversationUser.Username, TargetNullValue='💬 CONVERSATION'}"
                               Foreground="#FFD966"
                               FontSize="16"
                               FontWeight="Bold"
                               HorizontalAlignment="Center" />
                </Border>

                <!-- Messages de conversation -->
                <ListBox x:Name="ConversationList"
                         Grid.Row="1"
                         ItemsSource="{Binding ConversationMessages}"
                         SelectedItem="{Binding SelectedMessage, Mode=TwoWay}"
                         Style="{StaticResource MessageListBox}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12"
                                    CornerRadius="10"
                                    Margin="0 6 0 6"
                                    BorderThickness="2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource ReceivedBrush}" />
                                        <Setter Property="BorderBrush" Value="#2A4A6A" />
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                        <Setter Property="MaxWidth" Value="500" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSent}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource SentBrush}" />
                                                <Setter Property="BorderBrush" Value="#3A5E8C" />
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding Text}"
                                               TextWrapping="Wrap"
                                               Foreground="White"
                                               FontSize="14" />
                                    <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:HH:mm:ss}'}"
                                               FontSize="11"
                                               Foreground="#7CA3D6"
                                               Margin="0 4 0 0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="IsTabStop" Value="False" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- Zone d'input -->
                <Grid Grid.Row="2" Margin="0 16 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="InputBox"
                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="44"
                             VerticalContentAlignment="Center"
                             KeyDown="OnInputKeyDown"
                             Style="{StaticResource InputTextBox}" />

                    <Button Grid.Column="1"
                            Content="📤 Envoyer"
                            Command="{Binding SendCommand}"
                            Margin="12 0 0 0"
                            Width="120"
                            Height="44"
                            Style="{StaticResource BoxButton}" />
                </Grid>
            </Grid>
        </Border>

        <!-- ============ BARRE DE STATUT ============ -->
        <Border Grid.Row="2" Grid.ColumnSpan="3"
                Background="#0A1523"
                BorderBrush="#1A2F47"
                BorderThickness="0 2 0 0"
                Padding="16 12"
                IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="ℹ️ "
                           FontSize="16"
                           Foreground="{StaticResource HighlightBrush}"
                           VerticalAlignment="Center"
                           Margin="0 0 8 0" />
                <TextBlock Text="{Binding Status}"
                           Foreground="{StaticResource HighlightBrush}"
                           FontSize="14"
                           FontWeight="Medium"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <TextBlock Text=" | ⬆️⬇️ Navigation | ↵ Entrée | Echap Fermer"
                           Foreground="#7CA3D6"
                           FontSize="12"
                           Margin="20 0 0 0"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
