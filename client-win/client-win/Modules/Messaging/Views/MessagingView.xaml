<UserControl x:Class="client_win.Modules.Messaging.Views.MessagingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:client_win.Modules.Messaging.Views"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1280"
             Loaded="OnLoaded"
             KeyDown="OnRootKeyDown"
             KeyboardNavigation.TabNavigation="Continue">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MessagingStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource ShellBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ EN-TETE ============ -->
        <Border Grid.Row="0"
                Background="#0C1523"
                BorderBrush="#1A2F47"
                BorderThickness="0 0 0 2"
                IsHitTestVisible="False">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="MESSAGERIE"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White" />
                <TextBlock Text="{Binding Status}"
                           Foreground="{StaticResource HighlightBrush}"
                           FontSize="14"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- ============ CONTENU PRINCIPAL ============ -->
        <Grid Grid.Row="1" Margin="24">
            <!-- ============ MENU ============ -->
            <Border x:Name="MenuPanel"
                    Background="{StaticResource BoxesPanelBrush}"
                    CornerRadius="16"
                    Padding="20"
                    BorderBrush="#1E3C5B"
                    BorderThickness="3"
                    Effect="{StaticResource PanelShadow}">
                <StackPanel KeyboardNavigation.TabNavigation="Continue">
                    <Border Background="#0A1A2D"
                            CornerRadius="8"
                            Padding="12 8"
                            Margin="0 0 0 16"
                            BorderBrush="#2A4A6A"
                            BorderThickness="2">
                        <TextBlock Text="MENU MESSAGERIE"
                                   Foreground="#FFD966"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                    </Border>

                    <ListBox x:Name="MenuList"
                             Style="{StaticResource MenuListBox}"
                             ItemContainerStyle="{StaticResource MenuListItem}"
                             KeyDown="OnMenuKeyDown"
                             PreviewMouseLeftButtonUp="OnMenuClick"
                             IsTabStop="False"
                             AutomationProperties.Name="Menu de navigation de la messagerie">
                        <ListBoxItem x:Name="MenuCompose" Tag="compose" AutomationProperties.Name="Rédiger un nouveau message">
                            <TextBlock Text="Rediger un message" />
                        </ListBoxItem>
                        <ListBoxItem x:Name="MenuInbox" Tag="inbox" AutomationProperties.Name="Boîte de réception">
                            <TextBlock Text="Boite de reception" />
                        </ListBoxItem>
                        <ListBoxItem x:Name="MenuOutbox" Tag="outbox" AutomationProperties.Name="Messages envoyés">
                            <TextBlock Text="Messages envoyes" />
                        </ListBoxItem>
                        <ListBoxItem x:Name="MenuDeleted" Tag="deleted" AutomationProperties.Name="Corbeille, messages supprimés">
                            <TextBlock Text="Corbeille" />
                        </ListBoxItem>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- ============ LISTE DES MESSAGES ============ -->
            <Border x:Name="ListPanel"
                    Background="{StaticResource MessagesPanelBrush}"
                    CornerRadius="16"
                    Padding="20"
                    BorderBrush="#2A4A6A"
                    BorderThickness="3"
                    Effect="{StaticResource PanelShadow}"
                    Visibility="Collapsed">
                <Grid KeyboardNavigation.TabNavigation="Continue">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Background="#0D1F34"
                            CornerRadius="8"
                            Padding="12 8"
                            Margin="0 0 0 16"
                            BorderBrush="#3A5A7A"
                            BorderThickness="2">
                        <TextBlock x:Name="ListTitle"
                                   Foreground="#FFD966"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Boite de reception" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedBox}" Value="Outbox">
                                            <Setter Property="Text" Value="Messages envoyes" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedBox}" Value="Deleted">
                                            <Setter Property="Text" Value="Corbeille" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <Grid Grid.Row="1">
                        <TextBlock x:Name="EmptyMessagesText"
                                   Text="Aucun message"
                                   Foreground="#7CA3D6"
                                   FontSize="16"
                                   FontStyle="Italic"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Focusable="False"
                                   AutomationProperties.Name="Aucun message dans cette boîte">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=MessagesList}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ListBox x:Name="MessagesList"
                             ItemsSource="{Binding BoxMessages}"
                             SelectedItem="{Binding SelectedMessage, Mode=TwoWay}"
                             MouseDoubleClick="OnMessagesDoubleClick"
                             KeyDown="OnMessagesKeyDown"
                             ItemContainerStyle="{StaticResource ListButtonItem}"
                             AutomationProperties.Name="Liste des messages">
                            <ListBox.Style>
                                <Style TargetType="ListBox" BasedOn="{StaticResource MessageListBox}">
                                    <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
                                </Style>
                            </ListBox.Style>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource MessageSubjectText}">
                                        <TextBlock.Text>
                                            <Binding Path="Subject" TargetNullValue="Sans sujet" />
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <!-- ============ DETAIL DU MESSAGE ============ -->
            <Border x:Name="DetailPanel"
                    Background="{StaticResource ConversationPanelBrush}"
                    CornerRadius="16"
                    Padding="20"
                    BorderBrush="#3A5E8C"
                    BorderThickness="3"
                    Effect="{StaticResource PanelShadow}"
                    Visibility="Collapsed">
                <Grid KeyboardNavigation.TabNavigation="Continue">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Background="#0F2540"
                            CornerRadius="8"
                            Padding="12 8"
                            Margin="0 0 0 16"
                            BorderBrush="#4A6E9C"
                            BorderThickness="2">
                        <TextBlock Text="DETAIL DU MESSAGE"
                                   Foreground="#FFD966"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Aucun message"
                                   Foreground="#7CA3D6"
                                   FontSize="16"
                                   FontStyle="Italic"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Grid.RowSpan="3">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedMessage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel Grid.Row="1">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedMessage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <RichTextBox x:Name="DetailDocument"
                                         IsReadOnly="True"
                                         IsReadOnlyCaretVisible="True"
                                         IsDocumentEnabled="True"
                                         Focusable="True"
                                         IsTabStop="True"
                                         MinHeight="320"
                                         Background="#0A1827"
                                         Foreground="White"
                                         BorderBrush="#284C75"
                                         BorderThickness="2"
                                         Padding="10"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Disabled"
                                         AutomationProperties.Name="Détail du message (lecture)" />
                        </StackPanel>

	                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
	                            <Button Content="Repondre"
	                                    Command="{Binding ReplyCommand}"
	                                    Click="OnReplyClick"
	                                    Width="120"
	                                    AutomationProperties.Name="Bouton repondre au message">
	                                <Button.Style>
	                                    <Style TargetType="Button" BasedOn="{StaticResource BoxButton}">
	                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedMessage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="Supprimer"
                                    Command="{Binding DeleteCommand}"
                                    Width="120"
                                    Margin="12 0 0 0"
                                    AutomationProperties.Name="Bouton supprimer le message">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BoxButton}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Content" Value="Supprimer" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedMessage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedBox}" Value="Deleted">
                                                <Setter Property="Content" Value="Supprimer definitivement" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="Restaurer"
                                    Command="{Binding RestoreCommand}"
                                    Width="120"
                                    Margin="12 0 0 0"
                                    AutomationProperties.Name="Bouton restaurer le message">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BoxButton}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedBox}" Value="Deleted">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedMessage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ============ REDACTION ============ -->
            <Border x:Name="ComposePanelContainer"
                    Background="{StaticResource ConversationPanelBrush}"
                    CornerRadius="16"
                    Padding="20"
                    BorderBrush="#3A5E8C"
                    BorderThickness="3"
                    Effect="{StaticResource PanelShadow}"
                    Visibility="Collapsed">
                <Grid KeyboardNavigation.TabNavigation="Continue">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Background="#0F2540"
                            CornerRadius="8"
                            Padding="12 8"
                            Margin="0 0 0 16"
                            BorderBrush="#4A6E9C"
                            BorderThickness="2">
                        <TextBlock Text="REDIGER UN MESSAGE"
                                   Foreground="#FFD966"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                    </Border>

                    <local:ComposeMessagePanel x:Name="ComposePanel"
                                               Grid.Row="1"
                                               Recipient="{Binding ComposeRecipient, Mode=TwoWay}"
                                               Subject="{Binding ComposeSubject, Mode=TwoWay}"
                                               MessageBody="{Binding ComposeBody, Mode=TwoWay}"
                                               SendCommand="{Binding SendComposeCommand}"
                                               KeyboardNavigation.TabNavigation="Cycle" />
                </Grid>
            </Border>
        </Grid>

        <!-- ============ BARRE DE STATUT ============ -->
        <Border Grid.Row="2"
                Background="#0A1523"
                BorderBrush="#1A2F47"
                BorderThickness="0 2 0 0"
                Padding="16 12"
                IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="i "
                           FontSize="16"
                           Foreground="{StaticResource HighlightBrush}"
                           VerticalAlignment="Center"
                           Margin="0 0 8 0" />
                <TextBlock Text="{Binding Status}"
                           Foreground="{StaticResource HighlightBrush}"
                           FontSize="14"
                           FontWeight="Medium"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <TextBlock Text=" | Fleches haut/bas pour naviguer | Entree pour ouvrir | Echap pour revenir"
                           Foreground="#7CA3D6"
                           FontSize="12"
                           Margin="20 0 0 0"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
