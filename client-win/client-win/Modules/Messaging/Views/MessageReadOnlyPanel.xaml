<UserControl x:Class="client_win.Modules.Messaging.Views.MessageReadOnlyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MessagingStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="#0D2440"
            CornerRadius="8"
            Padding="16"
            BorderBrush="#2A4A6A"
            BorderThickness="2"
            Margin="0 0 0 12">
        <StackPanel>
            <!-- En-tête avec expéditeur et date -->
            <Grid Margin="0 0 0 8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding Message.Sender.Username, ElementName=Root, StringFormat=De: {0}}"
                           FontWeight="Bold"
                           FontSize="14"
                           Foreground="#FFD966" />

                <TextBlock Grid.Column="1"
                           Text="{Binding Message.CreatedAt, ElementName=Root, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                           FontSize="11"
                           Foreground="#7CA3D6" />
            </Grid>

            <!-- Sujet -->
            <TextBlock Text="{Binding Message.Subject, ElementName=Root, StringFormat=Sujet: {0}}"
                       Style="{StaticResource SubjectText}"
                       Margin="0 0 0 8" />

            <!-- Contenu du message -->
            <Border Background="#0A1A2D"
                    CornerRadius="6"
                    Padding="12"
                    BorderBrush="#1A3A5A"
                    BorderThickness="1">
                <TextBlock Text="{Binding Message.Text, ElementName=Root}"
                           TextWrapping="Wrap"
                           Foreground="#E0E8F0"
                           FontSize="13"
                           AutomationProperties.Name="Contenu du message original" />
            </Border>
        </StackPanel>
    </Border>
</UserControl>
