<UserControl x:Class="client_win.Modules.Messaging.Views.ConversationInputPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:client_win.Modules.Messaging.Views"
             x:Name="Root">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MessagingStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel>
            <TextBlock x:Name="ConversationMessageLabel" Text="Message" Style="{StaticResource FieldLabel}" />
            <local:PlaceholderTextBox x:Name="InputBox"
                Text="{Binding InputText, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Placeholder="Ecrire ici puis Entrer pour envoyer"
                AcceptsReturn="True"
                MinHeight="80"
                VerticalContentAlignment="Top"
                AutomationProperties.Name="Champ de saisie de message, appuyez sur Entrée pour envoyer"
                AutomationProperties.LabeledBy="{Binding ElementName=ConversationMessageLabel}"
                AcceptsTab="False"
                IsTabStop="True" />
        </StackPanel>

        <Button Grid.Column="1"
                Content="Envoyer"
                Command="{Binding SendCommand, ElementName=Root}"
                Margin="12 0 0 0"
                Width="120"
                Height="44"
                Style="{StaticResource BoxButton}"
                AutomationProperties.Name="Bouton envoyer le message dans la conversation"
                IsTabStop="True" />
    </Grid>
</UserControl>
