<UserControl x:Class="client_win.Modules.Messaging.Views.MessageBubble"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MessagingStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Padding="12"
            CornerRadius="10"
            Margin="0 6 0 6"
            BorderThickness="2"
            AutomationProperties.Name="{Binding Message, ElementName=Root}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{StaticResource ReceivedBrush}" />
                <Setter Property="BorderBrush" Value="#2A4A6A" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="MaxWidth" Value="500" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Message.IsSent, ElementName=Root}" Value="True">
                        <Setter Property="Background" Value="{StaticResource SentBrush}" />
                        <Setter Property="BorderBrush" Value="#3A5E8C" />
                        <Setter Property="HorizontalAlignment" Value="Right" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel>
            <TextBlock Text="{Binding Message.Subject, ElementName=Root, StringFormat=Sujet: {0}}"
                       Style="{StaticResource SubjectText}" />
            <TextBlock Text="{Binding Message.Text, ElementName=Root}"
                       TextWrapping="Wrap"
                       Foreground="White"
                       FontSize="14" />
            <TextBlock Text="{Binding Message.CreatedAt, ElementName=Root, StringFormat='{}{0:HH:mm:ss}'}"
                       FontSize="11"
                       Foreground="#7CA3D6"
                       Margin="0 4 0 0" />
        </StackPanel>
    </Border>
</UserControl>
