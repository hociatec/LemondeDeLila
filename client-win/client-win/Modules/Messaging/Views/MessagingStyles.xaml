<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Backgrounds -->
    <LinearGradientBrush x:Key="ShellBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0F1D2D" Offset="0" />
        <GradientStop Color="#1C3B5E" Offset="0.55" />
        <GradientStop Color="#0E1724" Offset="1" />
    </LinearGradientBrush>

    <!-- Couleurs distinctes pour chaque section -->
    <SolidColorBrush x:Key="BoxesPanelBrush" Color="#0D2236" />
    <SolidColorBrush x:Key="MessagesPanelBrush" Color="#142B44" />
    <SolidColorBrush x:Key="ConversationPanelBrush" Color="#1A3352" />
    <SolidColorBrush x:Key="FocusBorderBrush" Color="#FFD966" />
    <SolidColorBrush x:Key="SentBrush" Color="#1F3F62" />
    <SolidColorBrush x:Key="ReceivedBrush" Color="#193047" />

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- Style pour les boutons -->
    <Style x:Key="BoxButton" TargetType="Button">
        <Setter Property="Height" Value="45" />
        <Setter Property="Margin" Value="0 8 0 0" />
        <Setter Property="Padding" Value="16 12" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="#1E3A5C" />
        <Setter Property="BorderBrush" Value="#284C75" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#26456F" />
                <Setter Property="BorderBrush" Value="#3A5E8C" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Style pour les ListBox -->
    <Style x:Key="MessageListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style x:Key="MenuListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style x:Key="MenuListItem" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0 8 0 0" />
        <Setter Property="Padding" Value="16 12" />
        <Setter Property="Background" Value="#1E3A5C" />
        <Setter Property="BorderBrush" Value="#284C75" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#26456F" />
                <Setter Property="BorderBrush" Value="#FFD966" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="#FFD966" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ListButtonItem" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0 6 0 8" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Background" Value="#0D1F34" />
        <Setter Property="BorderBrush" Value="#2A4A6A" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#1E3A5C" />
                <Setter Property="BorderBrush" Value="#FFD966" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="#FFD966" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Style pour les TextBox -->
    <Style x:Key="InputTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="#0A1827" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="#284C75" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style x:Key="SubjectText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#9CB2D1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0 0 0 4" />
        <Setter Property="Visibility" Value="Visible" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Subject}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Subject}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#9CB2D1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0 0 0 6" />
    </Style>

    <Style x:Key="PlaceholderText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#6F8FB6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="12 0 0 0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style x:Key="MessageSubjectText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Subject}" Value="">
                <Setter Property="Text" Value="Sans sujet" />
                <Setter Property="Foreground" Value="#9CB2D1" />
                <Setter Property="FontStyle" Value="Italic" />
            </DataTrigger>
            <DataTrigger Binding="{Binding SelectedMessage.Subject}" Value="">
                <Setter Property="Text" Value="Sans sujet" />
                <Setter Property="Foreground" Value="#9CB2D1" />
                <Setter Property="FontStyle" Value="Italic" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
