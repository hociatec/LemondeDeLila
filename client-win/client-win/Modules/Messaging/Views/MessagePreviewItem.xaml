<UserControl x:Class="client_win.Modules.Messaging.Views.MessagePreviewItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MessagingStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel AutomationProperties.Name="{Binding Message, ElementName=Root}">
        <TextBlock Text="{Binding Message.Sender.Username, ElementName=Root}"
                   FontWeight="Bold"
                   FontSize="14"
                   Foreground="#FFD966" />
        <TextBlock Text="{Binding Message.Subject, ElementName=Root, StringFormat=Sujet: {0}}"
                   Style="{StaticResource SubjectText}" />
        <TextBlock Text="{Binding Message.Text, ElementName=Root}"
                   TextWrapping="Wrap"
                   Foreground="#E0E8F0"
                   Margin="0 4 0 4" />
        <TextBlock Text="{Binding Message.CreatedAt, ElementName=Root, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                   FontSize="11"
                   Foreground="#7CA3D6" />
    </StackPanel>
</UserControl>
