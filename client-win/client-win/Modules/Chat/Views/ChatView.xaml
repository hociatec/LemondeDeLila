<UserControl x:Class="client_win.Modules.Chat.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1280"
             Loaded="OnLoaded"
             PreviewKeyDown="OnRootPreviewKeyDown">
    <UserControl.Resources>
        <LinearGradientBrush x:Key="ShellBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F1D2D" Offset="0" />
            <GradientStop Color="#1C3B5E" Offset="0.55" />
            <GradientStop Color="#0E1724" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="PanelBrush" Color="#12263C" />
        <SolidColorBrush x:Key="HighlightBrush" Color="#F2C14E" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12 8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#1E3A5C" />
            <Setter Property="BorderBrush" Value="#284C75" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0C1523" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#284C75" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource ShellBackground}" KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#0C1523"
                BorderBrush="#1A2F47"
                BorderThickness="0 0 0 2"
                IsHitTestVisible="False">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="TCHAT GLOBAL"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"
                           IsHitTestVisible="False" />
                <TextBlock Text="{Binding Status}"
                           Foreground="{StaticResource HighlightBrush}"
                           FontSize="14"
                           Margin="0,6,0,0"
                           IsHitTestVisible="False" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource PanelBrush}"
                CornerRadius="12"
                Margin="24"
                Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Label Content="Historique"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0 0 12 0"
                           Target="{Binding ElementName=HistoryBox}" />
                    <TextBlock Text="Aucun message pour le moment"
                               Foreground="#9CB2D1"
                               VerticalAlignment="Center"
                               Visibility="{Binding Messages.Count, Converter={StaticResource BoolToVisibility}, ConverterParameter=False}" />
                </StackPanel>

                <TextBox Grid.Row="1"
                         x:Name="HistoryBox"
                         Text="{Binding HistoryText, Mode=OneWay}"
                         IsReadOnly="True"
                         IsReadOnlyCaretVisible="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="White"
                         IsTabStop="True"
                         TabIndex="0"
                         SpellCheck.IsEnabled="False"
                         TextBoxBase.IsUndoEnabled="False"
                         AutomationProperties.Name="Historique des messages"
                         AutomationProperties.HelpText="Historique en lecture seule. Utilisez les flèches pour lire ligne par ligne." />

                <Grid Grid.Row="2" Margin="0 16 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Message" Target="{Binding ElementName=InputBox}" Foreground="#9CB2D1" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             x:Name="InputBox"
                             Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                             MinWidth="200"
                             VerticalContentAlignment="Center"
                             KeyDown="OnInputKeyDown"
                             TabIndex="1"
                             AutomationProperties.Name="Message à envoyer" />
                    <Button Grid.Column="2" Content="Envoyer" Command="{Binding SendCommand}" Margin="8 0 0 0" TabIndex="2" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#0C1523" Padding="12 8" Focusable="False"
                AutomationProperties.LiveSetting="Polite">
            <TextBlock Text="Appuyez sur Échap pour fermer le tchat."
                       Foreground="#9CB2D1"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Focusable="False" />
        </Border>
    </Grid>
</UserControl>
