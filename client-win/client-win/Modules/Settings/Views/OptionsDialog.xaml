<Window x:Class="client_win.Modules.Settings.Views.OptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Options" Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="#0B1523"
        Loaded="OnLoaded"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#12263C" />
        <SolidColorBrush x:Key="HighlightBrush" Color="#F2C14E" />
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Margin" Value="0 6 0 6" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12 8" />
            <Setter Property="Margin" Value="8 0 0 0" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#0F1D2D" />
            <Setter Property="BorderBrush" Value="#244A75" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12 10" />
            <Setter Property="Margin" Value="0 0 0 6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1C3B5E" />
                                <Setter Property="Foreground" Value="{StaticResource HighlightBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource HighlightBrush}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0 0 0 12">
            <TextBlock Text="Options" FontSize="22" Foreground="White" />
            <TextBlock Text="Général, sons, tchat" Foreground="#9CB2D1" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ListBox x:Name="CategoryList"
                         Grid.Column="0"
                         ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory}"
                         AutomationProperties.Name="Catégories des options"
                         KeyboardNavigation.TabNavigation="Once" />

                <ContentControl Grid.Column="2">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Content">
                                <Setter.Value>
                                    <TextBlock Text="Sélectionnez une catégorie." Foreground="#9CB2D1" />
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory}" Value="Général">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <StackPanel Margin="8">
                                                    <TextBlock Text="Général" FontSize="20" Foreground="White" />
                                                    <TextBlock Text="Comportement général du client." Foreground="#9CB2D1" Margin="0 2 0 10" />
                                                    <CheckBox Content="Demander confirmation à la fermeture" IsChecked="{Binding ConfirmExit}" />
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding SelectedCategory}" Value="Sons">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <StackPanel Margin="8">
                                                    <TextBlock Text="Sons" FontSize="20" Foreground="White" />
                                                    <TextBlock Text="Volumes et activation des sons du client." Foreground="#9CB2D1" Margin="0 2 0 10" />

                                                    <CheckBox Content="Désactiver tous les sons" IsChecked="{Binding MuteAll}" />

                                                    <Separator Margin="0 10 0 10" />

                                                    <CheckBox Content="Ambiance (menu et taverne)" IsChecked="{Binding SoundAmbience}" />
                                                    <TextBlock Text="{Binding SoundAmbienceVolume, StringFormat=Volume ambiance : {0}%}" Foreground="#9CB2D1" Margin="0 2 0 2" />
                                                    <Slider Minimum="0" Maximum="100"
                                                            Value="{Binding SoundAmbienceVolume, UpdateSourceTrigger=PropertyChanged}"
                                                            IsEnabled="{Binding IsAmbienceVolumeEnabled}"
                                                            AutomationProperties.Name="Volume ambiance"
                                                            AutomationProperties.HelpText="De 0 à 100. Utilisez les flèches haut et bas pour ajuster." />

                                                    <Separator Margin="0 10 0 10" />

                                                    <CheckBox Content="Son à l'ouverture du client" IsChecked="{Binding SoundAppLaunch}" />
                                                    <TextBlock Text="{Binding SoundAppLaunchVolume, StringFormat=Volume ouverture : {0}%}" Foreground="#9CB2D1" Margin="0 2 0 2" />
                                                    <Slider Minimum="0" Maximum="100"
                                                            Value="{Binding SoundAppLaunchVolume, UpdateSourceTrigger=PropertyChanged}"
                                                            IsEnabled="{Binding IsAppLaunchVolumeEnabled}"
                                                            AutomationProperties.Name="Volume ouverture"
                                                            AutomationProperties.HelpText="De 0 à 100. Utilisez les flèches haut et bas pour ajuster." />

                                                    <CheckBox Content="Sons de navigation (connexion / déconnexion)" IsChecked="{Binding SoundNavigate}" Margin="0 12 0 6" />
                                                    <TextBlock Text="{Binding SoundNavigateVolume, StringFormat=Volume navigation : {0}%}" Foreground="#9CB2D1" Margin="0 2 0 2" />
                                                    <Slider Minimum="0" Maximum="100"
                                                            Value="{Binding SoundNavigateVolume, UpdateSourceTrigger=PropertyChanged}"
                                                            IsEnabled="{Binding IsNavigateVolumeEnabled}"
                                                            AutomationProperties.Name="Volume navigation"
                                                            AutomationProperties.HelpText="De 0 à 100. Utilisez les flèches haut et bas pour ajuster." />

                                                    <CheckBox Content="Sons de sélection (invitations / tables)" IsChecked="{Binding SoundSelect}" Margin="0 12 0 6" />
                                                    <TextBlock Text="{Binding SoundSelectVolume, StringFormat=Volume sélection : {0}%}" Foreground="#9CB2D1" Margin="0 2 0 2" />
                                                    <Slider Minimum="0" Maximum="100"
                                                            Value="{Binding SoundSelectVolume, UpdateSourceTrigger=PropertyChanged}"
                                                            IsEnabled="{Binding IsSelectVolumeEnabled}"
                                                            AutomationProperties.Name="Volume sélection"
                                                            AutomationProperties.HelpText="De 0 à 100. Utilisez les flèches haut et bas pour ajuster." />

                                                    <CheckBox Content="Sons des messages (tchat et privés)" IsChecked="{Binding SoundChatMessages}" Margin="0 12 0 6" />
                                                    <TextBlock Text="{Binding SoundChatMessagesVolume, StringFormat=Volume messages : {0}%}" Foreground="#9CB2D1" Margin="0 2 0 2" />
                                                    <Slider Minimum="0" Maximum="100"
                                                            Value="{Binding SoundChatMessagesVolume, UpdateSourceTrigger=PropertyChanged}"
                                                            IsEnabled="{Binding IsChatMessagesVolumeEnabled}"
                                                            AutomationProperties.Name="Volume messages"
                                                            AutomationProperties.HelpText="De 0 à 100. Utilisez les flèches haut et bas pour ajuster." />
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding SelectedCategory}" Value="Tchat">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <StackPanel Margin="8">
                                                    <TextBlock Text="Tchat" FontSize="20" Foreground="White" />
                                                    <TextBlock Text="Activation et fermeture du tchat." Foreground="#9CB2D1" Margin="0 2 0 10" />
                                                    <CheckBox Content="Activer le tchat global" IsChecked="{Binding ChatEnabled}" />
                                                    <CheckBox Content="Demander confirmation avant de fermer le tchat" IsChecked="{Binding ConfirmChatExit}" />
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 12 0 0">
            <Button x:Name="CancelButton"
                    Content="Annuler"
                    IsCancel="True"
                    Click="OnCancelClicked" />
            <Button x:Name="SaveButton"
                    Content="Enregistrer"
                    IsDefault="True"
                    Background="#2E8B57"
                    Click="OnSaveClicked" />
        </StackPanel>
    </Grid>
</Window>
