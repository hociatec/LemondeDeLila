<UserControl x:Class="client_win.Modules.Settings.Views.OptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1280"
             Loaded="OnLoaded"
             PreviewKeyDown="OnPreviewKeyDown">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#12263C" />
        <SolidColorBrush x:Key="HighlightBrush" Color="#F2C14E" />
        <LinearGradientBrush x:Key="ShellBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F1D2D" Offset="0" />
            <GradientStop Color="#1C3B5E" Offset="0.55" />
            <GradientStop Color="#0E1724" Offset="1" />
        </LinearGradientBrush>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Margin" Value="0 6 0 6" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12 8" />
            <Setter Property="Margin" Value="8 0 0 0" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#0F1D2D" />
            <Setter Property="BorderBrush" Value="#244A75" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12 10" />
            <Setter Property="Margin" Value="0 0 0 6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1C3B5E" />
                                <Setter Property="Foreground" Value="{StaticResource HighlightBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource HighlightBrush}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource ShellBackground}"
          FocusManager.IsFocusScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="24 20 24 12">
            <TextBlock Text="Options" FontSize="28" FontWeight="SemiBold" Foreground="White" />
            <TextBlock Text="Général, sons, tchat" Foreground="#9CB2D1" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="16" Margin="24 0 24 16">
            <TabControl x:Name="CategoryTabs"
                        ItemsSource="{Binding Categories}"
                        SelectedItem="{Binding SelectedCategory}"
                        KeyboardNavigation.TabNavigation="Continue">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" />
                    </DataTemplate>
                </TabControl.ItemTemplate>

                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <ContentControl DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                        Focusable="False"
                                        IsTabStop="False"
                                        KeyboardNavigation.TabNavigation="Continue">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <TextBlock Text="Sélectionnez une catégorie." Foreground="#9CB2D1" />
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCategory}" Value="Général">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          Focusable="False"
                                                          IsTabStop="False"
                                                          KeyboardNavigation.TabNavigation="Continue">
                                                <StackPanel Margin="8">
                                                    <TextBlock Text="Général" FontSize="22" Foreground="White" />
                                                    <TextBlock Text="Comportement général du client." Foreground="#9CB2D1" Margin="0 2 0 10" />
                                                    <CheckBox Content="Demander confirmation à la fermeture" IsChecked="{Binding ConfirmExit}" />
                                                </StackPanel>
                                            </ScrollViewer>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding SelectedCategory}" Value="Sons">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          Focusable="False"
                                                          IsTabStop="False"
                                                          KeyboardNavigation.TabNavigation="Continue">
                                                <StackPanel Margin="8">
                                                    <TextBlock Text="Sons" FontSize="22" Foreground="White" />
                                                    <TextBlock Text="Volumes et activation des sons du client." Foreground="#9CB2D1" Margin="0 2 0 10" />

                                                    <CheckBox Content="Désactiver tous les sons" IsChecked="{Binding MuteAll}" />

                                                    <Separator Margin="0 10 0 10" />

                                                    <CheckBox Content="Ambiance (menu et taverne)" IsChecked="{Binding SoundAmbience}" />
                                                    <TextBlock Text="{Binding SoundAmbienceVolume, StringFormat=Volume ambiance : {0}%}" Foreground="#9CB2D1" Margin="0 2 0 2" />
                                                    <Slider Minimum="0" Maximum="100"
                                                            Value="{Binding SoundAmbienceVolume, UpdateSourceTrigger=PropertyChanged}"
                                                            SmallChange="1"
                                                            LargeChange="10"
                                                            IsSnapToTickEnabled="True"
                                                            TickFrequency="1"
                                                            IsEnabled="{Binding IsAmbienceVolumeEnabled}"
                                                            AutomationProperties.Name="Volume ambiance"
                                                            AutomationProperties.HelpText="De 0 à 100. Utilisez les flèches haut et bas pour ajuster." />

                                                    <Separator Margin="0 10 0 10" />

                                                    <CheckBox Content="Son à l'ouverture du client" IsChecked="{Binding SoundAppLaunch}" />
                                                    <TextBlock Text="{Binding SoundAppLaunchVolume, StringFormat=Volume ouverture : {0}%}" Foreground="#9CB2D1" Margin="0 2 0 2" />
                                                    <Slider Minimum="0" Maximum="100"
                                                            Value="{Binding SoundAppLaunchVolume, UpdateSourceTrigger=PropertyChanged}"
                                                            SmallChange="1"
                                                            LargeChange="10"
                                                            IsSnapToTickEnabled="True"
                                                            TickFrequency="1"
                                                            IsEnabled="{Binding IsAppLaunchVolumeEnabled}"
                                                            AutomationProperties.Name="Volume ouverture"
                                                            AutomationProperties.HelpText="De 0 à 100. Utilisez les flèches haut et bas pour ajuster." />

                                                    <CheckBox Content="Sons de navigation (connexion / déconnexion)" IsChecked="{Binding SoundNavigate}" Margin="0 12 0 6" />
                                                    <TextBlock Text="{Binding SoundNavigateVolume, StringFormat=Volume navigation : {0}%}" Foreground="#9CB2D1" Margin="0 2 0 2" />
                                                    <Slider Minimum="0" Maximum="100"
                                                            Value="{Binding SoundNavigateVolume, UpdateSourceTrigger=PropertyChanged}"
                                                            SmallChange="1"
                                                            LargeChange="10"
                                                            IsSnapToTickEnabled="True"
                                                            TickFrequency="1"
                                                            IsEnabled="{Binding IsNavigateVolumeEnabled}"
                                                            AutomationProperties.Name="Volume navigation"
                                                            AutomationProperties.HelpText="De 0 à 100. Utilisez les flèches haut et bas pour ajuster." />

                                                    <CheckBox Content="Sons de sélection (invitations / tables)" IsChecked="{Binding SoundSelect}" Margin="0 12 0 6" />
                                                    <TextBlock Text="{Binding SoundSelectVolume, StringFormat=Volume sélection : {0}%}" Foreground="#9CB2D1" Margin="0 2 0 2" />
                                                    <Slider Minimum="0" Maximum="100"
                                                            Value="{Binding SoundSelectVolume, UpdateSourceTrigger=PropertyChanged}"
                                                            SmallChange="1"
                                                            LargeChange="10"
                                                            IsSnapToTickEnabled="True"
                                                            TickFrequency="1"
                                                            IsEnabled="{Binding IsSelectVolumeEnabled}"
                                                            AutomationProperties.Name="Volume sélection"
                                                            AutomationProperties.HelpText="De 0 à 100. Utilisez les flèches haut et bas pour ajuster." />

                                                    <CheckBox Content="Sons des messages (tchat et privés)" IsChecked="{Binding SoundChatMessages}" Margin="0 12 0 6" />
                                                    <TextBlock Text="{Binding SoundChatMessagesVolume, StringFormat=Volume messages : {0}%}" Foreground="#9CB2D1" Margin="0 2 0 2" />
                                                    <Slider Minimum="0" Maximum="100"
                                                            Value="{Binding SoundChatMessagesVolume, UpdateSourceTrigger=PropertyChanged}"
                                                            SmallChange="1"
                                                            LargeChange="10"
                                                            IsSnapToTickEnabled="True"
                                                            TickFrequency="1"
                                                            IsEnabled="{Binding IsChatMessagesVolumeEnabled}"
                                                            AutomationProperties.Name="Volume messages"
                                                            AutomationProperties.HelpText="De 0 à 100. Utilisez les flèches haut et bas pour ajuster." />
                                                </StackPanel>
                                            </ScrollViewer>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding SelectedCategory}" Value="Tchat">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          Focusable="False"
                                                          IsTabStop="False"
                                                          KeyboardNavigation.TabNavigation="Continue">
                                                <StackPanel Margin="8">
                                                    <TextBlock Text="Tchat" FontSize="22" Foreground="White" />
                                                    <TextBlock Text="Activation et fermeture du tchat." Foreground="#9CB2D1" Margin="0 2 0 10" />
                                                    <CheckBox Content="Activer le tchat global" IsChecked="{Binding ChatEnabled}" />
                                                    <CheckBox Content="Demander confirmation avant de fermer le tchat" IsChecked="{Binding ConfirmChatExit}" />
                                                </StackPanel>
                                            </ScrollViewer>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24 0 24 20">
            <Button Content="Annuler" IsCancel="True" Command="{Binding CancelCommand}" />
            <Button Content="Enregistrer" IsDefault="True" Background="#2E8B57" Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
