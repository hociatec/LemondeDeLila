<UserControl x:Class="client_win.Modules.Settings.Views.OptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1280"
             Loaded="OnLoaded"
             PreviewKeyDown="OnPreviewKeyDown">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#12263C" />
        <SolidColorBrush x:Key="HighlightBrush" Color="#F2C14E" />
        <LinearGradientBrush x:Key="ShellBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F1D2D" Offset="0" />
            <GradientStop Color="#1C3B5E" Offset="0.55" />
            <GradientStop Color="#0E1724" Offset="1" />
        </LinearGradientBrush>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Margin" Value="0 6 0 6" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12 8" />
            <Setter Property="Margin" Value="8 0 0 0" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="16" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource ShellBackground}"
          FocusManager.IsFocusScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="24 20 24 12">
            <TextBlock Text="Options" FontSize="28" FontWeight="SemiBold" Foreground="White" />
            <TextBlock Text="Volume, tchat, général, mises à jour" Foreground="#9CB2D1" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="16" Margin="24 0 24 16">
            <TabControl AutomationProperties.Name="Onglets des options"
                        KeyboardNavigation.TabNavigation="Cycle">
                <TabItem Header="Volume">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <CheckBox x:Name="FirstFocusable" Content="Désactiver tous les sons" IsChecked="{Binding MuteAll}" />
                        <CheckBox Content="Demander confirmation à la fermeture" IsChecked="{Binding ConfirmExit}" />
                        <TextBlock Text="{Binding MusicVolume, StringFormat=Musique : {0}%}" Foreground="White" Margin="0 10 0 2" />
                        <Slider Minimum="0" Maximum="100"
                                Value="{Binding MusicVolume, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding IsVolumeEnabled}"
                                AutomationProperties.Name="Volume musique"
                                AutomationProperties.HelpText="De 0 à 100. Utilisez les flèches haut et bas pour ajuster." />
                        <CheckBox Content="Son d'entrée dans la taverne" IsChecked="{Binding SoundAppLaunch}" />
                        <TextBlock Text="{Binding SoundAppLaunchVolume, StringFormat=Volume entrée : {0}%}" Foreground="#9CB2D1" Margin="0 2 0 2" />
                        <Slider Minimum="0" Maximum="100"
                                Value="{Binding SoundAppLaunchVolume, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding IsAppLaunchVolumeEnabled}"
                                AutomationProperties.Name="Volume son d'entrée"
                                AutomationProperties.HelpText="De 0 à 100. Utilisez les flèches haut et bas pour ajuster." />
                        <CheckBox Content="Ambiance de taverne en fond" IsChecked="{Binding SoundBackground}" />
                        <TextBlock Text="{Binding SoundBackgroundVolume, StringFormat=Volume ambiance : {0}%}" Foreground="#9CB2D1" Margin="0 2 0 2" />
                        <Slider Minimum="0" Maximum="100"
                                Value="{Binding SoundBackgroundVolume, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding IsBackgroundVolumeEnabled}"
                                AutomationProperties.Name="Volume ambiance"
                                AutomationProperties.HelpText="De 0 à 100. Utilisez les flèches haut et bas pour ajuster." />
                        <CheckBox Content="Son lors de la navigation" IsChecked="{Binding SoundNavigate}" />
                        <TextBlock Text="{Binding SoundNavigateVolume, StringFormat=Volume navigation : {0}%}" Foreground="#9CB2D1" Margin="0 2 0 2" />
                        <Slider Minimum="0" Maximum="100"
                                Value="{Binding SoundNavigateVolume, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding IsNavigateVolumeEnabled}"
                                AutomationProperties.Name="Volume navigation"
                                AutomationProperties.HelpText="De 0 à 100. Utilisez les flèches haut et bas pour ajuster." />
                        <CheckBox Content="Son lors de la sélection" IsChecked="{Binding SoundSelect}" />
                        <TextBlock Text="{Binding SoundSelectVolume, StringFormat=Volume sélection : {0}%}" Foreground="#9CB2D1" Margin="0 2 0 2" />
                        <Slider Minimum="0" Maximum="100"
                                Value="{Binding SoundSelectVolume, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding IsSelectVolumeEnabled}"
                                AutomationProperties.Name="Volume sélection"
                                AutomationProperties.HelpText="De 0 à 100. Utilisez les flèches haut et bas pour ajuster." />
                    </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Tchat">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <CheckBox Content="Activer le tchat global" IsChecked="{Binding ChatEnabled}" />
                        <CheckBox Content="Demander confirmation avant de fermer le tchat" IsChecked="{Binding ConfirmChatExit}" />
                        <Separator Margin="0 10 0 10" />
                        <CheckBox Content="Son pour les messages du tchat (envoi/réception)" IsChecked="{Binding SoundChatMessages}" />
                        <TextBlock Text="{Binding SoundChatMessagesVolume, StringFormat=Volume tchat : {0}%}" Foreground="#9CB2D1" Margin="0 2 0 2" />
                        <Slider Minimum="0" Maximum="100"
                                Value="{Binding SoundChatMessagesVolume, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding IsChatMessagesVolumeEnabled}"
                                AutomationProperties.Name="Volume tchat"
                                AutomationProperties.HelpText="De 0 à 100. Utilisez les flèches haut et bas pour ajuster." />
                    </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Général">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <CheckBox Content="Rester connecté automatiquement" IsChecked="{Binding StayConnected}" />
                        <CheckBox Content="Descriptions complémentaires (accessibilité)" IsChecked="{Binding ExtraDescriptions}" />
                    </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24 0 24 20">
            <Button Content="Annuler" IsCancel="True" Command="{Binding CancelCommand}" />
            <Button Content="Enregistrer" IsDefault="True" Background="#2E8B57" Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
