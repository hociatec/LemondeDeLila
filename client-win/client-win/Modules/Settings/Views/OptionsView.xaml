<UserControl x:Class="client_win.Modules.Settings.Views.OptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1280"
             Loaded="OnLoaded"
             PreviewKeyDown="OnPreviewKeyDown">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#12263C" />
        <SolidColorBrush x:Key="HighlightBrush" Color="#F2C14E" />
        <LinearGradientBrush x:Key="ShellBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F1D2D" Offset="0" />
            <GradientStop Color="#1C3B5E" Offset="0.55" />
            <GradientStop Color="#0E1724" Offset="1" />
        </LinearGradientBrush>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Margin" Value="0 6 0 6" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12 8" />
            <Setter Property="Margin" Value="8 0 0 0" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource ShellBackground}"
          FocusManager.IsFocusScope="True"
          FocusManager.FocusedElement="{Binding ElementName=FirstFocusable}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="24 20 24 12">
            <TextBlock Text="Options" FontSize="28" FontWeight="SemiBold" Foreground="White" />
            <TextBlock Text="Volume, chat, général, mises à jour" Foreground="#9CB2D1" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="16" Margin="24 0 24 16">
            <TabControl>
                <TabItem Header="Volume">
                    <StackPanel Margin="8">
                        <CheckBox x:Name="FirstFocusable" Content="Désactiver tous les sons" IsChecked="{Binding MuteAll}" />
                        <CheckBox Content="Demander confirmation à la fermeture" IsChecked="{Binding ConfirmExit}" />
                        <TextBlock Text="Musique" Foreground="White" Margin="0 6 0 2" />
                        <Slider Minimum="0" Maximum="100" Value="{Binding MusicVolume}" IsEnabled="{Binding IsVolumeEnabled}" />
                        <CheckBox Content="Son d'entrée dans la taverne" IsChecked="{Binding SoundAppLaunch}" />
                        <Slider Minimum="0" Maximum="100" Value="{Binding SoundAppLaunchVolume}" IsEnabled="{Binding IsAppLaunchVolumeEnabled}" />
                        <CheckBox Content="Ambiance de taverne en fond" IsChecked="{Binding SoundBackground}" />
                        <Slider Minimum="0" Maximum="100" Value="{Binding SoundBackgroundVolume}" IsEnabled="{Binding IsBackgroundVolumeEnabled}" />
                        <CheckBox Content="Son lors de la navigation" IsChecked="{Binding SoundNavigate}" />
                        <Slider Minimum="0" Maximum="100" Value="{Binding SoundNavigateVolume}" IsEnabled="{Binding IsNavigateVolumeEnabled}" />
                        <CheckBox Content="Son lors de la sélection" IsChecked="{Binding SoundSelect}" />
                        <Slider Minimum="0" Maximum="100" Value="{Binding SoundSelectVolume}" IsEnabled="{Binding IsSelectVolumeEnabled}" />
                    </StackPanel>
                </TabItem>
                <TabItem Header="Chat">
                    <StackPanel Margin="8">
                        <CheckBox Content="Activer le tchat global" IsChecked="{Binding ChatEnabled}" />
                        <CheckBox Content="Demander confirmation avant de fermer le tchat" IsChecked="{Binding ConfirmChatExit}" />
                    </StackPanel>
                </TabItem>
                <TabItem Header="Général">
                    <StackPanel Margin="8">
                        <CheckBox Content="Rester connecté automatiquement" IsChecked="{Binding StayConnected}" />
                        <CheckBox Content="Descriptions complémentaires (accessibilité)" IsChecked="{Binding ExtraDescriptions}" />
                    </StackPanel>
                </TabItem>
                <TabItem Header="Mises à jour">
                    <StackPanel Margin="8">
                        <TextBlock Text="{Binding CurrentVersion, StringFormat=Version actuelle : {0}}" Foreground="White" />
                        <TextBlock Text="{Binding UpdateStatus}" Foreground="{StaticResource HighlightBrush}" TextWrapping="Wrap" Margin="0 6 0 6" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Vérifier les mises à jour" Command="{Binding CheckUpdateCommand}" IsEnabled="{Binding CanCheckUpdates}" />
                            <Button Content="Installer la mise à jour" Command="{Binding InstallUpdateCommand}" IsEnabled="{Binding CanInstallUpdates}" />
                        </StackPanel>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24 0 24 20">
            <Button Content="Annuler" IsCancel="True" Command="{Binding CancelCommand}" />
            <Button Content="Enregistrer" IsDefault="True" Background="#2E8B57" Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
