<UserControl x:Class="client_win.Modules.Vault.Views.VaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280"
             Loaded="OnLoaded"
             PreviewKeyDown="OnPreviewKeyDown"
             AutomationProperties.Name="Mon coffre fort"
             AutomationProperties.HelpText="Mon coffre fort. Entrée: restaurer. Suppr: supprimer. Échap: fermer.">
    <Grid Background="#0F1D2D" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0 0 0 10">
            <TextBlock Text="Mon coffre fort" Foreground="White" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Sauvegardes de tables (Ctrl+S en partie)" Foreground="#9CB2D1" FontSize="14" Margin="0 6 0 0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#12263C" CornerRadius="8" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding Status}" Foreground="#7CA3D6" FontSize="13" Margin="0 0 0 10" TextWrapping="Wrap" />

                <ListBox Grid.Row="1"
                         x:Name="ItemsList"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding Selected}"
                         KeyboardNavigation.TabNavigation="Continue"
                         Background="#0D1A2B"
                         Foreground="White"
                         BorderBrush="#1E3A5C"
                         BorderThickness="1"
                         AutomationProperties.Name="Liste des sauvegardes">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayLabel}"
                                       FontSize="16"
                                       Margin="0 6 0 6"
                                       TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 10 0 0">
            <Button Content="Restaurer"
                    Margin="0 0 10 0"
                    Padding="12 8"
                    Command="{Binding RestoreCommand}"
                    AutomationProperties.Name="Restaurer (Entrée)" />
            <Button Content="Supprimer"
                    Margin="0 0 10 0"
                    Padding="12 8"
                    Command="{Binding DeleteCommand}"
                    AutomationProperties.Name="Supprimer (Suppr)" />
        </StackPanel>
    </Grid>
</UserControl>
