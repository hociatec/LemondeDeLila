<Window x:Class="client_win.Modules.TextPrompts.Views.ConfigPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        Background="#0B1526"
        Foreground="White"
        MinWidth="520"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}">

    <Window.Resources>
        <DataTemplate x:Key="TextFieldTemplate">
            <StackPanel Margin="0 0 0 10"
                        Focusable="False"
                        KeyboardNavigation.IsTabStop="False">
                <Label x:Name="FieldLabel"
                       Content="{Binding Label}"
                       Foreground="#C3D2EA"
                       Margin="0 0 0 4"
                       Focusable="False"
                       KeyboardNavigation.IsTabStop="False"
                       AutomationProperties.AccessKey="{x:Null}"
                       AutomationProperties.AutomationId="{x:Null}"/>
                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                         Background="#10223A"
                         Foreground="White"
                         BorderBrush="#284C75"
                         BorderThickness="1"
                         Padding="8"
                         MinWidth="420"
                         AutomationProperties.Name="{Binding Label}"
                         AutomationProperties.AutomationId="{Binding Key}"
                         AutomationProperties.LabeledBy="{x:Null}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="BoolFieldTemplate">
            <CheckBox Margin="0 0 0 10"
                      Content="{Binding Label}"
                      IsChecked="{Binding BoolValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Foreground="White"
                      AutomationProperties.Name="{Binding Label}"
                      AutomationProperties.AutomationId="{Binding Key}"/>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16"
          KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding Title}"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0 0 0 12"/>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False"
                      KeyboardNavigation.IsTabStop="False"
                      AutomationProperties.Name="Champs de configuration">
            <ItemsControl ItemsSource="{Binding Fields}"
                          Focusable="False"
                          KeyboardNavigation.IsTabStop="False"
                          KeyboardNavigation.TabNavigation="Continue">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="KeyboardNavigation.IsTabStop" Value="False"/>
                        <Setter Property="AutomationProperties.AutomationId" Value="{Binding Key}"/>
                        <!-- On ne définit PAS AutomationProperties.Name ici -->
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding}"
                                        Focusable="False"
                                        KeyboardNavigation.IsTabStop="False"
                                        AutomationProperties.Name="">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="ContentTemplate" Value="{StaticResource TextFieldTemplate}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBoolean}" Value="True">
                                            <Setter Property="ContentTemplate" Value="{StaticResource BoolFieldTemplate}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0 12 0 0">
            <Button Content="_Annuler"
                    Width="100"
                    Margin="0 0 10 0"
                    Click="OnCancelClick"/>
            <Button Content="_OK"
                    Width="100"
                    Click="OnOkClick"/>
        </StackPanel>
    </Grid>
</Window>
