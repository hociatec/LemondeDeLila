<Window x:Class="client_win.Modules.TextPrompts.Views.ConfigPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        Background="#0B1526"
        Foreground="White"
        MinWidth="520">
    <Window.Resources>
        <DataTemplate x:Key="TextFieldTemplate">
            <StackPanel Margin="0 0 0 10"
                        AutomationProperties.Name="{Binding Label}">
                <TextBlock x:Name="FieldLabel"
                           Text="{Binding Label}"
                           Foreground="#C3D2EA"
                           Margin="0 0 0 4"/>
                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                         Background="#10223A"
                         Foreground="White"
                         BorderBrush="#284C75"
                         BorderThickness="1"
                         Padding="8"
                         MinWidth="420"
                         AutomationProperties.Name="{Binding Label}"
                         AutomationProperties.LabeledBy="{Binding ElementName=FieldLabel}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="BoolFieldTemplate">
            <CheckBox Margin="0 0 0 10"
                      Content="{Binding Label}"
                      IsChecked="{Binding BoolValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Foreground="White"
                      AutomationProperties.Name="{Binding Label}"/>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding Title}"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0 0 0 12"/>

        <ItemsControl Grid.Row="1"
                      ItemsSource="{Binding Fields}"
                      AutomationProperties.Name="Champs de configuration">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ContentControl Content="{Binding}"
                                    AutomationProperties.Name="{Binding Label}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate" Value="{StaticResource TextFieldTemplate}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBoolean}" Value="True">
                                        <Setter Property="ContentTemplate" Value="{StaticResource BoolFieldTemplate}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0 12 0 0">
            <Button Content="Annuler"
                    Width="100"
                    Margin="0 0 10 0"
                    Click="OnCancelClick"/>
            <Button Content="OK"
                    Width="100"
                    IsDefault="True"
                    Click="OnOkClick"/>
        </StackPanel>
    </Grid>
</Window>
