<Window x:Class="client_win.Modules.TextPrompts.Views.ConfigPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        Background="#0B1526"
        Foreground="White"
        MinWidth="520"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0 0 0 5"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#10223A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#284C75"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="MinWidth" Value="420"/>
            <Setter Property="Margin" Value="0 0 0 10"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0 0 0 10"/>
        </Style>
        
        <!-- Template pour les champs texte -->
        <DataTemplate x:Key="TextFieldTemplate">
            <StackPanel>
                <TextBlock Text="{Binding Label}" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         AutomationProperties.Name="{Binding Label}"/>
            </StackPanel>
        </DataTemplate>
        
        <!-- Template pour les champs booléens -->
        <DataTemplate x:Key="BooleanFieldTemplate">
            <CheckBox Content="{Binding Label}"
                      IsChecked="{Binding BoolValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      AutomationProperties.Name="{Binding Label}"/>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titre -->
        <TextBlock Grid.Row="0"
                   Text="{Binding Title}"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0 0 0 12"
                   Style="{StaticResource LabelStyle}"
                   AutomationProperties.Name="{Binding Title}"/>

        <!-- Liste des champs -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Fields}"
                          Focusable="False"
                          AutomationProperties.Name="Champs de formulaire">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel IsItemsHost="True"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding}" Focusable="False">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTextField}" Value="True">
                                            <Setter Property="ContentTemplate" Value="{StaticResource TextFieldTemplate}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBooleanField}" Value="True">
                                            <Setter Property="ContentTemplate" Value="{StaticResource BooleanFieldTemplate}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Boutons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0 12 0 0">
            <Button Content="_Annuler"
                    Width="100"
                    Margin="0 0 10 0"
                    Click="OnCancelClick"
                    AutomationProperties.Name="Annuler"/>
            <Button Content="_OK"
                    Width="100"
                    Click="OnOkClick"
                    IsDefault="True"
                    AutomationProperties.Name="OK"/>
        </StackPanel>
    </Grid>
</Window>