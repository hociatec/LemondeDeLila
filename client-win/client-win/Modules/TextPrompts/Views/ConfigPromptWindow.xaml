<Window x:Class="client_win.Modules.TextPrompts.Views.ConfigPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        Background="#0B1526"
        Foreground="White"
        MinWidth="520"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titre -->
        <TextBlock Grid.Row="0"
                   Text="{Binding Title}"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0 0 0 12"
                   AutomationProperties.Name="{Binding Title}"/>

        <!-- Liste des champs -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      Focusable="True">
            <StackPanel>
                <!-- Ressources pour les styles -->
                <StackPanel.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Margin" Value="0 0 0 5"/>
                    </Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Background" Value="#10223A"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderBrush" Value="#284C75"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Padding" Value="8"/>
                        <Setter Property="MinWidth" Value="420"/>
                        <Setter Property="Margin" Value="0 0 0 10"/>
                    </Style>
                    <Style TargetType="CheckBox">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Margin" Value="0 0 0 10"/>
                    </Style>
                </StackPanel.Resources>

                <ItemsControl ItemsSource="{Binding Fields}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentControl>
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Style.Triggers>
                                            <!-- Si IsTextField est vrai, affiche le TextBox -->
                                            <DataTrigger Binding="{Binding IsTextField}" Value="True">
                                                <Setter Property="Content">
                                                    <Setter.Value>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Label}" 
                                                                       AutomationProperties.Name="{Binding Label}"/>
                                                            <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                     AutomationProperties.Name="{Binding Label}"/>
                                                        </StackPanel>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                            <!-- Si IsBooleanField est vrai, affiche le CheckBox -->
                                            <DataTrigger Binding="{Binding IsBooleanField}" Value="True">
                                                <Setter Property="Content">
                                                    <Setter.Value>
                                                        <CheckBox Content="{Binding Label}"
                                                                  IsChecked="{Binding BoolValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  AutomationProperties.Name="{Binding Label}"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Boutons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0 12 0 0">
            <Button Content="_Annuler"
                    Width="100"
                    Margin="0 0 10 0"
                    Click="OnCancelClick"
                    AutomationProperties.Name="Annuler"/>
            <Button Content="_OK"
                    Width="100"
                    Click="OnOkClick"
                    IsDefault="True"
                    AutomationProperties.Name="OK"/>
        </StackPanel>
    </Grid>
</Window>