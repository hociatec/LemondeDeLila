<Window x:Class="client_win.Modules.TextPrompts.Views.ConfigPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        Background="#0B1526"
        Foreground="White"
        MinWidth="520"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}">

    <!-- ================= RESSOURCES ================= -->
    <Window.Resources>

        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0 0 0 4"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#10223A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#284C75"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="MinWidth" Value="420"/>
            <Setter Property="Margin" Value="0 0 0 12"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0 0 0 12"/>
        </Style>

        <!-- Champ texte -->
        <DataTemplate x:Key="TextFieldTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="TextLabel"
                           Text="{Binding Label}"
                           Style="{StaticResource LabelStyle}"/>

                <TextBox Grid.Row="1"
                         Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         AutomationProperties.LabeledBy="{Binding ElementName=TextLabel}"/>
            </Grid>
        </DataTemplate>

        <!-- Champ booléen -->
        <DataTemplate x:Key="BooleanFieldTemplate">
            <CheckBox Content="{Binding Label}"
                      IsChecked="{Binding BoolValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      AutomationProperties.Name="{Binding Label}"/>
        </DataTemplate>

        <!-- Style ListBoxItem : PAS de sélection visible -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

    </Window.Resources>

    <!-- ================= LAYOUT ================= -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titre -->
        <TextBlock Grid.Row="0"
                   Text="{Binding Title}"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0 0 0 16"
                   AutomationProperties.Name="{Binding Title}"/>

        <!-- Formulaire -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">

            <ListBox ItemsSource="{Binding Fields}"
                     BorderThickness="0"
                     Background="Transparent"
                     KeyboardNavigation.TabNavigation="Continue">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <ContentPresenter>
                            <ContentPresenter.Style>
                                <Style TargetType="ContentPresenter">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTextField}" Value="True">
                                            <Setter Property="ContentTemplate"
                                                    Value="{StaticResource TextFieldTemplate}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBooleanField}" Value="True">
                                            <Setter Property="ContentTemplate"
                                                    Value="{StaticResource BooleanFieldTemplate}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentPresenter.Style>
                        </ContentPresenter>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>
        </ScrollViewer>

        <!-- Boutons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0 16 0 0">

            <Button Content="_Annuler"
                    Width="100"
                    Margin="0 0 10 0"
                    Click="OnCancelClick"
                    AutomationProperties.Name="Annuler"/>

            <Button Content="_OK"
                    Width="100"
                    Click="OnOkClick"
                    IsDefault="True"
                    AutomationProperties.Name="OK"/>
        </StackPanel>

    </Grid>
</Window>
