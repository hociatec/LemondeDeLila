<Window x:Class="client_win.Modules.TextPrompts.Views.ConfigPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        Background="#0B1526"
        Foreground="White"
        MinWidth="520"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}">

    <Grid Margin="16" KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titre -->
        <TextBlock Grid.Row="0"
                   Text="{Binding Title}"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0 0 0 12"
                   AutomationProperties.Name="{Binding Title}"/>

        <!-- Champs -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">

            <StackPanel>
                <!-- Liste des champs -->
                <ItemsControl ItemsSource="{Binding Fields}"
                              Focusable="False"
                              IsTabStop="False"
                              KeyboardNavigation.TabNavigation="Continue">

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0 0 0 10">
                                <!-- Champ texte -->
                                <StackPanel Visibility="{Binding IsBoolean, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}">
                                    <TextBlock Text="{Binding Label}"
                                               Foreground="White"
                                               AutomationProperties.Name="{Binding Label}"/>
                                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#10223A"
                                             Foreground="White"
                                             BorderBrush="#284C75"
                                             BorderThickness="1"
                                             Padding="8"
                                             MinWidth="420"
                                             AutomationProperties.LabeledBy="{Binding ElementName=textFieldLabel}"/>
                                </StackPanel>

                                <!-- Champ booléen -->
                                <CheckBox Visibility="{Binding IsBoolean, Converter={StaticResource BoolToVisibilityConverter}}"
                                          Content="{Binding Label}"
                                          IsChecked="{Binding BoolValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Foreground="White"
                                          AutomationProperties.Name="{Binding Label}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Boutons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0 12 0 0">
            <Button Content="_Annuler"
                    Width="100"
                    Margin="0 0 10 0"
                    Click="OnCancelClick"
                    AutomationProperties.Name="Annuler"/>
            <Button Content="_OK"
                    Width="100"
                    Click="OnOkClick"
                    IsDefault="True"
                    AutomationProperties.Name="OK"/>
        </StackPanel>
    </Grid>
</Window>
