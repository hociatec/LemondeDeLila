<Window x:Class="client_win.Modules.TextPrompts.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        MinWidth="520"
        Background="#0B1523"
        Foreground="White"
        Title="{Binding Title}"
        PreviewKeyDown="OnPreviewKeyDown">
    <Border Background="#12263C" CornerRadius="12" Padding="18" Margin="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding Label}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10" />

            <TextBox Grid.Row="1"
                     x:Name="InputBox"
                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                     MinWidth="460"
                     MinHeight="34"
                     Background="#0C1523"
                     Foreground="White"
                     BorderBrush="#284C75"
                     BorderThickness="1"
                     Padding="10"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="{Binding Label}" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Annuler" Width="110" Margin="0,0,8,0" Click="OnCancelClick" />
                <Button Content="Envoyer" Width="110" IsDefault="True" Click="OnOkClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

