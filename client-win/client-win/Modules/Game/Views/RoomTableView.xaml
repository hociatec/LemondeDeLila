<UserControl x:Class="client_win.Modules.Game.Views.RoomTableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded"
             PreviewKeyDown="OnPreviewKeyDown">
    <Grid Background="#0F1926">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#13263B" Padding="16">
            <StackPanel>
                <TextBlock Text="{Binding RoomName}" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="{Binding GameType, StringFormat=Jeu: {0}}"
                               Foreground="#9CB2D1" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding PrivacyLabel, StringFormat=Confidentialite: {0}}"
                               Foreground="#9CB2D1" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding RoleLabel, StringFormat=Role: {0}}"
                               Foreground="#9CB2D1"/>
                </StackPanel>
                <TextBlock Text="{Binding CountsLabel}" Foreground="#9CB2D1" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#101C2B" CornerRadius="10" Padding="12" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Historique de la table" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ListBox ItemsSource="{Binding History}" Background="#0B1523" Foreground="White" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="#101C2B" CornerRadius="10" Padding="12">
                <StackPanel>
                    <TextBlock Text="Actions" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Button Content="Basculer public/prive (Ctrl+H)" Command="{Binding TogglePrivacyCommand}" Height="36" Margin="0,0,0,8"/>
                    <Button Content="Basculer joueur/spectateur (Ctrl+C)" Command="{Binding ToggleRoleCommand}" Height="36" Margin="0,0,0,8"/>
                    <Button Content="Ajouter un bot (B)" Command="{Binding AddBotCommand}" Height="36" Margin="0,0,0,8"/>
                    <Button Content="Retirer un bot (Shift+B)" Command="{Binding RemoveBotCommand}" Height="36" Margin="0,0,0,8"/>
                    <Button Content="Lancer la partie (Enter)" Command="{Binding StartGameCommand}" Height="36" Margin="0,0,0,8"/>
                    <Button Content="Reinitialiser la partie (X)" Command="{Binding ResetGameCommand}" Height="36" Margin="0,0,0,8"/>
                    <Button Content="Quitter la table" Command="{Binding CloseCommand}" Height="36"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#0B1523" Padding="10">
            <TextBlock Text="{Binding Status}" Foreground="#F2C14E"/>
        </Border>
    </Grid>
</UserControl>
