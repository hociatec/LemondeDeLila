<UserControl x:Class="client_win.Modules.Game.Views.RoomTableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded"
             PreviewKeyDown="OnPreviewKeyDown">
    <Grid Background="#0F1926">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#13263B" Padding="16">
            <StackPanel>
                <TextBlock Text="{Binding RoomName}" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="{Binding GameType, StringFormat=Jeu: {0}}"
                               Foreground="#9CB2D1" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding PrivacyLabel, StringFormat=Confidentialite: {0}}"
                               Foreground="#9CB2D1" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding RoleLabel, StringFormat=Role: {0}}"
                               Foreground="#9CB2D1"/>
                </StackPanel>
                <TextBlock Text="{Binding CountsLabel}" Foreground="#9CB2D1" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#101C2B" CornerRadius="10" Padding="12" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Historique de la table" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ListBox x:Name="HistoryList"
                             ItemsSource="{Binding History}"
                             Background="#0B1523"
                             Foreground="White"
                             VirtualizingStackPanel.IsVirtualizing="False"
                             KeyboardNavigation.TabNavigation="None"
                             IsTabStop="True" />
                </StackPanel>
            </Border>
            <Border x:Name="GamePanel"
                    Grid.Column="1"
                    Background="#101C2B"
                    CornerRadius="10"
                    Padding="16"
                    Focusable="True"
                    KeyboardNavigation.TabNavigation="None"
                    IsTabStop="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="#0B1523" CornerRadius="10" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Panneau de table" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Tab : historique • Shift+Tab : retour (navigation circulaire)"
                                       Foreground="#9CB2D1" Margin="0,6,0,0"/>
                            <TextBlock Text="Q : quitter • Ctrl+H : public/privé • Ctrl+C : joueur/spectateur"
                                       Foreground="#9CB2D1" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Background="#0E1724" CornerRadius="10" Margin="0,12,0,0">
                        <Grid>
                            <TextBlock Text="Fenêtre de jeu (WIP)"
                                       Foreground="#9CB2D1"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="16"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#0B1523" Padding="10">
            <TextBlock Text="{Binding Status}" Foreground="#F2C14E"/>
        </Border>
    </Grid>
</UserControl>
