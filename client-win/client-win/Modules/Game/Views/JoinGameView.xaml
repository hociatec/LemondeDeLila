<UserControl x:Class="client_win.Modules.Game.Views.JoinGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
             Background="White"
             PreviewKeyDown="OnPreviewKeyDown">
    <UserControl.Resources>
        <CollectionViewSource x:Key="RoomsView" Source="{Binding Rooms}">
            <CollectionViewSource.SortDescriptions>
                <scm:SortDescription PropertyName="GameGroup" Direction="Ascending" />
            </CollectionViewSource.SortDescriptions>
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="GameGroup" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Tables publiques"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#0B1523"/>
            <TextBlock Text="{Binding Status}"
                       Margin="0,4,0,0"
                       FontSize="13"
                       Foreground="#4A4A4A"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <ListBox ItemsSource="{Binding Source={StaticResource RoomsView}}"
                     SelectedItem="{Binding SelectedRoom}"
                     KeyDown="OnRoomsKeyDown">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name, StringFormat='=== {0} ==='}"
                                           FontWeight="SemiBold"
                                           Margin="0,8,0,2"
                                           Foreground="#0B1523"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
            </ListBox>
            <TextBlock Text="Aucune table publique en cours."
                       FontSize="14"
                       Foreground="#4A4A4A"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Rooms.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Rejoindre"
                    Command="{Binding JoinCommand}"
                    Width="120"
                    Height="32"/>
            <Button Content="Fermer"
                    Command="{Binding CloseCommand}"
                    Width="120"
                    Height="32"
                    Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
