<UserControl x:Class="client_win.Modules.Game.RoomDirectory.Views.JoinGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1280"
             Loaded="OnLoaded"
             KeyDown="OnKeyDown"
             PreviewKeyDown="OnPreviewKeyDown"
             Focusable="True"
             AutomationProperties.Name="Rejoindre une partie">
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <SolidColorBrush x:Key="ShellBackground" Color="#0B111A" />
        <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0 4 0 4" />
                        <Setter Property="Padding" Value="10" />
                        <Setter Property="Background" Value="#10223A" />
                        <Setter Property="BorderBrush" Value="#1F3C60" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding A11yLabel}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1B3554" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#214570" />
                                            <Setter Property="BorderBrush" Value="{StaticResource HighlightBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource ShellBackground}" FocusManager.IsFocusScope="True" Focusable="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" Text="Rejoindre une partie" FontSize="28" FontWeight="SemiBold" Foreground="White" />
            <TextBlock Text="Tables publiques ouvertes (temps réel)" Foreground="#9CB2D1" FontSize="14" HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="12"
                Margin="24" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0 0 0 12">
                    <TextBlock Text="Tables disponibles" Foreground="White" FontSize="18" DockPanel.Dock="Left" />
                </DockPanel>

                <Grid Grid.Row="1">
                    <ListBox x:Name="RoomsList"
                             ItemsSource="{Binding Rooms}"
                             SelectedItem="{Binding SelectedRoom, Mode=TwoWay}"
                             SelectionMode="Single"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             ScrollViewer.CanContentScroll="True"
                             PreviewKeyDown="OnListPreviewKeyDown"
                             KeyDown="OnListKeyDown"
                             AutomationProperties.LabeledBy="{Binding ElementName=TitleText}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Vertical">
                                        <TextBlock Text="{Binding Name}" FontSize="16" Foreground="White" />
                                        <TextBlock Text="{Binding GameType}" Foreground="#9CB2D1" FontSize="12" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding OwnerUsername, TargetNullValue=—}" Foreground="#C6D6F0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Foreground="#C6D6F0"
                                               VerticalAlignment="Center"
                                               Text="{Binding Slots}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Border>

        <TextBlock x:Name="EmptyOnlyText"
                 Grid.Row="1"
                 Text="Aucune table à rejoindre."
                 Foreground="#C6D6F0"
                 FontSize="20"
                 FontWeight="SemiBold"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 TextAlignment="Center"
                 TextWrapping="Wrap"
                 Focusable="True"
                 Visibility="Collapsed"
                 AutomationProperties.Name="Aucune table à rejoindre"
                 AutomationProperties.HelpText="Aucune table publique disponible. Appuyez sur Échap pour revenir au menu."
                 AutomationProperties.LiveSetting="Polite">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Rooms.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Border Grid.Row="2" Background="#0C1523" Padding="12 8" Focusable="False"
                AutomationProperties.LiveSetting="Polite">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Rooms.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Status}"
                       Foreground="{StaticResource HighlightBrush}" FontSize="14"
                       TextWrapping="Wrap" HorizontalAlignment="Center" Focusable="False"
                       AutomationProperties.Name="Message de statut"
                       AutomationProperties.LiveSetting="Polite" />
        </Border>
    </Grid>
</UserControl>
