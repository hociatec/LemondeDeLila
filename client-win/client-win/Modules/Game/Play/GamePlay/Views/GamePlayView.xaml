<UserControl x:Class="client_win.Modules.Game.Play.GamePlay.Views.GamePlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shell="clr-namespace:client_win.Modules.Game.Shell.Views"
             xmlns:grid="clr-namespace:client_win.Modules.Game.Play.Grid.Views"
             mc:Ignorable="d"
             d:DesignHeight="320"
             d:DesignWidth="900"
             Focusable="True"
             IsTabStop="True"
             KeyboardNavigation.DirectionalNavigation="Contained"
             AutomationProperties.Name="{Binding DataContext.Title, RelativeSource={RelativeSource AncestorType=shell:GameZoneHostView}}"
             PreviewKeyDown="OnRootPreviewKeyDown"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!--
            Focus anchor: le gestionnaire Tab/Maj+Tab ramène souvent le focus sur le premier élément focusable.
            Sans nom d'automatisation, NVDA annonce "inconnu". Ici on force un nom basé sur le titre de la zone (nom du jeu).
        -->
        <TextBlock Grid.Row="0"
                   Text="{Binding ConnectionStatus}"
                   Foreground="#9CB2D1"
                   FontSize="12"
                   Margin="0 0 0 8"
                   AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.Name="{Binding ConnectionStatus}" />

        <TextBlock Grid.Row="1"
                   Text="{Binding StateSummary}"
                   Foreground="White"
                   FontSize="14"
                   TextWrapping="Wrap"
                   Margin="0 0 0 8" />

	        <Border Grid.Row="2"
	                Background="#0E1E34"
	                CornerRadius="8"
	                Padding="10"
	                Margin="0 0 0 10"
	                Visibility="{Binding Grid.IsVisible, Converter={StaticResource BoolToVis}}"
	                AutomationProperties.Name=""
	                x:Name="GridBoard"
	                KeyboardNavigation.DirectionalNavigation="Contained"
	                KeyboardNavigation.TabNavigation="Once"
	                PreviewKeyDown="OnGridPreviewKeyDown">
            <StackPanel>
                <TextBlock Text="Grille"
                           Foreground="#F2C14E"
                           FontSize="12"
                           Margin="0 0 0 6"/>
                <TextBlock Text="{Binding Grid.Status}"
                           Foreground="#9CB2D1"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0 0 0 8" />

	                <grid:GridCellsControl x:Name="GridItems"
                                  DataContext="{Binding Grid}"
	                              ItemsSource="{Binding Cells}"
	                              KeyboardNavigation.DirectionalNavigation="Contained"
	                              KeyboardNavigation.TabNavigation="Once"
	                              AutomationProperties.Name=""
	                              Loaded="OnGridLoaded">
	                    <!--
	                        Accessibilité NVDA (Corridor) :
	                        Le conteneur généré par ItemsControl peut être annoncé comme "élément de donnée" avec le nom par défaut
	                        (ToString du ViewModel). On force un libellé humain et un type localisé pour éviter le bruit.
	                    -->
		                    <ItemsControl.ItemContainerStyle>
		                        <Style TargetType="grid:A11yGridCell">
		                            <!--
		                                NVDA annonce parfois le ContentPresenter comme "élément de donnée X sur N" (et duplique le nom),
		                                même quand la cellule (Button) a déjà un AutomationProperties.Name.
		                                On force un type localisé vide et on désactive l'annonce "X sur N" pour ne garder que la cellule (Button).
		                            -->
		                            <Setter Property="AutomationProperties.Name" Value=" " />
		                            <Setter Property="AutomationProperties.HelpText" Value="" />
		                            <Setter Property="AutomationProperties.ItemType" Value="" />
		                            <Setter Property="AutomationProperties.ItemStatus" Value="" />
		                            <Setter Property="AutomationProperties.PositionInSet" Value="-1" />
		                            <Setter Property="AutomationProperties.SizeOfSet" Value="-1" />
		                        </Style>
		                    </ItemsControl.ItemContainerStyle>
	                    <ItemsControl.ItemsPanel>
	                        <ItemsPanelTemplate>
	                            <UniformGrid Columns="{Binding Size}" />
	                        </ItemsPanelTemplate>
	                    </ItemsControl.ItemsPanel>
	                    <ItemsControl.ItemTemplate>
	                        <DataTemplate>
	                            <grid:A11yGridCell Content="{Binding Display}"
	                                               FontSize="16"
	                                               FontWeight="SemiBold"
	                                               Width="34"
	                                               Height="34"
	                                               Padding="0"
	                                               Margin="1"
	                                               Background="#10223A"
	                                               BorderBrush="#284C75"
	                                               BorderThickness="{Binding CellBorderThickness}"
	                                               Foreground="White"
	                                               FocusVisualStyle="{x:Null}"
	                                               AutomationProperties.Name="{Binding AccessibleName}"
	                                               AutomationProperties.HelpText=""
	                                               Command="{Binding DataContext.CellCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
	                                               CommandParameter="{Binding}">
	                                <grid:A11yGridCell.Style>
	                                    <Style TargetType="grid:A11yGridCell">
	                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanPlaceWallH}" Value="True">
                                                <Setter Property="Background" Value="#1B3554" />
                                                <Setter Property="BorderBrush" Value="#F2C14E" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CanPlaceWallV}" Value="True">
                                                <Setter Property="Background" Value="#1B3554" />
                                                <Setter Property="BorderBrush" Value="#F2C14E" />
                                            </DataTrigger>
	                                            <Trigger Property="IsKeyboardFocused" Value="True">
	                                                <Setter Property="BorderBrush" Value="#F2C14E" />
	                                            </Trigger>
	                                        </Style.Triggers>
	                                    </Style>
	                                </grid:A11yGridCell.Style>
	                            </grid:A11yGridCell>
	                        </DataTemplate>
	                    </ItemsControl.ItemTemplate>
	                </grid:GridCellsControl>
            </StackPanel>
        </Border>

        <Border Grid.Row="3"
                Background="#10223A"
                CornerRadius="8"
                Padding="10"
                Margin="0 0 0 10"
                Visibility="{Binding ShowLegacyActionsPanel, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="{Binding BoardText}"
                           Foreground="#C3D2EA"
                           FontFamily="Consolas"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0 0 0 10">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsQuizPending}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding BoardText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding BoardText}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="Actions disponibles (serveur)"
                           Foreground="#F2C14E"
                           FontSize="12"
                           Margin="0 0 0 6">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsQuizPending}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding ActionsText}"
                           Foreground="#C3D2EA"
                           FontFamily="Consolas"
                           FontSize="12"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsQuizPending}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ActionsText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ActionsText}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding PendingText}"
                           Foreground="#C3D2EA"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0 8 0 0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsQuizPending}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PendingText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PendingText}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!--
                    Label d'accessibilité pour la liste de choix : NVDA utilise parfois LabeledBy (plus fiable que Name).
                    Le texte vient du serveur (pending.label) et change selon la situation.
                -->
                <TextBlock x:Name="ChoicesLabelText"
                           Text="{Binding ChoicesLabel}"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Margin="0 10 0 0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PendingChoices.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ChoicesLabel}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ChoicesLabel}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ListBox x:Name="ChoicesList"
                         ItemsSource="{Binding PendingChoices}"
                         SelectedIndex="{Binding SelectedChoiceIndex, Mode=TwoWay}"
                         KeyDown="OnChoicesKeyDown"
                         PreviewKeyDown="OnChoicesPreviewKeyDown"
                         Margin="0 8 0 0"
                         Background="Transparent"
                         BorderThickness="1"
                         BorderBrush="#284C75"
                         Foreground="White"
                         FontSize="12"
                         MaxHeight="160"
                         AutomationProperties.Name="{Binding ChoicesLabel}"
                         AutomationProperties.LabeledBy="{Binding ElementName=ChoicesLabelText}">
                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PendingChoices.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                </ListBox>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
