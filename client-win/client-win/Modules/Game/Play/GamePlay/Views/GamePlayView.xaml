<UserControl x:Class="client_win.Modules.Game.Play.GamePlay.Views.GamePlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shell="clr-namespace:client_win.Modules.Game.Shell.Views"
             xmlns:grid="clr-namespace:client_win.Modules.Game.Play.Grid.Views"
             mc:Ignorable="d"
             d:DesignHeight="320"
             d:DesignWidth="900"
              Focusable="True"
              IsTabStop="True"
              KeyboardNavigation.DirectionalNavigation="Contained"
              AutomationProperties.Name="Zone de jeu"
              PreviewKeyDown="OnRootPreviewKeyDown"
              Loaded="OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!--
            Focus anchor: le gestionnaire Tab/Maj+Tab ramène souvent le focus sur le premier élément focusable.
            Sans nom d'automatisation, NVDA annonce "inconnu". Ici on force un nom générique
            pour éviter de répéter le nom du jeu après certaines actions.
        -->
        <TextBlock Grid.Row="0"
                   Text="{Binding ConnectionStatus}"
                   Foreground="#9CB2D1"
                   FontSize="12"
                   Margin="0 0 0 8"
                   AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.Name="{Binding ConnectionStatus}" />

        <TextBlock Grid.Row="1"
                   Text="{Binding StateSummary}"
                   Foreground="White"
                   FontSize="14"
                   TextWrapping="Wrap"
                   Margin="0 0 0 8" />

	        <Border Grid.Row="2"
	                Background="#0E1E34"
	                CornerRadius="8"
	                Padding="10"
	                Margin="0 0 0 10"
	                Visibility="{Binding Grid.IsVisible, Converter={StaticResource BoolToVis}}"
	                AutomationProperties.Name=""
	                x:Name="GridBoard"
	                KeyboardNavigation.DirectionalNavigation="Contained"
	                KeyboardNavigation.TabNavigation="Once"
	                PreviewKeyDown="OnGridPreviewKeyDown">
            <StackPanel>
                <TextBlock Text="Grille"
                           Foreground="#F2C14E"
                           FontSize="12"
                           Margin="0 0 0 6"/>
                <TextBlock Text="{Binding Grid.Status}"
                           Foreground="#9CB2D1"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0 0 0 8" />

	                <grid:GridCellsControl x:Name="GridItems"
                                  DataContext="{Binding Grid}"
	                              ItemsSource="{Binding Cells}"
	                              KeyboardNavigation.DirectionalNavigation="Contained"
	                              KeyboardNavigation.TabNavigation="Once"
	                              AutomationProperties.Name=""
	                              Loaded="OnGridLoaded">
	                    <!--
	                        Accessibilité NVDA (Corridor) :
	                        Le conteneur généré par ItemsControl peut être annoncé comme "élément de donnée" avec le nom par défaut
	                        (ToString du ViewModel). On force un libellé humain et un type localisé pour éviter le bruit.
	                    -->
		                    <ItemsControl.ItemContainerStyle>
		                        <Style TargetType="grid:A11yGridCell">
		                            <!--
		                                NVDA annonce parfois le ContentPresenter comme "élément de donnée X sur N" (et duplique le nom),
		                                même quand la cellule (Button) a déjà un AutomationProperties.Name.
		                                On force un type localisé vide et on désactive l'annonce "X sur N" pour ne garder que la cellule (Button).
		                            -->
		                            <Setter Property="AutomationProperties.Name" Value="" />
		                            <Setter Property="AutomationProperties.HelpText" Value="" />
		                            <Setter Property="AutomationProperties.ItemType" Value="" />
		                            <Setter Property="AutomationProperties.ItemStatus" Value="" />
		                            <Setter Property="AutomationProperties.PositionInSet" Value="-1" />
		                            <Setter Property="AutomationProperties.SizeOfSet" Value="-1" />
		                        </Style>
		                    </ItemsControl.ItemContainerStyle>
	                    <ItemsControl.ItemsPanel>
	                        <ItemsPanelTemplate>
	                            <UniformGrid Columns="{Binding Size}" />
	                        </ItemsPanelTemplate>
	                    </ItemsControl.ItemsPanel>
	                    <ItemsControl.ItemTemplate>
	                        <DataTemplate>
	                            <grid:A11yGridCell Content="{Binding Display}"
	                                               FontSize="16"
	                                               FontWeight="SemiBold"
	                                               Width="34"
	                                               Height="34"
	                                               Padding="0"
	                                               Margin="1"
	                                               Background="#10223A"
	                                               BorderBrush="#284C75"
	                                               BorderThickness="{Binding CellBorderThickness}"
	                                               Foreground="White"
	                                               FocusVisualStyle="{x:Null}"
	                                               AutomationProperties.Name="{Binding AccessibleName}"
	                                               AutomationProperties.HelpText=""
	                                               Command="{Binding DataContext.CellCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
	                                               CommandParameter="{Binding}">
	                                <grid:A11yGridCell.Style>
	                                    <Style TargetType="grid:A11yGridCell">
	                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanPlaceWallH}" Value="True">
                                                <Setter Property="Background" Value="#1B3554" />
                                                <Setter Property="BorderBrush" Value="#F2C14E" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CanPlaceWallV}" Value="True">
                                                <Setter Property="Background" Value="#1B3554" />
                                                <Setter Property="BorderBrush" Value="#F2C14E" />
                                            </DataTrigger>
	                                            <Trigger Property="IsKeyboardFocused" Value="True">
	                                                <Setter Property="BorderBrush" Value="#F2C14E" />
	                                            </Trigger>
	                                        </Style.Triggers>
	                                    </Style>
	                                </grid:A11yGridCell.Style>
	                            </grid:A11yGridCell>
	                        </DataTemplate>
	                    </ItemsControl.ItemTemplate>
	                </grid:GridCellsControl>
            </StackPanel>
        </Border>

        <Border Grid.Row="3"
                Background="#10223A"
                CornerRadius="8"
                Padding="10"
                Margin="0 0 0 10"
                Visibility="{Binding ShowLegacyActionsPanel, Converter={StaticResource BoolToVis}}">
            <!-- Scroll to keep the hand visible on narrow/vertical layouts. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                <TextBlock Text="{Binding BoardText}"
                           Foreground="#C3D2EA"
                           FontFamily="Consolas"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0 0 0 10">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsQuizPending}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding BoardText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding BoardText}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="Actions disponibles (serveur)"
                           Foreground="#F2C14E"
                           FontSize="12"
                           Margin="0 0 0 6">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsQuizPending}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding ActionsText}"
                           Foreground="#C3D2EA"
                           FontFamily="Consolas"
                           FontSize="12"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsQuizPending}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ActionsText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ActionsText}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding PendingText}"
                           Foreground="#C3D2EA"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0 8 0 0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsQuizPending}" Value="True">
                                    <Setter Property="FontSize" Value="16"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PendingText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PendingText}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Margin="0 8 0 0"
                            Visibility="{Binding HasHand, Converter={StaticResource BoolToVis}}">
                    <TextBlock x:Name="HandLabelText"
                               Text="Main"
                               Foreground="#F2C14E"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0 0 0 2" />
                    <TextBlock Text="{Binding HandStageLabel}"
                               Foreground="#9CB2D1"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0 0 0 2">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HandStageLabel}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HandStageLabel}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding HandWaitingLabel}"
                               Foreground="#C3D2EA"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0 0 0 2">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HandWaitingLabel}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HandWaitingLabel}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ListBox x:Name="HandList"
                             ItemsSource="{Binding HandCards}"
                             SelectedIndex="{Binding SelectedHandIndex, Mode=TwoWay}"
                             PreviewKeyDown="OnChoicesPreviewKeyDown"
                             Background="Transparent"
                             BorderThickness="1"
                             BorderBrush="#284C75"
                             Foreground="White"
                             FontSize="12"
                             MaxHeight="160"
                             Margin="0 0 0 4"
                             AutomationProperties.Name="">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Family}"
                                                   Foreground="#7EA3C7"
                                                   FontSize="11"
                                                   Margin="8 0 0 0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Family}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Family}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Color}"
                                               Foreground="#7EA3C7"
                                               FontSize="11"
                                               Margin="8 0 0 0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0 4 0 4" />
                                <Setter Property="Padding" Value="10" />
                                <Setter Property="Background" Value="#10223A" />
                                <Setter Property="BorderBrush" Value="#1F3C60" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Disabled}" Value="True">
                                        <Setter Property="Opacity" Value="0.35" />
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1B3554" />
                                        <Setter Property="BorderBrush" Value="#F2C14E" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#214570" />
                                        <Setter Property="BorderBrush" Value="{StaticResource HighlightBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </StackPanel>
                <!--
                    Label d'accessibilité pour la liste de choix : NVDA utilise parfois LabeledBy (plus fiable que Name).
                    Le texte vient du serveur (pending.label) et change selon la situation.
                -->
                <TextBlock x:Name="ChoicesLabelText"
                           Text="{Binding ChoicesLabel}"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Margin="0 10 0 0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DisplayChoices.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ChoicesLabel}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ChoicesLabel}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ListBox x:Name="ChoicesList"
                         ItemsSource="{Binding DisplayChoices}"
                         SelectedIndex="{Binding SelectedDisplayIndex, Mode=TwoWay}"
                         KeyDown="OnChoicesKeyDown"
                         PreviewKeyDown="OnChoicesPreviewKeyDown"
                         Margin="0 8 0 0"
                         Background="Transparent"
                         BorderThickness="1"
                         BorderBrush="#284C75"
                         Foreground="White"
                         FontSize="12"
                         MaxHeight="160"
                         AutomationProperties.Name="{Binding ChoicesA11yName}"
                         AutomationProperties.LabeledBy="{Binding ElementName=ChoicesLabelText}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0 4 0 4" />
                            <Setter Property="Padding" Value="10" />
                            <Setter Property="Background" Value="#10223A" />
                            <Setter Property="BorderBrush" Value="#1F3C60" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding Text}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1B3554" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#214570" />
                                                <Setter Property="BorderBrush" Value="{StaticResource HighlightBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.Style>
                        <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DisplayChoices.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                </ListBox>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Prompt inline (remplace les fenêtres modales de configuration/saisie) -->
        <Border x:Name="InlinePromptOverlay"
                Grid.RowSpan="4"
                Background="#80000000"
                Visibility="{Binding HasInlinePrompt, Converter={StaticResource BoolToVis}}"
                Focusable="True"
                FocusManager.IsFocusScope="True"
                KeyboardNavigation.TabNavigation="Cycle"
                KeyboardNavigation.DirectionalNavigation="Contained"
                PreviewKeyDown="OnInlinePromptPreviewKeyDown">
            <Border Background="#0E1E34"
                    BorderBrush="#284C75"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14"
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="680"
                    AutomationProperties.Name="{Binding InlinePromptTitle}">
                <StackPanel>
                    <TextBlock Text="{Binding InlinePromptTitle}"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />

                    <ItemsControl ItemsSource="{Binding InlinePromptFields}" Margin="0 10 0 0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0 6 0 0">
                                    <TextBlock x:Name="InlinePromptFieldLabel"
                                               Text="{Binding Label}"
                                               Foreground="#9CB2D1"
                                               FontSize="12"
                                               TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBool}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBox x:Name="InlinePromptTextBox"
                                             Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0 4 0 0"
                                             Foreground="White"
                                             Background="#10223A"
                                             BorderBrush="#1F3C60"
                                             BorderThickness="1"
                                             Padding="8"
                                             AutomationProperties.Name="{Binding Label}"
                                             AutomationProperties.LabeledBy="{Binding ElementName=InlinePromptFieldLabel}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBool}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>

                                    <CheckBox x:Name="InlinePromptCheckBox"
                                              IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                              Content="{Binding Label}"
                                              Margin="0 4 0 0"
                                              Foreground="White"
                                              AutomationProperties.Name="{Binding Label}">
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBool}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0 12 0 0">
                        <Button Content="Annuler (Échap)"
                                Click="OnInlinePromptCancelClick"
                                Margin="0 0 10 0"
                                Padding="10 6" />
                        <Button Content="Valider (Entrée)"
                                Click="OnInlinePromptSubmitClick"
                                Padding="10 6" />
                    </StackPanel>
                </StackPanel>
        </Border>
        </Border>

    </Grid>
</UserControl>
