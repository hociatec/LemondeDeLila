<UserControl x:Class="client_win.Modules.Game.Play.Views.GamePlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shell="clr-namespace:client_win.Modules.Game.Shell.Views"
             mc:Ignorable="d"
             d:DesignHeight="320"
             d:DesignWidth="900"
             Focusable="True"
             IsTabStop="True"
             AutomationProperties.Name="{Binding DataContext.Title, RelativeSource={RelativeSource AncestorType=shell:GameZoneHostView}}"
             Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!--
            Focus anchor: le gestionnaire Tab/Maj+Tab ramène souvent le focus sur le premier élément focusable.
            Sans nom d'automatisation, NVDA annonce "inconnu". Ici on force un nom basé sur le titre de la zone (nom du jeu).
        -->
        <TextBlock Grid.Row="0"
                   Text="{Binding ConnectionStatus}"
                   Foreground="#9CB2D1"
                   FontSize="12"
                   Margin="0 0 0 8"
                   AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.Name="{Binding ConnectionStatus}" />

        <TextBlock Grid.Row="1"
                   Text="{Binding StateSummary}"
                   Foreground="White"
                   FontSize="14"
                   TextWrapping="Wrap"
                   Margin="0 0 0 8" />

        <Border Grid.Row="2"
                Background="#10223A"
                CornerRadius="8"
                Padding="10"
                Margin="0 0 0 10">
            <StackPanel>
                <TextBlock Text="Actions disponibles (serveur)"
                           Foreground="#F2C14E"
                           FontSize="12"
                           Margin="0 0 0 6"/>
                <TextBlock Text="{Binding ActionsText}"
                           Foreground="#C3D2EA"
                           FontFamily="Consolas"
                           FontSize="12"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding PendingText}"
                           Foreground="#C3D2EA"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0 8 0 0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PendingText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PendingText}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!--
                    Label d'accessibilité pour la liste de choix : NVDA utilise parfois LabeledBy (plus fiable que Name).
                    Le texte vient du serveur (pending.label) et change selon la situation.
                -->
                <TextBlock x:Name="ChoicesLabelText"
                           Text="{Binding ChoicesLabel}"
                           Visibility="Collapsed" />
                <ListBox x:Name="ChoicesList"
                         ItemsSource="{Binding PendingChoices}"
                         SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                         KeyDown="OnChoicesKeyDown"
                         Margin="0 10 0 0"
                         Background="Transparent"
                         BorderThickness="1"
                         BorderBrush="#284C75"
                         Foreground="White"
                         FontSize="12"
                         MaxHeight="160"
                         AutomationProperties.Name="{Binding ChoicesLabel}"
                         AutomationProperties.LabeledBy="{Binding ElementName=ChoicesLabelText}">
                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PendingChoices.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                </ListBox>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
