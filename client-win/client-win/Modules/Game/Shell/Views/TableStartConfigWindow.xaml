<Window x:Class="client_win.Modules.Game.Shell.Views.TableStartConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuration de la table"
        Width="760"
        Height="620"
        Background="#0F1D2D"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding StepTitle}"
                   Foreground="White"
                   FontSize="18"
                   Margin="0 0 0 8" />

        <TextBlock Grid.Row="1"
                   Text="{Binding StepDescription}"
                   Foreground="#C3D2EA"
                   TextWrapping="Wrap"
                   Margin="0 0 0 12" />

        <Grid Grid.Row="2">
            <Border Background="#12263C"
                    CornerRadius="8"
                    Padding="10"
                    Visibility="{Binding IsAmbienceStep, Converter={StaticResource BoolToVis}}">
                <ListBox x:Name="ChoicesList"
                         ItemsSource="{Binding Choices}"
                         SelectedItem="{Binding SelectedChoice}"
                         DisplayMemberPath="Label"
                         PreviewKeyDown="OnChoicesListPreviewKeyDown"
                         SelectionChanged="OnChoicesListSelectionChanged"
                         LostKeyboardFocus="OnChoicesListLostKeyboardFocus"
                         Background="#12263C"
                         BorderThickness="0"
                         Foreground="#C3D2EA"
                         FontSize="13"
                         AutomationProperties.Name="Ambiance de table" />
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsGameConfigStep, Converter={StaticResource BoolToVis}}">
                <StackPanel x:Name="ConfigFieldsHost" />
            </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0 12 0 0">
            <Button x:Name="PreviousButton"
                    Content="Précédent"
                    Width="120"
                    Height="32"
                    Margin="0 0 8 0"
                    Click="OnPreviousClicked" />
            <Button x:Name="NextButton"
                    Content="Suivant"
                    Width="120"
                    Height="32"
                    Margin="0 0 8 0"
                    Click="OnNextClicked" />
            <Button Content="Annuler"
                    Width="120"
                    Height="32"
                    Margin="0 0 8 0"
                    Click="OnCancelClicked"
                    IsCancel="True" />
            <Button x:Name="StartButton"
                    Content="Démarrer"
                    Width="140"
                    Height="32"
                    Click="OnStartClicked"
                    IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
