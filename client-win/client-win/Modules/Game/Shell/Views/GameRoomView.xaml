<UserControl x:Class="client_win.Modules.Game.Shell.Views.GameRoomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:history="clr-namespace:client_win.Modules.Game.History.Views"
             xmlns:behaviors="clr-namespace:client_win.Behaviors"
             xmlns:room="clr-namespace:client_win.Modules.Game.Shell.Views"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1280">
    <Grid x:Name="Root"
          Background="#0F1D2D"
          Loaded="OnLoaded"
          PreviewKeyDown="OnPreviewKeyDown"
          behaviors:ShortcutBindingsBehavior.Shortcuts="{Binding GameZone.Shortcuts}"
          KeyboardNavigation.TabNavigation="Continue"
          KeyboardNavigation.ControlTabNavigation="Continue">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <room:GameRoomHeaderView Grid.Row="0" />

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#12263C"
                    CornerRadius="12"
                    Padding="20"
                    Focusable="False"
                    AutomationProperties.Name="Salle de jeu"
                    AutomationProperties.HelpText="Panneau Salle de jeu. Contient la zone de jeu et ses informations.">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Salle"
                               Foreground="White"
                               FontSize="18"
                               Margin="0 0 0 12" />

                    <StackPanel Grid.Row="1">
                        <TextBlock Text="{Binding Game.Summary}"
                                   TextWrapping="Wrap"
                                   Foreground="#C3D2EA"
                                   FontSize="14"
                                   Margin="0 0 0 12" />

                        <StackPanel Orientation="Horizontal" Margin="0 0 0 16">
                            <TextBlock Text="{Binding Game.Engine, StringFormat='Moteur : {0}'}" Foreground="#9CB2D1" FontSize="12" Margin="0 0 12 0" />
                            <TextBlock Text="{Binding Game.MinPlayers, StringFormat='Min {0} joueurs'}" Foreground="#9CB2D1" FontSize="12" Margin="0 0 12 0" />
                            <TextBlock Text="{Binding Game.MaxPlayers, StringFormat='Max {0} joueurs'}" Foreground="#9CB2D1" FontSize="12" />
                        </StackPanel>

                        <room:GameZoneHostView x:Name="GameZoneHost"
                                               DataContext="{Binding GameZone}" />
                    </StackPanel>
                </Grid>
            </Border>

            <history:GameHistoryView x:Name="HistoryHost"
                                     Grid.Column="1"
                                     DataContext="{Binding History}"
                                     IsTabStop="False"
                                     Margin="16 0 0 0" />
        </Grid>

        <room:GameRoomStatusBarView Grid.Row="2" />
    </Grid>
</UserControl>
