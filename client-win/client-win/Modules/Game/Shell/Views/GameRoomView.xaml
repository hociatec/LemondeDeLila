<UserControl x:Class="client_win.Modules.Game.Shell.Views.GameRoomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:history="clr-namespace:client_win.Modules.Game.History.Views"
             xmlns:behaviors="clr-namespace:client_win.Behaviors"
             xmlns:room="clr-namespace:client_win.Modules.Game.Shell.Views"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1280">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid x:Name="Root"
          Background="#0F1D2D"
          Loaded="OnLoaded"
          behaviors:ShortcutBindingsBehavior.Shortcuts="{Binding GameZone.Shortcuts}"
          behaviors:ShortcutBindingsBehavior.RefocusAfterExecute="False"
          KeyboardNavigation.TabNavigation="Cycle"
          KeyboardNavigation.ControlTabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <room:GameRoomHeaderView Grid.Row="0" />

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#12263C"
                    CornerRadius="12"
                    Padding="20"
                    Focusable="False"
                    AutomationProperties.Name="Salle de jeu"
                    AutomationProperties.HelpText="Panneau Salle de jeu. Contient la zone de jeu et ses informations.">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Salle"
                               Foreground="White"
                               FontSize="18"
                               Margin="0 0 0 12" />

                    <StackPanel Grid.Row="1">
                        <TextBlock Text="{Binding Game.Summary}"
                                   TextWrapping="Wrap"
                                   Foreground="#C3D2EA"
                                   FontSize="14"
                                   Margin="0 0 0 12" />

                        <StackPanel Orientation="Horizontal" Margin="0 0 0 16">
                            <TextBlock Text="{Binding Game.Engine, StringFormat='Moteur : {0}'}" Foreground="#9CB2D1" FontSize="12" Margin="0 0 12 0" />
                            <TextBlock Text="{Binding Game.MinPlayers, StringFormat='Min {0} joueurs'}" Foreground="#9CB2D1" FontSize="12" Margin="0 0 12 0" />
                            <TextBlock Text="{Binding Game.MaxPlayers, StringFormat='Max {0} joueurs'}" Foreground="#9CB2D1" FontSize="12" />
                        </StackPanel>

                        <room:GameZoneHostView x:Name="GameZoneHost"
                                               DataContext="{Binding GameZone}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="16 0 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="ChatHost"
                        Background="#12263C"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0 0 0 12"
                        Visibility="{Binding Chat.IsEnabled, Converter={StaticResource BoolToVis}}"
                        AutomationProperties.Name="Chat de la table"
                        AutomationProperties.HelpText="Zone de saisie du chat. Entree pour envoyer.">
                    <StackPanel>
                        <TextBlock Text="Chat"
                                   Foreground="White"
                                   FontSize="16"
                                   Margin="0 0 0 8" />

                        <TextBox x:Name="ChatInput"
                                 Text="{Binding Chat.Message, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding Chat.IsConnected}"
                                 Background="#0D1625"
                                 BorderThickness="0"
                                 Foreground="#C3D2EA"
                                 FontFamily="Segoe UI"
                                 FontSize="13"
                                 AcceptsReturn="False"
                                 TextWrapping="NoWrap"
                                 PreviewKeyDown="OnChatInputPreviewKeyDown"
                                 AutomationProperties.Name="Message"
                                 AutomationProperties.HelpText="Saisissez un message puis appuyez sur Entree." />
                    </StackPanel>
                </Border>

                <history:GameHistoryView x:Name="HistoryHost"
                                         Grid.Row="1"
                                         DataContext="{Binding History}" />
            </Grid>
        </Grid>

        <room:GameRoomStatusBarView Grid.Row="2" />

        <Border x:Name="StartWizardOverlay"
                Grid.RowSpan="3"
                Background="#80000000"
                Visibility="{Binding IsStartWizardOpen, Converter={StaticResource BoolToVis}}"
                KeyboardNavigation.TabNavigation="Cycle"
                KeyboardNavigation.DirectionalNavigation="Contained">
            <Border Background="#0E1E34"
                    BorderBrush="#284C75"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14"
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="760">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding StartWizardTitle}"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold" />

                    <TextBlock Grid.Row="1"
                               Text="{Binding StartWizardDescription}"
                               Foreground="#C3D2EA"
                               Margin="0 8 0 10"
                               TextWrapping="Wrap" />

                    <Grid Grid.Row="2">
                        <Border Background="#12263C"
                                CornerRadius="8"
                                Padding="10"
                                Visibility="{Binding IsStartWizardAmbienceStep, Converter={StaticResource BoolToVis}}">
                            <ListBox x:Name="StartWizardChoicesList"
                                     ItemsSource="{Binding StartWizardAmbienceChoices}"

                                     SelectedItem="{Binding StartWizardSelectedAmbience}"
                                     IsTabStop="False"
                                     KeyboardNavigation.TabNavigation="None"
                                     VirtualizingStackPanel.IsVirtualizing="False"
                                     Background="#12263C"
                                     BorderThickness="0"
                                     Foreground="#C3D2EA"
                                     FontSize="13">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding IsStartWizardConfigStep, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock x:Name="StartWizardConfigLoadingText"
                                           Text="Chargement de la configuration..."
                                           Foreground="#C3D2EA"
                                           Margin="0 0 0 10"
                                           Focusable="True"
                                           KeyboardNavigation.IsTabStop="True"
                                           Visibility="{Binding IsStartWizardConfigLoading, Converter={StaticResource BoolToVis}}" />

                                <TextBlock Text="Aucune configuration requise."
                                           Foreground="#C3D2EA"
                                           Margin="0 0 0 10">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStartWizardConfigLoading}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasStartWizardConfig}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <ItemsControl x:Name="StartWizardConfigItems"
                                              ItemsSource="{Binding StartWizardConfigFields}"
                                              Focusable="False"
                                              IsTabStop="False"
                                              KeyboardNavigation.IsTabStop="False"
                                              KeyboardNavigation.TabNavigation="None">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStartWizardConfigLoading}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0 6 0 6">
                                                <TextBlock x:Name="StartWizardConfigFieldLabel"
                                                           Text="{Binding Label}"
                                                           Foreground="White"
                                                           Margin="0 0 0 4">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBool}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         MinWidth="560"
                                                         AutomationProperties.Name="{Binding Label}"
                                                         AutomationProperties.LabeledBy="{Binding ElementName=StartWizardConfigFieldLabel}">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBool}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>

                                                <CheckBox Content="{Binding Label}"
                                                          Foreground="White"
                                                          IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                                          AutomationProperties.Name="{Binding Label}">
                                                    <CheckBox.Style>
                                                        <Style TargetType="CheckBox">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBool}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </CheckBox.Style>
                                                </CheckBox>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0 12 0 0">
                        <Button x:Name="StartWizardPreviousButton"
                                Content="Précédent"
                                Width="120"
                                Margin="0 0 8 0"
                                Click="OnStartWizardPreviousClick">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStartWizardConfigStep}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="StartWizardNextButton"
                                Content="Suivant"
                                Width="120"
                                Margin="0 0 8 0"
                                Click="OnStartWizardNextClick">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsStartWizardAmbienceStep}" Value="True" />
                                                <Condition Binding="{Binding HasStartWizardConfig}" Value="True" />
                                                <Condition Binding="{Binding IsStartWizardConfigLoading}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="StartWizardCancelButton"
                                Content="Annuler"
                                Width="120"
                                Margin="0 0 8 0"
                                Click="OnStartWizardCancelClick" />
                        <Button x:Name="StartWizardStartButton"
                                Content="Démarrer"
                                Width="140"
                                Click="OnStartWizardStartClick">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="IsEnabled" Value="True" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStartWizardConfigStep}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsStartWizardAmbienceStep}" Value="True" />
                                                <Condition Binding="{Binding HasStartWizardConfig}" Value="False" />
                                                <Condition Binding="{Binding IsStartWizardConfigLoading}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsStartWizardConfigStep}" Value="True" />
                                                <Condition Binding="{Binding IsStartWizardConfigLoading}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="IsEnabled" Value="False" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
