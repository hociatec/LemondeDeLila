<UserControl x:Class="client_win.Modules.Game.Shell.Views.GameZoneHostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:client_win.Modules.Game.Shell.Views"
             mc:Ignorable="d"
             d:DesignHeight="300"
             d:DesignWidth="600"
             Focusable="False"
             IsTabStop="False">
	    <Border Background="#0E1E34"
	            CornerRadius="10"
	            Padding="16"
	            Margin="0 0 0 12"
	            Focusable="False"
	            KeyboardNavigation.DirectionalNavigation="None"
	            AutomationProperties.Name="{Binding Title, FallbackValue=Zone de jeu, TargetNullValue=Zone de jeu}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="GameZoneTitle"
                       Text="{Binding Title}"
                       Foreground="White"
                       FontSize="16"
                       Margin="0 0 0 8" />

            <Grid Grid.Row="1">
                <!-- Ancre de focus permanente pour garder la navigation "dans la zone de jeu"
                     mÃªme si la surface de jeu n'a pas d'Ã©lÃ©ment focusable Ã  l'instant T. -->
			                <local:GameZoneFocusAnchor x:Name="GameZoneFocusAnchor"
                                           Focusable="True"
                                           KeyboardNavigation.TabIndex="0"
                                           Background="Transparent"
                                           BorderThickness="0"
                                           Padding="0"
                                           Opacity="0"
		                                           Width="1"
		                                           Height="1"
		                                           HorizontalAlignment="Left"
		                                           VerticalAlignment="Top"
			                                           AutomationProperties.Name="{Binding Title, FallbackValue=Zone de jeu, TargetNullValue=Zone de jeu}"
			                                           AutomationProperties.IsOffscreenBehavior="Onscreen"
			                                           GotKeyboardFocus="OnAnchorGotKeyboardFocus"
			                                           PreviewKeyDown="OnAnchorPreviewKeyDown">
                    <local:GameZoneFocusAnchor.Style>
                        <Style TargetType="{x:Type local:GameZoneFocusAnchor}">
                            <!-- Ancre interne uniquement: focus programmatique autorisé, pas de stop clavier Tab. -->
                            <Setter Property="IsTabStop" Value="False" />
                        </Style>
                    </local:GameZoneFocusAnchor.Style>
                </local:GameZoneFocusAnchor>

		                <local:GameZoneFocusAnchor x:Name="GameZoneEmptyAnchor"
                                           Focusable="True"
                                           KeyboardNavigation.TabIndex="0"
                                           Background="Transparent"
                                           BorderThickness="0"
	                                           Padding="0"
	                                           GotKeyboardFocus="OnAnchorGotKeyboardFocus"
	                                           PreviewKeyDown="OnAnchorPreviewKeyDown"
	                                           AutomationProperties.Name="{Binding Title, FallbackValue=Zone de jeu, TargetNullValue=Zone de jeu}"
	                                           AutomationProperties.IsOffscreenBehavior="Onscreen">
	                    <local:GameZoneFocusAnchor.Style>
	                        <Style TargetType="{x:Type local:GameZoneFocusAnchor}">
                            <Setter Property="IsTabStop" Value="False" />
	                            <Setter Property="Visibility" Value="Collapsed" />
	                            <Setter Property="IsHitTestVisible" Value="False" />
	                            <Setter Property="HorizontalAlignment" Value="Left" />
	                            <Setter Property="VerticalAlignment" Value="Top" />
                            <Setter Property="Width" Value="1" />
                            <Setter Property="Height" Value="1" />
                            <Setter Property="Opacity" Value="0" />
	                            <Style.Triggers>
	                                <DataTrigger Binding="{Binding Content}" Value="{x:Null}">
                                    <Setter Property="IsTabStop" Value="True" />
	                                    <Setter Property="Visibility" Value="Visible" />
	                                    <Setter Property="IsHitTestVisible" Value="True" />
	                                </DataTrigger>
	                                <DataTrigger Binding="{Binding IsStarted}" Value="False">
                                    <Setter Property="IsTabStop" Value="True" />
	                                    <Setter Property="Visibility" Value="Visible" />
	                                    <Setter Property="IsHitTestVisible" Value="True" />
	                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </local:GameZoneFocusAnchor.Style>
                </local:GameZoneFocusAnchor>

	                <ContentControl x:Name="GameZoneHost"
	                                Content="{Binding Content}"
	                                Focusable="False"
	                                IsTabStop="False"
	                                MinHeight="180"
	                                HorizontalContentAlignment="Stretch"
	                                VerticalContentAlignment="Stretch"
	                                AutomationProperties.Name="{Binding Title, FallbackValue=Zone de jeu, TargetNullValue=Zone de jeu}" />

                <!-- Placeholder visuel volontairement supprimÃ© (lecture d'Ã©cran: ne pas polluer le focus). -->
            </Grid>
        </Grid>
    </Border>
</UserControl>
