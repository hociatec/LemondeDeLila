<Window x:Class="client_win.Modules.Game.Shell.Views.TableAmbiencePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ambiance de table"
        Width="650"
        Height="520"
        Background="#0F1D2D"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Ambiance de table"
                   Foreground="White"
                   FontSize="18"
                   Margin="0 0 0 8" />

        <TextBlock Grid.Row="1"
                   Text="Choisissez une ambiance (boucle) pour cette table. Cela sera diffusé pendant la partie."
                   Foreground="#C3D2EA"
                   TextWrapping="Wrap"
                   Margin="0 0 0 12" />

        <ListBox x:Name="ChoicesList"
                 Grid.Row="2"
                 ItemsSource="{Binding Choices}"
                 SelectedItem="{Binding SelectedChoice}"
                 DisplayMemberPath="Label"
                 Background="#12263C"
                 BorderThickness="0"
                 Foreground="#C3D2EA"
                 FontSize="13"
                 AutomationProperties.Name="Liste des ambiances" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 12 0 0">
            <Button Content="Annuler" Width="120" Height="32" Margin="0 0 8 0" Click="OnCancelClicked" />
            <Button Content="OK" Width="120" Height="32" Click="OnOkClicked" />
        </StackPanel>
    </Grid>
</Window>

