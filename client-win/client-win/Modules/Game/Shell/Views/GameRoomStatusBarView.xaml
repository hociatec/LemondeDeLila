<UserControl x:Class="client_win.Modules.Game.Shell.Views.GameRoomStatusBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="60" d:DesignWidth="1280"
             Focusable="False"
             IsTabStop="False">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Border x:Name="StatusRegion"
            Background="#0C1523"
            Padding="12 8"
            AutomationProperties.LiveSetting="Polite">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock x:Name="StatusText"
                       Text="{Binding Status}"
                       Foreground="#F2C14E"
                       FontSize="14"
                       TextWrapping="Wrap"
                       AutomationProperties.Name="{Binding Status}"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="  •  Reconnexion…"
                       Foreground="#F08B5B"
                       FontSize="14"
                       Visibility="{Binding IsReconnecting, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </Border>
</UserControl>
