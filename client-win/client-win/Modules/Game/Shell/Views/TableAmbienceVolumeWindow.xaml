<Window x:Class="client_win.Modules.Game.Shell.Views.TableAmbienceVolumeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Volume ambiance de table"
        Width="520"
        Height="260"
        Background="#0F1D2D"
        WindowStartupLocation="CenterOwner"
        Loaded="OnLoaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Ambiance de table"
                   Foreground="White"
                   FontSize="18"
                   Margin="0 0 0 12" />

        <CheckBox Grid.Row="1"
                  Content="Activer l'ambiance de table"
                  Foreground="#C3D2EA"
                  IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  Margin="0 0 0 12"
                  AutomationProperties.Name="Activer l'ambiance de table" />

        <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0 0 0 12">
            <TextBlock Text="{Binding Volume, StringFormat=Volume : {0}%}"
                       Foreground="#C3D2EA"
                       Margin="0 0 0 6" />
            <Slider x:Name="VolumeSlider"
                    Minimum="0"
                    Maximum="100"
                    Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    IsEnabled="{Binding Enabled, Mode=OneWay}"
                    TickFrequency="5"
                    IsSnapToTickEnabled="False"
                    PreviewKeyDown="OnVolumeSliderKeyDown"
                    AutomationProperties.Name="Volume ambiance de table" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annuler" Width="120" Height="32" Margin="0 0 8 0" Click="OnCancelClicked" />
            <Button Content="OK" Width="120" Height="32" Click="OnOkClicked" />
        </StackPanel>
    </Grid>
</Window>
