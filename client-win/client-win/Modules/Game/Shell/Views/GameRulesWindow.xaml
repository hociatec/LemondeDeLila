<Window x:Class="client_win.Modules.Game.Shell.Views.GameRulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RÃ¨gles"
        Width="900"
        Height="650"
        Background="#0F1D2D"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding WindowTitle}"
                   Foreground="White"
                   FontSize="18"
                   Margin="0 0 0 12" />

        <ListBox x:Name="RulesList"
                 Grid.Row="1"
                 ItemsSource="{Binding RulesLines}"
                 Background="#12263C"
                 Foreground="#C3D2EA"
                 BorderThickness="0"
                 Padding="12"
                 FontSize="13"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Focusable="True"
                 AutomationProperties.Name="RÃ¨gles">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                               TextWrapping="Wrap" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Grid.Row="2"
                Content="Fermer"
                Width="120"
                Height="32"
                HorizontalAlignment="Right"
                Margin="0 12 0 0"
                Click="OnCloseClicked" />
    </Grid>
</Window>

