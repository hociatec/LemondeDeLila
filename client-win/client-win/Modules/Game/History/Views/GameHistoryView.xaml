<UserControl x:Class="client_win.Modules.Game.History.Views.GameHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="360"
             Focusable="True"
             IsTabStop="True">
	    <Border Background="#12263C"
	            CornerRadius="12"
	            Padding="20"
	            Focusable="False"
	            KeyboardNavigation.IsTabStop="False"
	            AutomationProperties.LabeledBy="{Binding ElementName=HistoryTitle}"
	            AutomationProperties.Name="Historique de la partie"
	            AutomationProperties.HelpText="Panneau Historique. Contient la trace des événements de la partie.">
		        <Grid>
		            <Grid.RowDefinitions>
		                <RowDefinition Height="Auto" />
		                <RowDefinition Height="*" />
		                <RowDefinition Height="Auto" />
		            </Grid.RowDefinitions>

            <TextBlock x:Name="HistoryTitle"
                       Text="Historique"
                       Foreground="White"
                       FontSize="18"
                       Margin="0 0 0 12" />

	<RichTextBox
	    x:Name="HistoryViewer"
	    Grid.Row="1"
	    Background="#0D1625"
	    BorderThickness="0"
	    Foreground="#C3D2EA"
	    FontFamily="Segoe UI"
	    FontSize="13"
	    IsReadOnly="True"
	    IsReadOnlyCaretVisible="True"
	    IsDocumentEnabled="True"
	    VerticalScrollBarVisibility="Auto"
	    HorizontalScrollBarVisibility="Disabled"
	    Focusable="True"
	    IsTabStop="True"
	    KeyboardNavigation.TabIndex="1"
	    AutomationProperties.LabeledBy="{Binding ElementName=HistoryTitle}"
	    AutomationProperties.Name="Historique"
	    AutomationProperties.HelpText="Historique en lecture seule. Naviguez avec les flèches comme dans un document." />


		            <!-- Live region minimal pour annoncer les nouvelles lignes d'historique. -->
		            <TextBlock x:Name="A11yAnnouncer"
		                       Grid.Row="2"
	                       Height="1"
	                       Width="1"
	                       Opacity="0"
	                       IsHitTestVisible="False"
	                       AutomationProperties.IsOffscreenBehavior="Onscreen"
	                       AutomationProperties.LiveSetting="Polite" />
	        </Grid>
	    </Border>
	</UserControl>

