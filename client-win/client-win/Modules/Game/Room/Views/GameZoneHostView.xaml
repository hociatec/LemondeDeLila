<UserControl x:Class="client_win.Modules.Game.Room.Views.GameZoneHostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="600"
             Focusable="False"
             IsTabStop="False">
    <Border Background="#0E1E34"
            CornerRadius="10"
            Padding="16"
            Margin="0 0 0 12"
            Focusable="False"
            KeyboardNavigation.DirectionalNavigation="Contained"
            AutomationProperties.Name="Zone de jeu"
            AutomationProperties.HelpText="Zone de jeu. Surface UI dynamique chargée selon le jeu.">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="GameZoneTitle"
                       Text="Zone de jeu"
                       Foreground="White"
                       FontSize="16"
                       Margin="0 0 0 8" />

            <Grid Grid.Row="1">
                <Button x:Name="GameZoneEmptyAnchor"
                        Focusable="True"
                        IsTabStop="True"
                        KeyboardNavigation.TabIndex="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        PreviewKeyDown="OnAnchorPreviewKeyDown"
                        AutomationProperties.Name="Zone de jeu"
                        AutomationProperties.HelpText="Zone de jeu. Zone vide, en attente de l'interface active.">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="IsHitTestVisible" Value="False" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="VerticalAlignment" Value="Stretch" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Content}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <ContentControl x:Name="GameZoneHost"
                                Content="{Binding Content}"
                                Focusable="False"
                                IsTabStop="False"
                                MinHeight="180"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                AutomationProperties.Name="Zone de jeu" />

                <TextBlock Text="Zone de jeu : en attente de l'interface active."
                           Foreground="#7FA4D9"
                           FontSize="13"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Content}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>
    </Border>
</UserControl>
