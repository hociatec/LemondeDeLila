<UserControl x:Class="client_win.Modules.Game.Room.Views.GameRoomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:history="clr-namespace:client_win.Modules.Game.History.Views"
             xmlns:behaviors="clr-namespace:client_win.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1280">
    <Grid x:Name="Root"
          Background="#0F1D2D"
          Loaded="OnLoaded"
          PreviewKeyDown="OnPreviewKeyDown"
          behaviors:ShortcutBindingsBehavior.Shortcuts="{Binding Shortcuts}"
          KeyboardNavigation.TabNavigation="Continue"
          KeyboardNavigation.ControlTabNavigation="Continue">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20" VerticalAlignment="Center">
            <TextBlock Text="{Binding Game.Name}"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="White" />
            <Border Background="#F2C14E"
                    CornerRadius="8"
                    Padding="10 6"
                    Margin="16 0 0 0"
                    VerticalAlignment="Center">
                <TextBlock Text="Table de jeu" Foreground="Black" FontSize="14" FontWeight="Bold" />
            </Border>
        </StackPanel>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#12263C"
                    CornerRadius="12"
                    Padding="20"
                    Focusable="False"
                    AutomationProperties.Name="Salle de jeu"
                    AutomationProperties.HelpText="Panneau Salle de jeu. Contient la zone de jeu et ses informations.">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="RoomTitle"
                               Text="Salle"
                               Foreground="White"
                               FontSize="18"
                               Margin="0 0 0 12" />

                    <StackPanel Grid.Row="1">
                        <TextBlock Text="{Binding Game.Summary}"
                                   TextWrapping="Wrap"
                                   Foreground="#C3D2EA"
                                   FontSize="14"
                                   Margin="0 0 0 12" />

                        <StackPanel Orientation="Horizontal" Margin="0 0 0 16">
                            <TextBlock Text="{Binding Game.Engine, StringFormat='Moteur : {0}'}" Foreground="#9CB2D1" FontSize="12" Margin="0 0 12 0" />
                            <TextBlock Text="{Binding Game.MinPlayers, StringFormat='Min {0} joueurs'}" Foreground="#9CB2D1" FontSize="12" Margin="0 0 12 0" />
                            <TextBlock Text="{Binding Game.MaxPlayers, StringFormat='Max {0} joueurs'}" Foreground="#9CB2D1" FontSize="12" />
                        </StackPanel>

                        <Border Background="#0E1E34"
                                CornerRadius="10"
                                Padding="16"
                                Margin="0 0 0 12"
                                Focusable="False"
                                KeyboardNavigation.DirectionalNavigation="Contained"
                                AutomationProperties.Name="Zone de jeu"
                                AutomationProperties.HelpText="Zone de jeu. Surface UI dynamique chargée selon le jeu.">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="GameZoneTitle"
                                           Text="Zone de jeu"
                                           Foreground="White"
                                           FontSize="16"
                                           Margin="0 0 0 8" />

                                <Grid Grid.Row="1">
                                    <Button x:Name="GameZoneEmptyAnchor"
                                            Focusable="True"
                                            IsTabStop="True"
                                            KeyboardNavigation.TabIndex="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            AutomationProperties.Name="Zone de jeu"
                                            AutomationProperties.HelpText="Zone de jeu. Zone vide, en attente de l'interface active.">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Setter Property="IsHitTestVisible" Value="False" />
                                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                <Setter Property="VerticalAlignment" Value="Stretch" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding GameZoneContent}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <ContentControl x:Name="GameZoneHost"
                                                    Content="{Binding GameZoneContent}"
                                                    Focusable="False"
                                                    IsTabStop="False"
                                                    MinHeight="180"
                                                    HorizontalContentAlignment="Stretch"
                                                    VerticalContentAlignment="Stretch"
                                                    AutomationProperties.Name="Zone de jeu" />

                                    <TextBlock Text="Zone de jeu : en attente de l'interface active."
                                               Foreground="#7FA4D9"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding GameZoneContent}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <history:GameHistoryView x:Name="HistoryHost"
                                     Grid.Column="1"
                                     DataContext="{Binding History}"
                                     IsTabStop="False"
                                     Margin="16 0 0 0" />
        </Grid>

        <Border Grid.Row="2"
                Background="#0C1523"
                Padding="12 8"
                AutomationProperties.LiveSetting="Polite">
            <TextBlock Text="{Binding Status}"
                       Foreground="#F2C14E"
                       FontSize="14"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       AutomationProperties.Name="Statut"
                       AutomationProperties.LiveSetting="Polite" />
        </Border>
    </Grid>
</UserControl>
