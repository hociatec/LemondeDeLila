<UserControl x:Class="client_win.Modules.Game.Room.Views.GameRoomHeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="80" d:DesignWidth="1280"
             Focusable="False"
             IsTabStop="False">
    <StackPanel Orientation="Horizontal" Margin="20" VerticalAlignment="Center">
        <TextBlock Text="{Binding Game.Name}"
                   FontSize="26"
                   FontWeight="SemiBold"
                   Foreground="White" />
        <Border Background="#F2C14E"
                CornerRadius="8"
                Padding="10 6"
                Margin="16 0 0 0"
                VerticalAlignment="Center">
            <TextBlock Text="Table de jeu" Foreground="Black" FontSize="14" FontWeight="Bold" />
        </Border>
    </StackPanel>
</UserControl>
