<UserControl x:Class="client_win.Modules.Admin.Views.AdminClientUpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Focusable="False"
             IsTabStop="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="AdminView.Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#BFD0E6" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="ActionButton" TargetType="Button">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Background" Value="#214570" />
                <Setter Property="BorderBrush" Value="#2D5A8C" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2C5B8E" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#1C3C62" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.6" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
                <Setter Property="Background" Value="#1A3557" />
                <Setter Property="BorderBrush" Value="{StaticResource HighlightBrush}" />
            </Style>

            <Style x:Key="DangerActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
                <Setter Property="Background" Value="#4B1D2A" />
                <Setter Property="BorderBrush" Value="#E05A5A" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Orientation="Vertical">
        <Border Background="#0E2034" CornerRadius="10" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Statut" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding Details}"
                               Foreground="White"
                               FontSize="14"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Status}"
                               Foreground="#90A6C4"
                               FontSize="12"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Traitement en cours..."
                               Foreground="#F2C14E"
                               FontSize="12"
                               HorizontalAlignment="Right">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ProgressBar Width="180" Height="6" IsIndeterminate="True" Margin="0,6,0,0">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="#0E2034" CornerRadius="10" Padding="16" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Publication" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="VersionLabel" Text="Version ClickOnce (automatique)" Foreground="#BFD0E6" FontSize="12" Margin="0,12,0,6" />
                    <TextBox x:Name="VersionInput"
                              Text="{Binding SecondaryInput, UpdateSourceTrigger=PropertyChanged}"
                              Style="{DynamicResource InputTextBox}"
                              MinHeight="40"
                              IsReadOnly="True"
                              IsReadOnlyCaretVisible="False"
                              IsTabStop="False"
                              Focusable="False"
                              AutomationProperties.LabeledBy="{Binding ElementName=VersionLabel}" />
                    <TextBlock Text="Calculée automatiquement à partir de la dernière version publiée."
                               Foreground="#90A6C4"
                               FontSize="11"
                               Margin="0,6,0,0" />

                    <TextBlock x:Name="MessageLabel" Text="Message (optionnel)" Foreground="#BFD0E6" FontSize="12" Margin="0,12,0,6" />
                    <TextBox x:Name="MessageInput"
                             Text="{Binding ClientUpdateMessage, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource InputTextBox}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="90"
                             VerticalScrollBarVisibility="Auto"
                             AutomationProperties.LabeledBy="{Binding ElementName=MessageLabel}" />
                    <TextBlock Text="Laisser vide pour utiliser le message automatique."
                               Foreground="#90A6C4"
                               FontSize="11"
                               Margin="0,6,0,0" />

                    <Button x:Name="PublishButton"
                            Content="Compiler + publier"
                            Style="{StaticResource PrimaryActionButton}"
                            Command="{Binding ClientUpdatesBuildCommand}"
                            Margin="0,14,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="#0E2034" CornerRadius="10" Padding="16" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="Diffusion" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Annonce la mise à jour à tous les clients connectés."
                               Foreground="#90A6C4"
                               FontSize="12"
                               Margin="0,10,0,6"
                               TextWrapping="Wrap" />
                    <Button Content="Proposer la mise à jour"
                            Style="{StaticResource ActionButton}"
                            Command="{Binding ClientUpdatesAnnounceCommand}" />

                    <TextBlock Text="Force la mise à jour et bloque les anciennes versions."
                               Foreground="#90A6C4"
                               FontSize="12"
                               Margin="0,16,0,6"
                               TextWrapping="Wrap" />
                    <Button Content="Forcer la mise à jour"
                            Style="{StaticResource DangerActionButton}"
                            Command="{Binding ClientUpdatesForceCommand}" />

                    <TextBlock Text="Astuce : en CI, la mise à jour est déjà annoncée et forcée automatiquement."
                               Foreground="#90A6C4"
                               FontSize="11"
                               Margin="0,16,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
