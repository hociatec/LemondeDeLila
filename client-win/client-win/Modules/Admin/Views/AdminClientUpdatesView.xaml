<UserControl x:Class="client_win.Modules.Admin.Views.AdminClientUpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Focusable="False"
             IsTabStop="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="AdminView.Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#BFD0E6" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="ActionButton" TargetType="Button">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Background" Value="#1A3557" />
                <Setter Property="BorderBrush" Value="{StaticResource HighlightBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2C5B8E" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#1C3C62" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.6" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid KeyboardNavigation.TabNavigation="Cycle"
          KeyboardNavigation.DirectionalNavigation="Contained">
        <Border Background="#0E2034"
                CornerRadius="10"
                Padding="16">
            <StackPanel>
                <TextBlock Text="Mise à jour client"
                           Style="{StaticResource SectionTitle}" />

                <TextBlock x:Name="DelayLabel"
                           Text="Délai avant la mise à jour (minutes, min 5)"
                           Foreground="#BFD0E6"
                           FontSize="12"
                           Margin="0,12,0,6" />
                <TextBox x:Name="DelayInput"
                         Text="{Binding ClientUpdateDelayMinutes, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource InputTextBox}"
                         MinHeight="40"
                         TabIndex="0"
                         AutomationProperties.LabeledBy="{Binding ElementName=DelayLabel}" />

                <TextBlock x:Name="MessageLabel"
                           Text="Message à afficher aux utilisateurs"
                           Foreground="#BFD0E6"
                           FontSize="12"
                           Margin="0,12,0,6" />
                <TextBox x:Name="MessageInput"
                         Text="{Binding ClientUpdateMessage, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource InputTextBox}"
                         Height="110"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         TabIndex="1"
                         AutomationProperties.LabeledBy="{Binding ElementName=MessageLabel}" />

                <Button x:Name="ValidateButton"
                        Content="Valider la mise à jour"
                        Style="{StaticResource ActionButton}"
                        Command="{Binding ClientUpdatesScheduleCommand}"
                        Margin="0,14,0,0"
                        TabIndex="2" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
