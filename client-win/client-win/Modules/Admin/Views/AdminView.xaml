<UserControl x:Class="client_win.Modules.Admin.Views.AdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:client_win.Modules.Admin.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="AdminView.Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="HideWhenClientUpdates" TargetType="FrameworkElement">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ShowClientUpdatesPanel}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding EscapeCommand}" />
    </UserControl.InputBindings>

    <Grid Background="{StaticResource ShellBackground}"
          FocusManager.IsFocusScope="True"
          KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" Foreground="White" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="12"
                Margin="24" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              MaxHeight="520"
                              Focusable="False"
                              KeyboardNavigation.IsTabStop="False">
                    <StackPanel Orientation="Vertical" Margin="0,0,0,12">
                        <views:AdminInputsView x:Name="InputsView" Style="{StaticResource HideWhenClientUpdates}" />
                        <views:AdminUserFiltersView Style="{StaticResource HideWhenClientUpdates}" />
                        <views:AdminLogControlsView Style="{StaticResource HideWhenClientUpdates}" />
                    </StackPanel>
                </ScrollViewer>

                <ListBox x:Name="ItemsList"
                         Grid.Row="1"
                         Style="{StaticResource HideWhenClientUpdates}"
                         ItemsSource="{Binding ItemsView}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         ItemTemplate="{StaticResource AdminMenuItemTemplate}"
                         SelectionMode="Single"
                         VirtualizingStackPanel.IsVirtualizing="False"
                         ScrollViewer.CanContentScroll="False"
                         KeyboardNavigation.TabNavigation="Cycle"
                         AutomationProperties.LabeledBy="{Binding ElementName=TitleText}">
                    <ListBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ActivateCommand}" />
                        <KeyBinding Key="Return" Command="{Binding ActivateCommand}" />
                    </ListBox.InputBindings>
                </ListBox>

                <views:AdminClientUpdatesView x:Name="ClientUpdatesPanel"
                                              Grid.Row="1"
                                              Visibility="{Binding ShowClientUpdatesPanel, Converter={StaticResource BoolToVis}}" />

                <Grid Grid.Row="2" Style="{StaticResource HideWhenClientUpdates}">
                    <ScrollViewer x:Name="DetailsSegmentsScroll"
                                  Visibility="{Binding HasDetailSegments, Converter={StaticResource BoolToVis}}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="True"
                                  IsTabStop="True"
                                  Margin="0,12,0,0"
                                  AutomationProperties.LabeledBy="{Binding ElementName=TitleText}">
                        <ItemsControl ItemsSource="{Binding DetailsSegments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               Foreground="#BFD0E6"
                                               FontSize="14"
                                               TextWrapping="Wrap"
                                               Margin="0 0 0 12" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBox x:Name="DetailsBox"
                             Style="{StaticResource InputTextBox}"
                             Text="{Binding Details, Mode=OneWay}"
                             Foreground="#BFD0E6"
                             FontSize="14"
                             TextWrapping="Wrap"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="0,12,0,0"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="True"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.LiveSetting="Polite"
                             Visibility="{Binding HasDetailSegments, Converter={StaticResource BoolToVisInverse}}" />
                </Grid>
            </Grid>
        </Border>

        <views:AdminStatusBarView Grid.Row="2" Style="{StaticResource HideWhenClientUpdates}" />
    </Grid>
</UserControl>
