<UserControl x:Class="client_win.Modules.Admin.Views.AdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Loaded="OnLoaded"
             KeyDown="OnKeyDown">
    <UserControl.Resources>
        <SolidColorBrush x:Key="ShellBackground" Color="#0B111A" />
        <SolidColorBrush x:Key="PanelBrush" Color="#12263C" />
        <SolidColorBrush x:Key="HighlightBrush" Color="#F2C14E" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0 4 0 4" />
                        <Setter Property="Padding" Value="10" />
                        <Setter Property="Background" Value="#10223A" />
                        <Setter Property="BorderBrush" Value="#1F3C60" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1B3554" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#214570" />
                                            <Setter Property="BorderBrush" Value="{StaticResource HighlightBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InputTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#0E2034" />
            <Setter Property="BorderBrush" Value="#1F3C60" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource ShellBackground}" FocusManager.IsFocusScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" Foreground="White" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="12"
                Margin="24" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,12">
            <StackPanel Orientation="Vertical"
                        Visibility="{Binding IsTextInputVisible, Converter={StaticResource BoolToVis}}"
                        Margin="0,0,0,12">
                <TextBlock x:Name="PrimaryInputLabelText"
                           Text="{Binding TextInputLabel}"
                           Foreground="#BFD0E6"
                           FontSize="14"
                           Margin="0,0,0,6" />
                <TextBox x:Name="PrimaryInput"
                         Text="{Binding TextInput, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputTextBox}"
                         AcceptsReturn="True"
                         MinHeight="40"
                         AutomationProperties.LabeledBy="{Binding ElementName=PrimaryInputLabelText}"
                         KeyDown="OnInputKeyDown" />

                <StackPanel Margin="0,10,0,0"
                            Visibility="{Binding IsSecondaryInputVisible, Converter={StaticResource BoolToVis}}">
                    <TextBlock x:Name="SecondaryInputLabelText"
                               Text="{Binding SecondaryInputLabel}"
                               Foreground="#BFD0E6"
                               FontSize="14"
                               Margin="0,0,0,6" />
                    <TextBox x:Name="SecondaryInputBox"
                             Text="{Binding SecondaryInput, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBox}"
                             AutomationProperties.LabeledBy="{Binding ElementName=SecondaryInputLabelText}"
                             KeyDown="OnInputKeyDown" />
                </StackPanel>
            </StackPanel>

            <Border Visibility="{Binding ShowUserFilters, Converter={StaticResource BoolToVis}}"
                    Background="#0E2034"
                    CornerRadius="6"
                    Padding="12"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Filtres utilisateurs"
                               Foreground="#BFD0E6"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <StackPanel Margin="0,0,6,8">
                            <TextBlock x:Name="FilterSearchLabel"
                                       Text="Rechercher"
                                       Foreground="#BFD0E6"
                                       FontSize="12" />
                            <TextBox Text="{Binding FilterSearch, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBox}"
                                     MinHeight="32"
                                     AutomationProperties.LabeledBy="{Binding ElementName=FilterSearchLabel}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock x:Name="FilterRoleLabel"
                                       Text="Rôle"
                                       Foreground="#BFD0E6"
                                       FontSize="12" />
                            <TextBox Text="{Binding FilterRole, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBox}"
                                     MinHeight="32"
                                     AutomationProperties.LabeledBy="{Binding ElementName=FilterRoleLabel}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,6,8">
                            <TextBlock x:Name="FilterStatusLabel"
                                       Text="Statut"
                                       Foreground="#BFD0E6"
                                       FontSize="12" />
                            <ComboBox SelectedValue="{Binding FilterStatus, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Tag"
                                      Background="#0E2034"
                                      Foreground="White"
                                      BorderBrush="#1F3C60"
                                      BorderThickness="1"
                                      Padding="6"
                                      AutomationProperties.LabeledBy="{Binding ElementName=FilterStatusLabel}">
                                <ComboBoxItem Content="Tous" Tag="all" />
                                <ComboBoxItem Content="Actifs" Tag="active" />
                                <ComboBoxItem Content="Bannis" Tag="banned" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock x:Name="FilterCreatedAfterLabel"
                                       Text="Créé après"
                                       Foreground="#BFD0E6"
                                       FontSize="12" />
                            <TextBox Text="{Binding FilterCreatedAfter, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBox}"
                                     MinHeight="32"
                                     AutomationProperties.LabeledBy="{Binding ElementName=FilterCreatedAfterLabel}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock x:Name="FilterCreatedBeforeLabel"
                                       Text="Créé avant"
                                       Foreground="#BFD0E6"
                                       FontSize="12" />
                            <TextBox Text="{Binding FilterCreatedBefore, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBox}"
                                     MinHeight="32"
                                     AutomationProperties.LabeledBy="{Binding ElementName=FilterCreatedBeforeLabel}" />
                        </StackPanel>
                    </UniformGrid>
                    <Button Content="Appliquer"
                            Command="{Binding ApplyFiltersCommand}"
                            HorizontalAlignment="Left"
                            Padding="8 4"
                            Background="#214570"
                            Foreground="White"
                            FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <Border Visibility="{Binding ShowLogControls, Converter={StaticResource BoolToVis}}"
                    Background="#0E2034"
                    CornerRadius="6"
                    Padding="12">
                <StackPanel>
                    <TextBlock Text="Logs serveurs"
                               Foreground="#BFD0E6"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <StackPanel Margin="0,0,6,8">
                            <TextBlock x:Name="LogLinesLabel"
                                       Text="Lignes"
                                       Foreground="#BFD0E6"
                                       FontSize="12" />
                            <TextBox Text="{Binding LogLines, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBox}"
                                     MinHeight="32"
                                     AutomationProperties.LabeledBy="{Binding ElementName=LogLinesLabel}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock x:Name="LogFilterLabel"
                                       Text="Filtre"
                                       Foreground="#BFD0E6"
                                       FontSize="12" />
                            <TextBox Text="{Binding LogFilter, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBox}"
                                     MinHeight="32"
                                     AutomationProperties.LabeledBy="{Binding ElementName=LogFilterLabel}" />
                        </StackPanel>
                    </UniformGrid>
                    <Button Content="Télécharger les logs"
                            Command="{Binding DownloadLogsCommand}"
                            HorizontalAlignment="Left"
                            Padding="8 4"
                            Background="#214570"
                            Foreground="White"
                            FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </StackPanel>

                <ListBox x:Name="ItemsList"
                         Grid.Row="1"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         DisplayMemberPath="Label"
                         SelectionMode="Single"
                         VirtualizingStackPanel.IsVirtualizing="False"
                         PreviewKeyDown="OnListPreviewKeyDown"
                         KeyDown="OnListKeyDown"
                         AutomationProperties.LabeledBy="{Binding ElementName=TitleText}" />

                <TextBlock Grid.Row="2"
                           Text="{Binding Details}"
                           Foreground="#BFD0E6"
                           FontSize="14"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0"
                           AutomationProperties.LiveSetting="Polite" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#0C1523" Padding="12 8" Focusable="False">
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource HighlightBrush}" FontSize="14"
                       HorizontalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
