<UserControl x:Class="client_win.Modules.Admin.Views.AdminInputsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Focusable="False"
             IsTabStop="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="AdminView.Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Orientation="Vertical"
                Margin="0,0,0,12"
                KeyboardNavigation.TabNavigation="Local"
                KeyboardNavigation.DirectionalNavigation="Contained">
        <StackPanel Orientation="Vertical"
                    Visibility="{Binding IsTextInputVisible, Converter={StaticResource BoolToVis}}"
                    Margin="0,0,0,12">
            <TextBlock x:Name="PrimaryInputLabelText"
                       Text="{Binding TextInputLabel}"
                       Foreground="#BFD0E6"
                       FontSize="14"
                       Margin="0,0,0,6" />
            <TextBox x:Name="PrimaryInput"
                      Text="{Binding TextInput, UpdateSourceTrigger=PropertyChanged}"
                      Style="{DynamicResource InputTextBox}"
                      AcceptsReturn="{Binding PrimaryInputAcceptsReturn}"
                      PreviewKeyDown="OnInputPreviewKeyDown"
                      TabIndex="0"
                      IsTabStop="True"
                      MinHeight="40"
                      AutomationProperties.LabeledBy="{Binding ElementName=PrimaryInputLabelText}">
            </TextBox>
        </StackPanel>

        <StackPanel Margin="0,0,0,12"
                    Visibility="{Binding IsSecondaryInputVisible, Converter={StaticResource BoolToVis}}">
            <TextBlock x:Name="SecondaryInputLabelText"
                       Text="{Binding SecondaryInputLabel}"
                       Foreground="#BFD0E6"
                       FontSize="14"
                       Margin="0,0,0,6" />
            <TextBox x:Name="SecondaryInputBox"
                      Text="{Binding SecondaryInput, UpdateSourceTrigger=PropertyChanged}"
                      Style="{DynamicResource InputTextBox}"
                      AcceptsReturn="{Binding SecondaryInputAcceptsReturn}"
                      PreviewKeyDown="OnInputPreviewKeyDown"
                      TabIndex="1"
                      IsTabStop="True"
                      MinHeight="40"
                      TextWrapping="Wrap"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      AutomationProperties.LabeledBy="{Binding ElementName=SecondaryInputLabelText}">
            </TextBox>
        </StackPanel>

        <StackPanel Margin="0,0,0,12"
                    Visibility="{Binding IsThirdInputVisible, Converter={StaticResource BoolToVis}}">
            <TextBlock x:Name="ThirdInputLabelText"
                       Text="{Binding ThirdInputLabel}"
                       Foreground="#BFD0E6"
                       FontSize="14"
                       Margin="0,0,0,6" />
            <TextBox x:Name="ThirdInputBox"
                      Text="{Binding ThirdInput, UpdateSourceTrigger=PropertyChanged}"
                      Style="{DynamicResource InputTextBox}"
                      PreviewKeyDown="OnInputPreviewKeyDown"
                      TabIndex="2"
                      IsTabStop="True"
                      AutomationProperties.LabeledBy="{Binding ElementName=ThirdInputLabelText}">
            </TextBox>
        </StackPanel>

        <StackPanel Margin="0,0,0,12"
                    Visibility="{Binding IsFourthInputVisible, Converter={StaticResource BoolToVis}}">
            <TextBlock x:Name="FourthInputLabelText"
                       Text="{Binding FourthInputLabel}"
                       Foreground="#BFD0E6"
                       FontSize="14"
                       Margin="0,0,0,6" />
            <TextBox x:Name="FourthInputBox"
                      Text="{Binding FourthInput, UpdateSourceTrigger=PropertyChanged}"
                      Style="{DynamicResource InputTextBox}"
                      PreviewKeyDown="OnInputPreviewKeyDown"
                      TabIndex="3"
                      IsTabStop="True"
                      AutomationProperties.LabeledBy="{Binding ElementName=FourthInputLabelText}">
            </TextBox>
        </StackPanel>

        <StackPanel Margin="0,0,0,12"
                    Visibility="{Binding IsFifthInputVisible, Converter={StaticResource BoolToVis}}">
            <TextBlock x:Name="FifthInputLabelText"
                       Text="{Binding FifthInputLabel}"
                       Foreground="#BFD0E6"
                       FontSize="14"
                       Margin="0,0,0,6" />
            <TextBox x:Name="FifthInputBox"
                      Text="{Binding FifthInput, UpdateSourceTrigger=PropertyChanged}"
                      Style="{DynamicResource InputTextBox}"
                      PreviewKeyDown="OnInputPreviewKeyDown"
                      TabIndex="4"
                      IsTabStop="True"
                      AutomationProperties.LabeledBy="{Binding ElementName=FifthInputLabelText}">
            </TextBox>
        </StackPanel>
    </StackPanel>
</UserControl>
