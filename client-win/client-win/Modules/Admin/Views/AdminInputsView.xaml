<UserControl x:Class="client_win.Modules.Admin.Views.AdminInputsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Focusable="False"
             IsTabStop="False">
    <StackPanel Orientation="Vertical" Margin="0,0,0,12">
        <StackPanel Orientation="Vertical"
                    Visibility="{Binding IsTextInputVisible, Converter={StaticResource BoolToVis}}"
                    Margin="0,0,0,12">
            <TextBlock x:Name="PrimaryInputLabelText"
                       Text="{Binding TextInputLabel}"
                       Foreground="#BFD0E6"
                       FontSize="14"
                       Margin="0,0,0,6" />
            <TextBox x:Name="PrimaryInput"
                     Text="{Binding TextInput, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource InputTextBox}"
                     AcceptsReturn="True"
                     MinHeight="40"
                     AutomationProperties.LabeledBy="{Binding ElementName=PrimaryInputLabelText}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding ActivateCommand}" />
                    <KeyBinding Key="Return" Command="{Binding ActivateCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </StackPanel>

        <StackPanel Margin="0,0,0,12"
                    Visibility="{Binding IsSecondaryInputVisible, Converter={StaticResource BoolToVis}}">
            <TextBlock x:Name="SecondaryInputLabelText"
                       Text="{Binding SecondaryInputLabel}"
                       Foreground="#BFD0E6"
                       FontSize="14"
                       Margin="0,0,0,6" />
            <TextBox x:Name="SecondaryInputBox"
                     Text="{Binding SecondaryInput, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource InputTextBox}"
                     AutomationProperties.LabeledBy="{Binding ElementName=SecondaryInputLabelText}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding ActivateCommand}" />
                    <KeyBinding Key="Return" Command="{Binding ActivateCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </StackPanel>
    </StackPanel>
</UserControl>
