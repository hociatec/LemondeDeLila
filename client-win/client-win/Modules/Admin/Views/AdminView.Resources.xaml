<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="ShellBackground" Color="#0B111A" />
    <SolidColorBrush x:Key="PanelBrush" Color="#12263C" />
    <SolidColorBrush x:Key="HighlightBrush" Color="#F2C14E" />
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <Style x:Key="InputTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="#0E2034" />
        <Setter Property="BorderBrush" Value="#1F3C60" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <DataTemplate x:Key="AdminMenuItemTemplate">
        <Grid>
            <TextBlock x:Name="PlainLabel"
                       Text="{Binding Label}"
                       Foreground="White"
                       FontSize="16"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
            <CheckBox x:Name="CheckLabel"
                      Visibility="Collapsed"
                      Content="{Binding Label}"
                      IsChecked="{Binding IsChecked, Mode=OneWay}"
                      Foreground="White"
                      FontSize="16"
                      VerticalAlignment="Center"
                      Focusable="False"
                      IsTabStop="False"
                      Command="{Binding DataContext.SelectAndActivateCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                      CommandParameter="{Binding}" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsCheckable}" Value="True">
                <Setter TargetName="PlainLabel" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="CheckLabel" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="0 4 0 4" />
                    <Setter Property="Padding" Value="10" />
                    <Setter Property="Background" Value="#10223A" />
                    <Setter Property="BorderBrush" Value="#1F3C60" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1B3554" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#214570" />
                                        <Setter Property="BorderBrush" Value="{StaticResource HighlightBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
