{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "builder": "swc",
    "typeCheck": true,
    "deleteOutDir": true,
    "assets": [
      "game/core/infrastructure/system/generated-game-catalog-index.json",
      "game/games/**/*.txt",
      "game/games/**/*.json",
      "game/games/**/manifest.json",
      "game/games/**/rules.md"
    ]
  }
}
