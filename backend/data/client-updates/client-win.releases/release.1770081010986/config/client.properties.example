app.name=Le Monde de Lila
network.http.base=https://api.lilas.hociatec.fr/api/
network.ws.url=wss://ws.lilas.hociatec.fr/ws
network.ws.presence=wss://ws.lilas.hociatec.fr/presence
# API WS (requêtes auth/catalog/game.actions via /ws/api)
network.ws.api=wss://ws.lilas.hociatec.fr/ws/api
# WebSocket moteur de jeu (actions temps réel)
network.ws.game=wss://ws.lilas.hociatec.fr/ws/game
# Notifications (mode spectateur/admin)
network.ws.notify=wss://ws.lilas.hociatec.fr/ws/notify
updates.check.url=https://api.lilas.hociatec.fr/client/version
updates.root.dir=.
updates.signature.publicKey=./config/update-signing-public.pem
# updates.auth.token is intentionally unset; provide via env LILA_UPDATE_TOKEN or UPDATES_AUTH_TOKEN
# updates.signature.algorithm=SHA256withRSA

# JWT signature verification (RS256):
# Public key PEM used to verify the server-issued JWT locally (safe to ship in the client).
jwt.issuer=le-monde-de-lila
# jwt.audience=
jwt.signature.publicKey=./config/jwt-signing-public.pem

# Admin maintenance (déploiement backend via /api/admin/maintenance/*)
# Option 1: config file (plaintext)
# admin.maintenance.token=CHANGE_ME
# Option 2: env var (prioritaire)
# CLIENT_ADMIN_MAINTENANCE_TOKEN=CHANGE_ME
# ADMIN_MAINTENANCE_TOKEN=CHANGE_ME
