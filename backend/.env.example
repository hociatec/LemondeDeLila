PORT=3001
# Si vous lancez le backend en "prod" (ex: `NODE_ENV=production node dist/main`)
# et que vous voulez tout de même charger ce fichier `.env`, laissez `IGNORE_ENV_FILE` vide/absent.
# Pour forcer un démarrage "env-only" (systemd/docker secrets), définissez:
# IGNORE_ENV_FILE=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=lila
DB_PASSWORD=lila
DB_NAME=le_monde_de_lila
# Optionnel : DATABASE_URL=mysql://lila:lila@127.0.0.1:3306/le_monde_de_lila
#
# JWT:
# - Recommandé: RS256 (clé privée côté serveur + clé publique distribuable aux clients)
# - Legacy: HS256 (JWT_SECRET partagé, ne jamais l'embarquer dans un client)
#
# RS256 (recommandé)
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
#
# HS256 (legacy)
# JWT_ALGORITHM=HS256
# JWT_SECRET=change-me-in-prod
JWT_EXPIRES_IN=12h
# Redis dédié à l’état du moteur de jeu (obligatoire en production)
GAME_ENGINE_STATE_REDIS_URL=redis://127.0.0.1:6379/0
# Redis partagé pour les sessions WS/API (requis pour le scaling realtime)
SESSION_STORE_REDIS_URL=redis://127.0.0.1:6379/1
# (Optionnel) Redis pour le cache court des payloads room (sinon utilise SESSION_STORE_REDIS_URL)
# ROOM_PAYLOAD_REDIS_URL=redis://127.0.0.1:6379/1
# Redis dédiés aux notifications / présence (optionnel si partagé avec SESSION_STORE)
NOTIFICATION_REDIS_URL=redis://127.0.0.1:6379/1
PRESENCE_REDIS_URL=redis://127.0.0.1:6379/1
# WS tickets (recommandé) : secret serveur pour signer des tickets courts utilisés lors des connexions WebSocket.
# NOTE: Ne jamais mettre ce secret dans le client.
WS_TICKET_SECRET=change-me-in-prod-too
# Durée de vie des tickets (secondes). Garder court (ex: 60).
WS_TICKET_TTL_SECONDS=60
# Legacy (déconseillé): ancien secret partagé côté client pour /ws. Garder uniquement pour compatibilité clients anciens.
# WS_SHARED_SECRET=
# Chemin explicite du catalogue de jeux (utilisé en dev/watch)
GAME_CATALOG_PATH=./src/game/games
# Origines CORS autorisées (séparées par des virgules)
CORS_ORIGINS=http://localhost:4200,http://localhost:5173
# Rate limiting (TTL en secondes / nombre de requêtes)
RATE_LIMIT_TTL=60
RATE_LIMIT_COUNT=120
# Logging
LOG_LEVEL=info
LOG_DIR=logs
LOG_FILES_ENABLED=true
# Client updates (ClickOnce)
# En production, utiliser des chemins persistants hors du dépôt.
# CLIENT_UPDATES_DIR=/var/lib/lemonde-de-lila/client-updates/client-win
# CLIENT_UPDATES_META_PATH=/var/lib/lemonde-de-lila/client-updates/latest.json
# CLIENT_UPDATES_UPLOADS_DIR=/var/lib/lemonde-de-lila/client-updates/uploads
# CLIENT_UPDATES_PUBLIC_URL=https://api.lilas.hociatec.fr/updates/client-win/
# Miroir de catégories taverne (évite de modifier le worktree git en runtime)
# TAVERNE_CATEGORIES_ROOT=/var/lib/lemonde-de-lila/taverne-categories
# Dé-commenter pour tester les jeux prototypes
# ENABLE_PROTOTYPE_GAMES=true
