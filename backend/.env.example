PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=le_monde_de_lila
# Optionnel : DATABASE_URL=mysql://root:@127.0.0.1:3306/le_monde_de_lila
JWT_SECRET=change-me-in-prod
JWT_EXPIRES_IN=12h
# Redis dédié à l’état du moteur de jeu (obligatoire en production)
GAME_ENGINE_STATE_REDIS_URL=redis://127.0.0.1:6379/0
# Redis partagé pour les sessions WS/API (requis pour le scaling realtime)
SESSION_STORE_REDIS_URL=redis://127.0.0.1:6379/1
# Redis dédiés aux notifications / présence (optionnel si partagé avec SESSION_STORE)
NOTIFICATION_REDIS_URL=redis://127.0.0.1:6379/1
PRESENCE_REDIS_URL=redis://127.0.0.1:6379/1
# Secret partagé avec le client pour restreindre les connexions WS (/ws). Laisser vide pour désactiver.
WS_SHARED_SECRET=remote-ws-shared-secret-2025
# Chemin explicite du catalogue de jeux (utilisé en dev/watch)
GAME_CATALOG_PATH=./src/game/games
# Origines CORS autorisées (séparées par des virgules)
CORS_ORIGINS=http://localhost:4200,http://localhost:5173
# Rate limiting (TTL en secondes / nombre de requêtes)
RATE_LIMIT_TTL=60
RATE_LIMIT_COUNT=120
# Logging
LOG_LEVEL=info
LOG_DIR=log
LOG_FILES_ENABLED=true
# Dé-commenter pour tester les jeux prototypes
# ENABLE_PROTOTYPE_GAMES=true
