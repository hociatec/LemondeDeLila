# Exécution
NODE_ENV=development
PORT=3001
# IGNORE_ENV_FILE=true

# Base de données
# DATABASE_URL=mysql://lila:lila@127.0.0.1:3306/le_monde_de_lila
DB_HOST=127.0.0.1
DB_PORT=3306
# Pool et connexion communs au serveur et a la CLI TypeORM.
DB_POOL_SIZE=10
DB_CONNECT_TIMEOUT_MS=10000
DB_QUERY_TIMEOUT_MS=30000
ADMIN_MAINTENANCE_REQUIRE_DISTRIBUTED=false
# Retries de connexion au demarrage Nest uniquement, jamais des mutations.
DB_STARTUP_RETRY_ATTEMPTS=5
DB_STARTUP_RETRY_DELAY_MS=1000
DB_USER=lila
DB_PASSWORD=<generate-a-random-database-password>
DB_NAME=le_monde_de_lila

# Authentification
# RS256 est recommandé en production. Les valeurs PEM peuvent remplacer les chemins.
JWT_ALGORITHM=RS256
# JWT_PRIVATE_KEY_PEM=
# JWT_PUBLIC_KEY_PEM=
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
JWT_ISSUER=le-monde-de-lila
JWT_AUDIENCE=le-monde-de-lila-client
JWT_CLOCK_TOLERANCE_SECONDS=10
# Durée positive avec unité s/m/h/d ; les nombres sans unité sont refusés.
JWT_EXPIRES_IN=12h
REFRESH_TOKEN_TTL_SECONDS=2592000
BCRYPT_COST=12

# Redis et limitations
GAME_ENGINE_STATE_REDIS_URL=redis://127.0.0.1:6379/0
SESSION_STORE_REDIS_URL=redis://127.0.0.1:6379/1
# GAME_TASK_REDIS_URL=redis://127.0.0.1:6379/2
# ROOM_PAYLOAD_REDIS_URL=redis://127.0.0.1:6379/1
# Ces deux services utilisent SESSION_STORE_REDIS_URL lorsqu'ils ne sont pas définis.
# NOTIFICATION_REDIS_URL=redis://127.0.0.1:6379/1
# PRESENCE_REDIS_URL=redis://127.0.0.1:6379/1
RATE_LIMIT_TTL=60
RATE_LIMIT_COUNT=120
# Redis dédié au rate limiting partagé entre toutes les instances.
# RATE_LIMIT_REDIS_URL=redis://127.0.0.1:6379/4

# Runtime
# Liste explicite des proxies de confiance (CIDR/IP Express), vide en accès direct.
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# Liste exacte HTTP et WebSocket. En production, vide refuse les origines navigateur.
# Les clients natifs sans Origin restent soumis à leur authentification JWT/ticket.
CORS_ORIGINS=http://localhost:4200,http://localhost:5173
LOG_LEVEL=info
LOG_DIR=logs
LOG_FILES_ENABLED=true
OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=le-monde-de-lila-backend
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
# Documentation HTTP : active par défaut hors production.
# OPENAPI_ENABLED=true
# HEALTH_CHECK_PATH=/var/lib/lemonde-de-lila
HEALTH_MIN_FREE_BYTES=104857600
HEALTH_MAX_EVENT_LOOP_LAG_MS=250
HEALTH_MAX_FAILED_JOBS=100
# ENABLE_PROTOTYPE_GAMES=true
GAME_DEVTOOLS_ENABLED=false
GAME_ROOM_LOCK_TIMEOUT_SECONDS=5
# Vide : utilise les jeux du package exécuté (source ou dist).
GAME_MODULES_ROOT=
LILA_CONTENT_RELEASE_DIR=
WS_PERMESSAGE_DEFLATE=true
# LMDL_SOUNDS_DIR=/var/lib/lemonde-de-lila/sounds
# MNEMO_QUIZ_PATH=/var/lib/lemonde-de-lila/arche-de-mnemosyne/quiz.json

# Maintenance et délais opérationnels
ADMIN_MAINTENANCE_ENABLED=false
ADMIN_MAINTENANCE_REQUIRE_TOKEN=true
# ADMIN_MAINTENANCE_TOKEN=
# ADMIN_MAINTENANCE_ALLOWED_IPS=127.0.0.1
# ADMIN_MAINTENANCE_LOCK_PATH=/var/lib/lemonde-de-lila/maintenance.lock
MAINTENANCE_COMMAND_TIMEOUT_MS=600000
SOUND_PROBE_TIMEOUT_MS=15000
SOUND_TRANSCODE_TIMEOUT_MS=30000
CLIENT_UPDATE_DISCONNECT_DELAY_MS=1200
ROOM_CLEANUP_TICK_MS=30000
ROOM_CLEANUP_INITIAL_DELAY_MS=5000
ROOM_INVITE_TTL_MS=600000
WS_RECONNECT_BACKOFF_MS=300

# CLIENT_MIN_VERSION=
CLIENT_FORCE_LATEST=false

# Client WX — signature obligatoire en production.
# CLIENT_WX_UPDATES_UPLOAD_TOKEN=
# CLIENT_WX_UPDATES_DIR=/var/lib/lemonde-de-lila/client-wx
# CLIENT_WX_UPDATES_META_PATH=/var/lib/lemonde-de-lila/client-wx/latest.json
# CLIENT_WX_UPDATES_PUBLIC_URL=https://api.example.test/updates/client-wx
# CLIENT_WX_MIN_VERSION=
# CLIENT_WX_MAX_ARTIFACT_BYTES=1073741824
# CLIENT_WX_STORAGE_QUOTA_BYTES=10737418240
# CLIENT_WX_SIGNATURE_PUBLIC_KEY_DER_BASE64=
# CLIENT_WX_SIGNATURE_PUBLIC_KEY_PEM=
# CLIENT_WX_SIGNATURE_PUBLIC_KEY_PATH=/etc/lemonde-de-lila/wx-update-public.pem
CLIENT_WX_ALLOW_UNSIGNED=0

# Stockage
# SOUNDS_STORAGE_QUOTA_BYTES=10737418240
# STORAGE_MIN_FREE_BYTES=1073741824
# TAVERNE_CATEGORIES_ROOT=/var/lib/lemonde-de-lila/taverne-categories

# WebSocket
# Ne jamais embarquer WS_TICKET_SECRET dans un client.
WS_TICKET_SECRET=<generate-a-random-secret-of-at-least-32-characters>
WS_TICKET_TTL_SECONDS=60
WS_MAX_BUFFERED_BYTES=1048576
WS_MAX_PAYLOAD_BYTES=65536
WS_RATE_LIMIT_WINDOW_MS=10000
WS_RATE_LIMIT_COUNT=60

# Options applicatives et maintenance
ADMIN_MAINTENANCE_BACKEND_SERVICE=lila-backend.service
ADMIN_MAINTENANCE_DEPLOY_UNIT=lila-backend-deploy.service
BOT_NAMES_CACHE_TTL_MS=30000
GAME_CATALOG_CACHE_TTL_MS=30000
PROFILE_BIO_MIN_LENGTH=0
PROFILE_BIO_MAX_LENGTH=500
ROOM_AUTO_CLEANUP_ENABLED=false
ROOM_AUTO_CLEANUP_INTERVAL_SECONDS=300
ROOM_AUTO_CLEANUP_LIMIT=1000
ROOM_AUTO_CLEANUP_OLDER_THAN_MINUTES=60
ROOM_PAYLOAD_CACHE_TTL_SECONDS=15
# REDIS_URL=redis://127.0.0.1:6379
# PROGRAMDATA=

# Identifiants facultatifs de compilation
# COMMIT_SHA=
# GITHUB_SHA=
# LEMONDEDELILA_BUILD_ID=
# LEMONDEDELILA_GIT_SHA=
# SOURCE_VERSION=
CLIENT_WX_MANIFEST_CACHE_TTL_MS=
PRESENCE_CHAT_BAN_CACHE_TTL_MS=
PRESENCE_ORIGINS_CACHE_TTL_MS=
REALTIME_REQUEST_REPLAY_MAX_ENTRIES=
REALTIME_REQUEST_REPLAY_TTL_MS=
UPDATE_REDIS_URL=
