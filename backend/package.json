  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.jest.json"
        }
      ]
    },
    "moduleNameMapper": {
      "^@modules/(.*)$": "<rootDir>/modules/$1",
      "^@game/(.*)$": "<rootDir>/game/$1",
      "^@platform/(.*)$": "<rootDir>/platform/$1",
      "^@shared/(.*)$": "<rootDir>/shared/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.d.ts",
      "!**/platform/database/migrations/**"
    ],
    "coverageReporters": [
      "text",
      "json",
      "json-summary",
      "lcov"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "coverageThreshold": {
      "global": {
        "branches": 43,
        "functions": 48,
        "lines": 58,
        "statements": 58
      },
      "**/realtime-api-connection.service.ts": {
        "branches": 65,
        "functions": 100,
        "lines": 90,
        "statements": 90
      },
      "**/redis-session-store.ts": {
        "branches": 75,
        "functions": 85,
        "lines": 85,
        "statements": 85
      },
      "**/ws-jwt-auth.service.ts": {
        "branches": 70,
        "functions": 100,
        "lines": 90,
        "statements": 85
      },
      "**/ws-ticket-auth.service.ts": {
        "branches": 70,
        "functions": 85,
        "lines": 85,
        "statements": 80
      },
      "**/ws-ticket.service.ts": {
