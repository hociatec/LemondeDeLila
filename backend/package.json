  "scripts": {
    "build": "node commands/generate-game-registry.cjs && node scripts/prepare-dist.cjs && nest build && npm run verify:app-load",
    "game:registry": "node commands/generate-game-registry.cjs",
    "create:game": "node commands/create-game.cjs",
    "game:create": "node commands/create-game.cjs",
    "service:restart": "node commands/restart-service.cjs",
    "verify:dist": "node commands/verify-dist-games.cjs",
    "verify:app-load": "node commands/verify-app-load.cjs",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:generate": "npm run typeorm -- migration:generate -d src/data-source.ts src/platform/database/migrations/auto",
    "migration:run": "npm run typeorm -- migration:run -d dist/data-source.js",
    "migration:run:dev": "npm run typeorm -- migration:run -d src/data-source.ts",
    "test:db:migrations": "node tools/mysql-migrations-integration.cjs",
    "test:redis:bullmq": "node tools/redis-bullmq-integration.cjs",
    "test:disaster-recovery": "node tools/disaster-recovery-drill.cjs",
    "test:integration:real": "node tools/run-real-integration.cjs",
    "test:e2e:two-instances:real": "node tools/two-instance-real-e2e.cjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node --require ./dist/platform/observability/infrastructure/tracing/telemetry-register.js dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit --incremental false",
    "typecheck:prod": "tsc -p tsconfig.build.json --noEmit --incremental false",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "mutation:test": "stryker run",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e:room:real": "node tools/room-real-e2e.cjs",
    "test:e2e:room-game:real": "node tools/room-game-real-e2e.cjs",
    "test:e2e:game:campaign:real": "node tools/game-campaign-real-e2e.cjs",
    "test:load:room:real": "node tools/room-load-real.cjs",
    "benchmark:game-engine": "node tools/game-engine-benchmark.cjs",
    "artifact:create": "node tools/create-deployment-artifact.cjs",
    "content:export": "node tools/content-release.cjs export",
    "content:publish": "node tools/content-release.cjs publish",
    "content:rollback": "node tools/content-release.cjs rollback",
    "quality:report": "node tools/quality-report.cjs",
    "architecture:test": "node --test tools/architecture-check.spec.cjs",
    "architecture:check": "node tools/architecture-check.cjs",
    "architecture:baseline:update": "node tools/architecture-check.cjs --update-baseline",
    "structure:test": "node --test tools/structural-quality-check.spec.cjs",
    "structure:check": "node tools/structural-quality-check.cjs",
    "structure:baseline:update": "node tools/structural-quality-check.cjs --update-baseline",
    "game-engine:audit:test": "node --test tools/game-engine-architecture-check.spec.cjs commands/create-game.spec.cjs",
    "game-engine:audit": "node tools/game-engine-architecture-check.cjs",
    "game:duplication": "node tools/game-duplication-check.cjs",
    "game:metrics": "node tools/game-boilerplate-report.cjs",
    "backend:audit": "node tools/backend-debt-check.cjs",
    "persistence:audit": "node tools/persistence-audit.cjs",
    "persistence:audit:test": "node --test tools/persistence-audit.spec.cjs",
    "security:audit": "node tools/security-boundary-audit.cjs",
    "layout:audit": "node tools/layout-architecture-audit.cjs",
    "scheduling:audit": "node tools/local-timer-audit.cjs",
    "operability:audit": "node tools/operability-audit.cjs",
    "observability:audit": "node tools/observability-contract-check.cjs",
    "governance:audit": "node tools/repository-governance-check.cjs",
    "contracts:ws": "node tools/generate-asyncapi-contract.cjs",
    "contracts:ws:write": "node tools/generate-asyncapi-contract.cjs --write",
    "quality:check": "npm run quality:report && node tools/quality-check.cjs && npm run backend:audit && npm run persistence:audit:test && npm run persistence:audit && npm run security:audit && npm run layout:audit && npm run scheduling:audit && npm run operability:audit && npm run observability:audit && npm run governance:audit && npm run contracts:ws && npm run architecture:test && npm run architecture:check && npm run structure:test && npm run structure:check && npm run game-engine:audit:test && npm run game-engine:audit && npm run game:duplication",
    "test:transverse": "jest game/core/application/helpers/game-room-run-id.helper.spec.ts game/core/application/helpers/payload-validators.helper.spec.ts game/engine/runtime/declarative-game.runtime.spec.ts game/core/application/services/game-command-executor.service.spec.ts game/testing/architecture-tests/game/all-declarative-games.contract.spec.ts game/core/infrastructure/presentation/ws/game-ws-key-command.helper.spec.ts game/core/infrastructure/presentation/ws/game-ws-realtime-state.service.spec.ts modules/room/application/services/room-start-flow.service.spec.ts modules/update/infrastructure/persistence/wx-update-release.di.spec.ts modules/update/infrastructure/persistence/wx-update-release.service.spec.ts modules/update/infrastructure/persistence/wx-update-upload.service.spec.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-ws": "^11.1.9",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.9",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@prometheus-io/client": "^0.16.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.81.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "mysql2": "^3.15.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.0",
    "winston": "^3.19.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/jest-runner": "^10.0.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.10.12",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.19.43",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.11.0",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.jest.json"
        }
      ]
    },
    "moduleNameMapper": {
      "^@modules/(.*)$": "<rootDir>/modules/$1",
      "^@game/(.*)$": "<rootDir>/game/$1",
      "^@platform/(.*)$": "<rootDir>/platform/$1",
      "^@shared/(.*)$": "<rootDir>/shared/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.d.ts",
      "!**/platform/database/migrations/**"
    ],
    "coverageReporters": [
      "text",
      "json",
      "json-summary",
      "lcov"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "coverageThreshold": {
      "global": {
        "branches": 43,
        "functions": 48,
        "lines": 58,
        "statements": 58
      },
      "**/realtime-api-connection.service.ts": {
        "branches": 65,
        "functions": 100,
        "lines": 90,
        "statements": 90
      },
      "**/redis-session-store.ts": {
        "branches": 75,
        "functions": 85,
        "lines": 85,
        "statements": 85
      },
      "**/ws-jwt-auth.service.ts": {
        "branches": 70,
        "functions": 100,
        "lines": 90,
        "statements": 85
      },
      "**/ws-ticket-auth.service.ts": {
        "branches": 70,
        "functions": 85,
        "lines": 85,
        "statements": 80
      },
      "**/ws-ticket.service.ts": {
        "branches": 80,
        "functions": 100,
        "lines": 90,
        "statements": 90
      }
    }
  }
}
