{
  "schemaVersion": 1,
  "contentVersion": "2",
  "definitionVersion": "2",
  "category": "JeuxDePlateaux",
  "world": "LesQuatreVents",
  "components": [
    {
      "id": "market",
      "spaces": 40,
      "overshoot": "wrap",
      "component": "movement.track"
    },
    {
      "component": "dice.set",
      "id": "main",
      "count": 1,
      "sides": 6
    },
    {
      "id": "market-quiz",
      "questions": {
        "$content": "content/quizzes.json"
      },
      "shuffle": true,
      "component": "quiz.bank"
    },
    {
      "id": "panier",
      "pawns": {
        "$content": "content/pawns.json"
      },
      "component": "pawn.set",
      "perPlayer": 1
    },
    {
      "id": "events",
      "cards": {
        "$content": "content/cards.json#/events"
      },
      "shuffle": true,
      "component": "cards.deck"
    },
    {
      "id": "exchanges",
      "cards": {
        "$content": "content/cards.json#/exchanges"
      },
      "shuffle": true,
      "component": "cards.deck"
    },
    {
      "id": "market-items",
      "visibility": "owner",
      "component": "inventory.set"
    },
    {
      "id": "shopping-lists",
      "visibility": "owner",
      "component": "inventory.set",
      "items": {
        "$content": "content/products.json#/items"
      }
    },
    {
      "id": "shopping-baskets",
      "visibility": "owner",
      "component": "inventory.set"
    }
  ],
  "setup": {},
  "resourceIds": [],
  "initialPhase": "setup",
  "phases": {
    "setup": {
      "actions": [],
      "transitions": [
        "playing"
      ]
    },
    "playing": {
      "actions": [
        "roll",
        "draw_card"
      ],
      "terminal": true
    }
  },
  "actions": {
    "roll": {
      "recipe": "board-roll"
    },
    "draw_card": {
      "recipe": "board-draw"
    }
  },
  "victory": {
    "kind": "by-board"
  },
  "shortcuts": [
    {
      "key": "D",
      "type": "action",
      "actionType": "roll"
    },
    {
      "key": "Space",
      "type": "action",
      "actionType": "draw_card",
      "label": "Piocher la carte"
    },
    {
      "key": "S",
      "type": "interface",
      "id": "inventory:shopping-baskets",
      "label": "Panier"
    },
    {
      "key": "L",
      "type": "interface",
      "id": "inventory:shopping-lists",
      "label": "Liste de courses"
    },
    {
      "key": "I",
      "type": "interface",
      "id": "inventory:market-items",
      "label": "Inventaire"
    }
  ],
  "board": {
    "namespace": "panier",
    "trackId": "market",
    "diceId": "main",
    "playingPhase": "playing",
    "maxDepth": 24,
    "scorePerForwardLap": 1,
    "pawnSelection": {
      "setId": "panier",
      "choiceId": "panier.pawn",
      "announceInventory": {
        "inventoryId": "shopping-lists",
        "eventType": "panier.shopping-list.announced"
      }
    },
    "distribution": {
      "inventoryId": "shopping-lists",
      "groups": {
        "$content": "content/products.json#/groups"
      }
    },
    "collection": {
      "requiredInventoryId": "shopping-lists",
      "collectedInventoryId": "shopping-baskets",
      "overflowInventoryId": "market-items",
      "sources": {
        "$content": "content/products.json#/sources"
      },
      "defaultSourceId": "bonus",
      "collectedMessage": "panier.item.added-to-basket",
      "overflowMessage": "panier.item.added-to-inventory"
    },
    "quiz": {
      "bankId": "market-quiz",
      "choiceId": "panier.quiz",
      "correctMove": 2
    },
    "exchange": {
      "inventoryId": "market-items",
      "takeChoiceId": "panier.take",
      "giveChoiceId": "panier.give"
    },
    "directionChoiceId": "panier.direction",
    "bindings": {
      "panier.move-and-resolve": {
        "kind": "move"
      },
      "panier.draw-course": {
        "kind": "collect"
      },
      "panier.quiz": {
        "kind": "quiz"
      },
      "panier.nearest-stand": {
        "kind": "nearest",
        "tag": "stand"
      },
      "panier.strategic-swap": {
        "kind": "exchange"
      }
    },
    "tiles": {
      "$content": "content/board.json"
    },
    "restoreDirection": {
      "status": "panier.reversed-until-owner-turn",
      "ruleId": "restore-market-direction"
    },
    "startingPlayer": "random"
  }
}
