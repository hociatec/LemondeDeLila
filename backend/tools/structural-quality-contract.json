{
  "schemaVersion": 1,
  "limits": {
    "fileLines": 500,
    "classLines": 500,
    "methodLines": 80,
    "methodsPerClass": 20,
    "constructorDependencies": 8
  },
  "ignoredSuffixes": [".spec.ts", ".test.ts", ".e2e-spec.ts", ".d.ts"],
  "ignoredPathFragments": ["/migrations/", "/tests/"],
  "constructorDependencyExemptions": [
    "\\.registrar\\.ts$",
    "/module/",
    "\\.module\\.ts$"
  ]
}
